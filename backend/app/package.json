{
  "name": "@detran/app",
  "version": "0.0.1",
  "private": true,
  "description": "Unified DETRAN backend composition root: stynx adapter kernel (detran-runtime), fail-closed runtime profiles, unified policy matrix wiring, request-path tenancy enforcement and the DB-persisted audit sink (ADR-0002, ADR-0005).",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run",
    "test:unit": "DETRAN_TEST_TIER=unit vitest run",
    "test:integration": "DETRAN_TEST_TIER=integration vitest run",
    "test:e2e": "DETRAN_TEST_TIER=e2e vitest run",
    "test:real": "DETRAN_TEST_TIER=real vitest run",
    "test:in-house": "DETRAN_TEST_TIER=in-house vitest run",
    "db:apply": "bash ../database/apply.sh",
    "db:reset": "bash ../database/apply.sh --full"
  },
