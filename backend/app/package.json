{
  "name": "@detran/app",
  "version": "0.0.1",
  "private": true,
  "description": "Unified DETRAN backend composition root: stynx adapter kernel (detran-runtime), fail-closed runtime profiles, unified policy matrix wiring, request-path tenancy enforcement and the DB-persisted audit sink (ADR-0002, ADR-0005).",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run",
    "test:unit": "DETRAN_TEST_TIER=unit vitest run",
    "test:integration": "DETRAN_TEST_TIER=integration vitest run",
    "test:e2e": "DETRAN_TEST_TIER=e2e vitest run",
    "test:real": "DETRAN_TEST_TIER=real vitest run",
    "db:apply": "bash ../database/apply.sh",
    "db:reset": "bash ../database/apply.sh --full"
  },
  "dependencies": {
    "@detran/shared": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@stynx-nyx/audit": "1.1.1",
    "@stynx-nyx/auth": "1.1.1",
    "@stynx-nyx/backend": "1.1.1",
    "@stynx-nyx/contracts": "1.1.1",
    "@stynx-nyx/core": "1.1.1",
    "@stynx-nyx/data": "1.1.1",
    "@stynx-nyx/health": "1.1.1",
    "@stynx-nyx/idempotency": "1.1.1",
    "@stynx-nyx/logging": "1.1.1",
    "@stynx-nyx/ratelimit": "1.1.1",
    "@stynx-nyx/storage": "1.1.1",
    "@stynx-nyx/tenancy": "1.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@types/pg": "^8.15.4",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "pg": "^8.20.0",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
