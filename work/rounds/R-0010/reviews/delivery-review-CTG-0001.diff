+  update(@Param('id') id: string, @Body() dto: Partial<CreateCrashWitnessDto>) {
+    return this.service.update(id, dto);
+  }
+  @Delete(':id')
+  @Action('delete')
+  @Audit({ action: 'EST_CRASH_WITNESS_DELETE', entity: 'est.crash_witness' })
