+          'SUPORTE',
+          'technical-admin',
+        ].includes(role),
+    )) {
+      expect(
+        isDetranActionAllowed(
+          { roles: [role], permissions: [] },
+          'est:crash-subject-request',
+          'subject-request',
+        ),
+      ).toBe(false);
+    }
+  });
+});
