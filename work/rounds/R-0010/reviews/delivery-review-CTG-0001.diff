+    expect(
+      isDetranActionAllowed(
+        { roles: ['CIDADAO'], permissions: [] },
+        'est:crash-subject-request',
+        'subject-request',
+      ),
+    ).toBe(true);
+    expect(
+      isDetranActionAllowed(
+        { roles: ['CIDADAO'], permissions: [] },
+        'est:crash-victim',
+        'read',
+      ),
+    ).toBe(false);
