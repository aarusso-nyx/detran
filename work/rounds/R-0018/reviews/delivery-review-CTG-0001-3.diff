+// 7.1 Gate — (a) duplicatas e redirecionamentos
+// ---------------------------------------------------------------------------
+
+test('C-01-01 dado um número com dois arquivos não-stub em docs/meta/adr quando o gate roda então acusa duplicata', async () => {
