+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schemaVersion",
+    "run_id",
+    "started_at",
+    "ended_at",
+    "caller",
+    "files_read",
+    "files_written",
+    "commands_run",
+    "compliance",
+    "prev_hash",
+    "manifest_hash"
+  ],
+  "properties": {
+    "schemaVersion": {
+      "const": "1.0.0"
+    },
+    "run_id": {
+      "type": "string",
+      "pattern": "^AR-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
+      "description": "AR- prefix + UUID v7. The v7 variant ensures lexicographic sort matches chronological order."
