+++ b/law/schemas/mutation-assurance-policy-v2.schema.json
@@ -0,0 +1,574 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://devai.nyxk.com.br/schemas/mutation-assurance-policy-v2.schema.json",
+  "title": "Mutation assurance policy v2",
+  "description": "Additive v2 policy binding mutation assurance results to exact identities. It declares the ten identity classes a report must bind, keeps targeted and full assurance distinct and non-substitutable, forbids a not-required disposition from ever reading as a pass, and permits reuse of a prior result only on an exact match of every declared identity.",
+  "schema_version": "2.0.0",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schemaVersion",
+    "id",
+    "status",
+    "authority",
+    "policy_version",
+    "report_schema",
+    "successor_contract",
+    "supersedes_policy",
+    "required_identity_bindings",
+    "modes",
+    "dispositions",
+    "reuse",
+    "not_required",
+    "thresholds",
+    "semantic_verifier",
+    "prohibitions"
+  ],
+  "properties": {
+    "$schema": {
+      "type": "string",
+      "minLength": 1
+    },
+    "schemaVersion": {
+      "const": "2.0.0"
+    },
+    "id": {
+      "const": "mutation-assurance-v2"
+    },
+    "status": {
+      "const": "deprecated-read-only-pending-verifier-alignment"
+    },
+    "authority": {
+      "const": "Architect"
+    },
+    "policy_version": {
+      "type": "string",
+      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
+    },
+    "report_schema": {
+      "const": "law/schemas/mutation-assurance-v2.schema.json"
+    },
+    "successor_contract": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "source_commit",
+        "report_set_schema",
+        "composed_report_set_schema",
+        "adoption_status",
+        "non_scored_statuses",
+        "prohibition"
+      ],
+      "properties": {
+        "source_commit": { "const": "fcefd0ad9b1210f5d460509f801a16fc3c4dcbd1" },
+        "report_set_schema": { "const": "mutation-report-set-v2" },
+        "composed_report_set_schema": { "const": "mutation-composed-report-set-v2" },
+        "adoption_status": { "const": "blocking-alignment" },
+        "non_scored_statuses": { "const": ["CompileError", "Ignored"] },
+        "prohibition": {
+          "const": "no-new-release-may-treat-this-divergent-assurance-v2-policy-as-the-canonical-verifier-contract"
+        }
+      }
+    },
+    "supersedes_policy": {
