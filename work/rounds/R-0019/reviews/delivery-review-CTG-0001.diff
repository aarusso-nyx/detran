+          }
+        }
+      }
+    },
+    "Field": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["name", "type"],
+      "properties": {
+        "name": {
+          "type": "string",
+          "pattern": "^[a-z_][a-z0-9_]*$",
+          "description": "snake_case field name."
+        },
+        "type": {
+          "oneOf": [
+            {
+              "type": "string",
+              "enum": [
+                "uuid",
+                "text",
+                "int",
+                "bigint",
+                "bool",
+                "timestamptz",
+                "jsonb",
+                "date",
+                "smallint"
+              ]
+            },
+            {
+              "type": "string",
+              "pattern": "^varchar\\([0-9]+\\)$"
+            },
+            {
+              "type": "string",
+              "pattern": "^numeric\\([0-9]+,[0-9]+\\)$"
+            },
+            {
+              "type": "string",
+              "pattern": "^enum:[A-Z][A-Za-z0-9]*$",
+              "description": "Reference to a named enum from database.enums[]."
+            }
+          ]
+        },
+        "nullable": {
+          "type": "boolean",
+          "default": false
+        },
+        "default": {
+          "type": "string",
+          "description": "SQL default expression (e.g. now(), gen_random_uuid(), 'pending'). Pass-through to the migration template."
+        },
+        "unique": {
+          "type": "boolean",
+          "default": false
+        },
+        "check": {
+          "type": "string",
+          "description": "Optional SQL CHECK constraint expression."
+        },
+        "pii": {
+          "type": "string",
+          "enum": ["none", "low", "high"],
