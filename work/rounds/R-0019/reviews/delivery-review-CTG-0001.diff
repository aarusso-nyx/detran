diff --git a/law/schemas/local-evidence-manifest.schema.json b/law/schemas/local-evidence-manifest.schema.json
new file mode 100644
index 00000000..3c3cf061
--- /dev/null
+++ b/law/schemas/local-evidence-manifest.schema.json
@@ -0,0 +1,407 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://devai.nyxk.com.br/schemas/local-evidence-manifest.schema.json",
+  "title": "DEVAI CI Evidence Manifest",
+  "description": "Manifest claiming that expensive checks ran against an exact committed value. Local and GitHub Actions producers are both bound through sourceHash and their declared policy and jobs. A claimed-but-invalid manifest fails closed when consumed by `devai evidence verify`.",
+  "type": "object",
+  "additionalProperties": false,
+  "allOf": [
+    {
+      "if": {
+        "required": ["origin"],
+        "properties": {
+          "origin": {
+            "const": "actions-run"
+          }
+        }
+      },
+      "then": {
+        "required": ["actionsRun"]
+      },
+      "else": {
+        "not": {
+          "required": ["actionsRun"]
+        }
+      }
+    }
+  ],
+  "required": [
+    "schemaVersion",
+    "generatedAt",
+    "expiresAt",
+    "subject",
+    "sourceHash",
+    "policy",
+    "tools",
+    "platforms",
+    "jobs"
+  ],
+  "properties": {
+    "$schema": {
+      "type": "string"
+    },
+    "schemaVersion": {
+      "const": 1
+    },
+    "origin": {
+      "enum": ["local", "actions-run"],
+      "description": "Evidence producer. Omission selects the local producer."
+    },
+    "actionsRun": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "repository",
+        "workflowRef",
+        "eventName",
+        "runId",
+        "runAttempt",
+        "actor",
+        "headSha",
+        "baseSha",
+        "mergeBaseSha",
+        "testedCommitSha",
+        "testedTree",
+        "digests"
+      ],
+      "description": "Identity and invalidation contract for provisional GitHub Actions evidence. Every caller-provided member is data to verify, never an authority selector.",
+      "properties": {
+        "repository": {
+          "type": "string",
+          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
+        },
+        "workflowRef": {
+          "type": "string",
+          "minLength": 1
+        },
+        "eventName": {
+          "enum": ["pull_request", "merge_group"]
+        },
+        "runId": {
+          "type": "string",
+          "pattern": "^[1-9][0-9]*$"
+        },
+        "runAttempt": {
+          "type": "integer",
+          "minimum": 1
+        },
+        "actor": {
+          "type": "string",
+          "minLength": 1
+        },
+        "headSha": {
+          "type": "string",
+          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
+        },
+        "baseSha": {
+          "type": "string",
+          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
+        },
+        "mergeBaseSha": {
+          "type": "string",
+          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
+        },
+        "testedCommitSha": {
+          "type": "string",
+          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
+        },
+        "testedTree": {
+          "oneOf": [
+            {
+              "type": "object",
+              "additionalProperties": false,
+              "required": ["algorithm", "value"],
+              "properties": {
+                "algorithm": {
+                  "const": "sha1"
+                },
+                "value": {
+                  "type": "string",
+                  "pattern": "^[a-f0-9]{40}$"
+                }
+              }
+            },
+            {
+              "type": "object",
+              "additionalProperties": false,
+              "required": ["algorithm", "value"],
+              "properties": {
+                "algorithm": {
+                  "const": "sha256"
+                },
+                "value": {
+                  "type": "string",
+                  "pattern": "^[a-f0-9]{64}$"
+                }
+              }
+            }
+          ]
+        },
+        "digests": {
+          "type": "object",
+          "additionalProperties": false,
+          "required": [
+            "workflowPolicySha256",
+            "lockfileSha256",
+            "toolchainContractSha256",
+            "testContractSha256",
+            "serviceContractSha256"
+          ],
+          "properties": {
+            "workflowPolicySha256": {
+              "type": "string",
+              "pattern": "^[a-f0-9]{64}$"
+            },
+            "lockfileSha256": {
+              "type": "string",
+              "pattern": "^[a-f0-9]{64}$"
+            },
+            "toolchainContractSha256": {
+              "type": "string",
+              "pattern": "^[a-f0-9]{64}$"
+            },
+            "testContractSha256": {
+              "type": "string",
+              "pattern": "^[a-f0-9]{64}$"
+            },
+            "serviceContractSha256": {
+              "type": "string",
+              "pattern": "^[a-f0-9]{64}$"
+            }
+          }
+        }
+      }
+    },
+    "generatedAt": {
+      "type": "string",
+      "format": "date-time",
+      "description": "When the manifest was collected. Verification rejects manifests older than policy.maxAgeHours or timestamped in the future (beyond a 5-minute clock-skew allowance)."
+    },
+    "expiresAt": {
+      "type": "string",
+      "format": "date-time",
+      "description": "Explicit terminal validity instant derived by the producer from generatedAt plus the declared maximum age. The verifier recomputes and binds this value."
+    },
+    "subject": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["repository", "commitSha", "tree"],
+      "description": "Exact committed subject proven by this manifest. It is producer-derived and verifier-recomputed; callers cannot select or substitute it.",
+      "properties": {
+        "repository": {
+          "type": "string",
+          "minLength": 1
+        },
+        "commitSha": {
+          "type": "string",
+          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
+        },
+        "tree": {
+          "type": "object",
+          "additionalProperties": false,
+          "required": ["algorithm", "value"],
+          "properties": {
+            "algorithm": { "enum": ["sha1", "sha256"] },
+            "value": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" }
+          }
+        }
+      }
+    },
+    "sourceHash": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["algorithm", "value", "fileCount"],
+      "description": "Deterministic digest over every git-tracked file (path, byte length, per-file sha256), excluding the manifest's own directory. Binds the evidence claim to the exact tree it was produced from.",
+      "properties": {
+        "algorithm": {
+          "const": "sha256"
+        },
+        "value": {
+          "type": "string",
+          "pattern": "^[a-f0-9]{64}$"
+        },
+        "fileCount": {
+          "type": "integer",
+          "minimum": 1
+        }
+      }
+    },
+    "policy": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["maxAgeHours", "requiredJobs", "allowedPlatforms"],
+      "description": "The policy the manifest claims to satisfy. Verification cross-checks these values against the adopter's declared `ci_economy.local_evidence` config (project-config.schema.json); a manifest carrying a laxer policy than the repo declares is rejected.",
+      "properties": {
+        "maxAgeHours": {
+          "type": "integer",
+          "minimum": 1,
+          "maximum": 168
+        },
+        "requiredJobs": {
+          "type": "array",
+          "items": {
+            "type": "string",
+            "minLength": 1
+          },
+          "minItems": 1,
+          "uniqueItems": true
+        },
+        "allowedPlatforms": {
+          "type": "array",
+          "items": {
+            "type": "string",
