diff --git a/law/schemas/effect-authorization-event.schema.json b/law/schemas/effect-authorization-event.schema.json
new file mode 100644
index 00000000..407ece87
--- /dev/null
+++ b/law/schemas/effect-authorization-event.schema.json
@@ -0,0 +1,587 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://devai.nyxk.com.br/schemas/effect-authorization-event.schema.json",
+  "title": "Exact effect authorization event",
+  "description": "One append-only, hash-linked authorization event. An authorization names exactly one action, one effect, one resource, one repository, one candidate, one consuming role, and one validity window, and it is consumable exactly once. There is no wildcard scope, no bearer transfer, and no delegation: possession of a record is not authority, and a record that cannot be resolved, has been revoked, has expired, or has already been consumed authorizes nothing.",
+  "schema_version": "1.0.0",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schemaVersion",
+    "canonicalization",
+    "event_id",
+    "ledger_id",
+    "sequence",
+    "previous_event_digest_sha256",
+    "kind",
+    "action_id",
+    "effect",
+    "resource",
+    "repository",
+    "candidate",
+    "grantor",
+    "subject_role",
+    "consent",
+    "one_time",
+    "uses_permitted",
+    "bearer_transferable",
+    "delegable",
+    "recorded_at",
+    "payload_digest_sha256",
+    "grant_event_id"
+  ],
+  "properties": {
+    "schemaVersion": { "enum": ["1.0.0", "2.0.0"] },
+    "canonicalization": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "kernel_id",
+        "encoding",
+        "json_form",
+        "digest_algorithm",
+        "payload_projection_excludes",
+        "event_id_derivation",
+        "event_digest_projection",
+        "calculation_order"
+      ],
+      "properties": {
+        "kernel_id": {
+          "enum": [
+            "devai.kernel.effect-authorization-event-canonicalization.v1",
+            "devai.kernel.effect-authorization-event-canonicalization.v2"
+          ]
+        },
+        "encoding": { "const": "utf-8" },
+        "json_form": { "const": "rfc8785-jcs" },
+        "digest_algorithm": { "const": "sha256" },
+        "payload_projection_excludes": { "const": ["event_id", "payload_digest_sha256"] },
+        "event_id_derivation": {
+          "const": "EA-hyphen-plus-the-first-16-lowercase-hex-characters-of-payload_digest_sha256"
+        },
+        "event_digest_projection": { "const": "complete-event-record-with-no-field-excluded" },
+        "calculation_order": {
+          "const": [
+            "compute-payload_digest_sha256-over-the-canonical-payload-projection",
+            "derive-event_id-from-payload_digest_sha256",
+            "compute-ledger-event-digest-over-the-complete-event-record"
+          ]
+        }
+      }
+    },
+    "event_id": {
+      "type": "string",
+      "pattern": "^EA-[0-9a-f]{16}$",
+      "description": "Derived after payload_digest_sha256 as EA- plus its first 16 lowercase hexadecimal characters."
+    },
+    "ledger_id": {
+      "type": "string",
+      "pattern": "^EAL-[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
+    },
+    "sequence": {
+      "type": "integer",
+      "minimum": 1,
+      "description": "Strictly increasing per ledger. A gap or a repeat is a chain violation, never a recoverable ordering hint."
+    },
+    "previous_event_digest_sha256": {
+      "type": ["string", "null"],
+      "pattern": "^[a-f0-9]{64}$",
+      "description": "Digest of the preceding event in this ledger; null only at sequence 1."
+    },
+    "kind": {
+      "enum": ["granted", "consumed", "revoked", "expired", "rejected"]
+    },
+    "action_id": {
+      "type": "string",
+      "pattern": "^[a-z][a-z0-9-]*( [a-z][a-z0-9-]*)*$",
+      "maxLength": 100,
+      "description": "Exactly one canonical action id. The pattern admits no wildcard character, so an authorization can never widen to an action family."
+    },
+    "effect": {
+      "enum": ["read", "harness-write", "local-write", "remote-write"]
+    },
+    "resource": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["kind", "system_id", "exact_identifier", "operations"],
+      "description": "Exactly one resource. Identifiers are literal: no glob, no prefix match, no default remainder.",
+      "properties": {
+        "kind": {
+          "enum": ["fs", "git-ref", "db", "remote"]
+        },
+        "system_id": {
+          "type": "string",
+          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$"
+        },
+        "exact_identifier": {
+          "$ref": "#/$defs/exact_identifier"
+        },
+        "operations": {
+          "type": "array",
+          "minItems": 1,
+          "uniqueItems": true,
+          "items": {
+            "enum": ["create", "update", "delete", "rename", "merge", "push", "publish", "execute"]
+          }
+        }
+      }
+    },
+    "repository": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["id", "commit", "tree"],
+      "properties": {
+        "id": {
+          "type": "string",
+          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$"
+        },
+        "commit": {
+          "$ref": "#/$defs/git_object"
+        },
+        "tree": {
+          "$ref": "#/$defs/git_object"
+        }
+      }
+    },
+    "candidate": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["release_unit", "version", "commit", "tree"],
+      "properties": {
+        "release_unit": {
+          "type": "string",
+          "minLength": 1,
+          "maxLength": 200
+        },
+        "version": {
+          "type": "string",
+          "minLength": 1,
+          "maxLength": 100
+        },
+        "commit": {
+          "$ref": "#/$defs/git_object"
+        },
+        "tree": {
+          "$ref": "#/$defs/git_object"
+        }
+      }
+    },
+    "grantor": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["kind", "role", "declaration_source"],
+      "description": "The human who issued the authorization. A machine transition never grants its own authority.",
+      "properties": {
+        "kind": {
+          "const": "human"
+        },
+        "role": {
+          "$ref": "#/$defs/role"
+        },
+        "declaration_source": {
+          "enum": ["cli-flag", "session-state"]
+        }
+      }
+    },
+    "subject_role": {
+      "$ref": "#/$defs/role",
+      "description": "The single role permitted to consume this authorization. A different declared role fails closed."
+    },
+    "consent": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["write", "allow_publish", "experimental"],
+      "properties": {
+        "write": {
+          "type": "boolean"
+        },
+        "allow_publish": {
