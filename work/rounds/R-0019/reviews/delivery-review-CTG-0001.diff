diff --git a/law/schemas/governance-projection-status.schema.json b/law/schemas/governance-projection-status.schema.json
new file mode 100644
index 00000000..f34902d3
--- /dev/null
+++ b/law/schemas/governance-projection-status.schema.json
@@ -0,0 +1,119 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://devai.nyxk.com.br/schemas/governance-projection-status.schema.json",
+  "title": "Governance projection status and receipts",
+  "description": "Mutable delivery state for one governed round's tracking projection, stored separately from canonical events so that no acknowledgement, retry, or remote edit can alter recorded event bytes. Readiness and tracking health are reported as independent axes: a projection that is pending, failed, or unreachable is a failure to observe the remote and never changes a governed verdict.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schemaVersion",
+    "mode",
+    "activation",
+    "canonical_events",
+    "projected_events",
+    "pending_events",
+    "projection",
+    "divergence"
+  ],
+  "properties": {
+    "schemaVersion": { "const": "1.0.0" },
+    "mode": {
+      "enum": ["disabled", "github-issues"],
+      "description": "disabled is a valid, fully supported opt-out and performs no network call."
+    },
+    "activation": { "enum": ["absent", "bound-inactive", "active", "frozen", "disabled"] },
+    "round_id": { "type": ["string", "null"], "pattern": "^R-[0-9]{4,}$" },
+    "canonical_events": {
+      "type": "integer",
+      "minimum": 0,
+      "description": "Events durably recorded locally. This is the authoritative count; it never depends on the remote."
+    },
+    "projected_events": { "type": "integer", "minimum": 0 },
+    "pending_events": { "type": "integer", "minimum": 0 },
+    "projection": {
+      "enum": ["idle", "pending", "synced", "failed", "unreachable"],
+      "description": "Remote-delivery health only. Never an input to the governed verdict."
+    },
+    "issue": {
+      "type": ["integer", "null"],
+      "minimum": 1,
+      "description": "Null before the first successful sync. An absent issue is advisory, not a failure."
+    },
+    "divergence": {
+      "type": "boolean",
+      "description": "True when the observed remote state cannot be reconciled with sealed local evidence: a missing or closed issue, an edited or deleted comment, or a batch marker that does not match. Divergence is reported, never silently repaired."
+    },
+    "divergence_detail": { "type": ["string", "null"], "minLength": 1 },
+    "last_error": {
+      "type": ["object", "null"],
+      "additionalProperties": false,
+      "required": ["classification", "observed_at"],
+      "description": "Last classified projection failure. An error is never a verdict.",
+      "properties": {
+        "classification": {
+          "enum": [
+            "authentication",
+            "permission",
+            "rate-limit",
+            "validation",
+            "missing-resource",
+            "service",
+            "ambiguous-response"
+          ]
+        },
+        "observed_at": { "type": "string", "format": "date-time" },
+        "attempts": { "type": "integer", "minimum": 1 },
+        "public_safe_detail": { "type": ["string", "null"], "maxLength": 512 }
+      }
+    },
+    "receipts": {
+      "type": "array",
+      "description": "Per-batch delivery receipts. Append-only mutable delivery state; never merged into canonical event storage.",
+      "items": {
+        "type": "object",
+        "additionalProperties": false,
+        "required": ["batch_id", "state"],
+        "properties": {
+          "batch_id": { "type": "string", "pattern": "^GBAT-[0-9a-f]{16}$" },
+          "state": { "enum": ["queued", "in-flight", "delivered", "failed", "reconciled"] },
+          "comment_id": { "type": ["integer", "null"], "minimum": 1 },
+          "projected_at": { "type": ["string", "null"], "format": "date-time" },
+          "attempts": { "type": "integer", "minimum": 0 },
+          "batch_digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
+        }
+      }
+    },
+    "coverage_disclosure": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["mediated_only"],
+      "description": "Article 6 host-boundary statement carried into every status report so a reader is never invited to infer coverage DEVAI does not have.",
+      "properties": {
+        "mediated_only": { "const": true },
+        "uncovered_note": { "type": "string", "minLength": 1 }
+      }
+    }
+  },
+  "schema_version": "1.0.0",
+  "examples": [
+    {
+      "schemaVersion": "1.0.0",
+      "mode": "github-issues",
+      "activation": "active",
+      "round_id": "R-0042",
+      "canonical_events": 42,
+      "projected_events": 35,
+      "pending_events": 7,
+      "projection": "pending",
+      "issue": 123,
+      "divergence": false,
+      "divergence_detail": null,
+      "last_error": null,
+      "receipts": [],
+      "coverage_disclosure": {
+        "mediated_only": true,
+        "uncovered_note": "Editor and shell activity outside DEVAI-mediated actions is not tracked."
+      }
+    }
+  ]
+}
diff --git a/law/schemas/inv-candidate.schema.json b/law/schemas/inv-candidate.schema.json
new file mode 100644
index 00000000..f1e66920
--- /dev/null
+++ b/law/schemas/inv-candidate.schema.json
@@ -0,0 +1,178 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://devai.nyxk.com.br/schemas/inv-candidate.schema.json",
+  "$comment": "Internal proposed-invariant record derived from inventory observations for Architect review.",
+  "title": "Invariant Candidate",
+  "description": "A proposed-invariant record derived from inventory observations. Each candidate is anchored to a concrete surface artifact, categorized, confidence-scored, and includes a skeleton for Architect review.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schemaVersion",
+    "id",
+    "generated_at",
+    "category",
+    "source_sensor",
+    "target",
+    "status"
+  ],
+  "properties": {
+    "schemaVersion": {
+      "type": "string",
+      "const": "1.0.0"
+    },
+    "id": {
+      "type": "string",
+      "pattern": "^INV-CANDIDATE-[0-9A-HJKMNP-TV-Z]{26}$",
+      "description": "INV-CANDIDATE-<ulid>. ULID for sortable, content-derivable IDs."
+    },
+    "generated_at": {
+      "type": "string",
+      "format": "date-time"
+    },
+    "category": {
+      "type": "string",
+      "enum": [
+        "unmapped_route",
+        "unmapped_endpoint",
+        "unbound_endpoint",
+        "unlabeled_pii_column",
+        "forbidden_edge"
+      ],
+      "description": "What kind of gap this candidate flags. Drives the suggested-invariant template downstream."
+    },
+    "source_sensor": {
+      "type": "string",
+      "enum": [
+        "inventory_api",
+        "inventory_routes",
+        "inventory_coverage",
+        "inventory_rbac",
+        "inventory_data_handling",
+        "inventory_dep_graph"
+      ],
+      "description": "Which sensor reading the candidate was derived from."
+    },
+    "source_reading_id": {
+      "type": "string",
+      "pattern": "^SR-[a-f0-9]{16}$",
+      "description": "Optional SensorReading id (Phase 4 contract) tying this candidate back to the exact reading that produced it."
+    },
+    "confidence": {
+      "type": "string",
+      "enum": ["low", "medium", "high"],
+      "description": "Heuristic confidence in the candidate's relevance. high = direct schema mismatch; medium = pattern-matched; low = inferred / ambiguous.",
+      "default": "medium"
+    },
+    "target": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["kind", "identifier"],
+      "properties": {
+        "kind": {
+          "type": "string",
+          "enum": ["endpoint", "route", "column", "edge", "table"]
+        },
+        "identifier": {
+          "type": "string",
+          "minLength": 1,
+          "description": "Stable human-readable handle for the target: 'METHOD /path' for endpoints, route id for routes, 'table.column' for columns, 'from->to' for edges, table name for tables."
+        },
+        "evidence": {
+          "type": "array",
+          "items": {
+            "type": "object",
+            "additionalProperties": false,
+            "required": ["path", "startLine", "endLine"],
+            "properties": {
+              "path": {
+                "type": "string",
+                "minLength": 1
+              },
+              "startLine": {
+                "type": "integer",
+                "minimum": 1
+              },
+              "endLine": {
+                "type": "integer",
+                "minimum": 1
+              }
+            }
+          },
+          "default": []
+        }
+      }
+    },
+    "suggested_invariant": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "A skeleton invariant the Architect can use as a starting point. Not validated against invariant.schema.json (which would require id pattern, scope, etc.); the Architect fills those in during curation.",
+      "properties": {
+        "title": {
+          "type": "string",
+          "minLength": 1
+        },
+        "statement": {
+          "type": "string",
+          "minLength": 1
+        },
+        "domain_suggestion": {
+          "type": "string",
+          "pattern": "^[A-Z][A-Z0-9]{1,15}$"
+        },
+        "severity_suggestion": {
+          "type": "string",
+          "enum": ["constitutional", "hard-fail", "gate", "warn", "advisory"]
+        },
+        "measurable_via_suggestion": {
+          "type": "array",
+          "items": {
+            "type": "string",
+            "minLength": 1
+          },
+          "default": []
+        },
+        "rationale": {
+          "type": "string"
+        }
+      },
+      "required": ["title", "statement", "severity_suggestion"]
+    },
+    "related_invariants": {
+      "type": "array",
+      "items": {
+        "type": "string",
+        "pattern": "^INV-"
+      },
+      "description": "Existing invariants the candidate relates to (e.g. INV-INVENTORY-002 for PII columns).",
+      "default": []
+    },
+    "status": {
+      "type": "string",
+      "enum": ["proposed", "accepted", "rejected", "converted"],
+      "description": "Curation status. 'converted' = an INV-CLIENT-* file has been authored from this candidate.",
+      "default": "proposed"
+    },
+    "tags": {
+      "type": "array",
+      "items": {
+        "type": "string"
+      },
+      "default": []
+    }
+  },
+  "schema_version": "1.0.0",
+  "examples": [
+    {
+      "schemaVersion": "1.0.0",
+      "id": "INV-CANDIDATE-01ARZ3NDEKTSV4RRFFQ69G5FAV",
+      "generated_at": "2026-07-23T00:00:00.000Z",
+      "category": "unmapped_endpoint",
+      "source_sensor": "inventory_api",
+      "target": {
+        "kind": "endpoint",
+        "identifier": "GET /health"
+      },
+      "status": "proposed"
+    }
+  ]
+}
diff --git a/law/schemas/invariant.schema.json b/law/schemas/invariant.schema.json
new file mode 100644
index 00000000..46934dfa
--- /dev/null
+++ b/law/schemas/invariant.schema.json
@@ -0,0 +1,396 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://devai.nyxk.com.br/schemas/invariant.schema.json",
+  "title": "Invariant",
+  "description": "Atomic Architect-authored specification unit. The control setpoint of the framework. Per Constitution Article 11.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schemaVersion",
+    "id",
+    "domain",
+    "severity",
+    "type",
+    "title",
+    "statement",
+    "status",
+    "verification",
+    "authority_docs",
+    "scope",
+    "change_policy"
+  ],
+  "properties": {
+    "schemaVersion": {
+      "const": "1.0.0"
+    },
+    "id": {
+      "$ref": "common-defs.schema.json#/$defs/id_invariant"
+    },
+    "domain": {
+      "type": "string",
+      "pattern": "^[A-Z][A-Z0-9]{1,15}$",
+      "description": "Uppercase domain code. Must match a domain declared in .devai/config/domains.json."
+    },
+    "lifecycle": {
+      "$ref": "common-defs.schema.json#/$defs/inv_lifecycle"
+    },
+    "severity": {
+      "$ref": "common-defs.schema.json#/$defs/severity"
+    },
+    "type": {
+      "enum": [
+        "api_contract",
+        "data_contract",
+        "security",
+        "rbac",
+        "abac",
+        "rls",
+        "tenancy",
+        "state_machine",
+        "lifecycle",
+        "performance",
+        "validation",
+        "error_semantics",
+        "ui_behavior",
+        "audit",
+        "compliance",
+        "governance"
+      ]
+    },
+    "title": {
+      "type": "string",
+      "minLength": 1,
+      "maxLength": 200
+    },
+    "statement": {
+      "type": "string",
+      "minLength": 1,
+      "description": "Canonical wording. Single sentence preferred. The exact text agents reference."
+    },
+    "rationale": {
+      "type": "string"
+    },
+    "status": {
+      "enum": ["draft", "active"]
+    },
+    "verification": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["required_suites", "oracle"],
+      "properties": {
+        "required_suites": {
+          "type": "array",
+          "items": {
+            "enum": ["unit", "api", "int", "e2e", "sec", "perf", "journey", "db"]
+          },
+          "minItems": 1
+        },
+        "optional_suites": {
+          "type": "array",
+          "items": {
+            "enum": ["unit", "api", "int", "e2e", "sec", "perf", "journey", "db"]
+          }
+        },
+        "oracle": {
+          "enum": ["tests", "static_analysis", "runtime_probe", "llm_judge"]
+        },
+        "strategy": {
+          "type": "object",
+          "additionalProperties": false,
+          "required": ["primary", "deterministic_check_available", "rationale"],
+          "properties": {
+            "primary": {
+              "enum": [
+                "regression",
+                "feature-overlay",
+                "behavioral-equivalence",
+                "structural",
+                "semantic-review"
+              ]
+            },
+            "supplemental": {
+              "type": "array",
+              "uniqueItems": true,
+              "items": {
+                "enum": [
+                  "regression",
+                  "feature-overlay",
+                  "behavioral-equivalence",
+                  "structural",
+                  "semantic-review"
+                ]
+              }
+            },
+            "deterministic_check_available": {
+              "type": "boolean"
+            },
+            "rationale": {
+              "type": "string",
+              "minLength": 1
+            },
+            "semantic_review_justification": {
+              "type": "string",
+              "minLength": 1
+            }
+          },
+          "allOf": [
+            {
+              "if": {
+                "properties": {
+                  "primary": {
+                    "const": "semantic-review"
+                  }
+                }
+              },
+              "then": {
+                "required": ["semantic_review_justification"]
+              }
+            }
+          ]
+        },
+        "flake_sensitive": {
+          "type": "boolean"
+        }
+      }
+    },
+    "authority_docs": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["docs"],
+      "properties": {
+        "docs": {
+          "type": "array",
+          "items": {
+            "type": "object",
+            "additionalProperties": false,
+            "required": ["doc", "anchor"],
+            "properties": {
+              "doc": {
+                "type": "string",
+                "minLength": 1
+              },
+              "anchor": {
+                "type": "string",
+                "minLength": 1
+              }
+            }
+          },
+          "minItems": 1
+        },
+        "decisions": {
+          "type": "array",
+          "items": {
+            "type": "string"
+          },
+          "description": "References to ADRs (file paths or ADR IDs) that establish this invariant."
+        }
+      }
+    },
+    "scope": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["components"],
+      "properties": {
+        "components": {
+          "type": "array",
+          "items": {
+            "type": "string"
+          },
+          "minItems": 1,
+          "description": "Logical components this invariant constrains (backend, frontend, db, etc.)."
+        },
+        "code_areas": {
+          "type": "array",
+          "items": {
+            "type": "string"
+          },
+          "description": "Path globs for the code expected to implement this invariant."
+        },
+        "data": {
+          "type": "array",
+          "items": {
+            "type": "string"
+          },
+          "description": "Schema/table/entity references."
+        },
+        "modules": {
+          "type": "array",
+          "items": {
+            "type": "string",
+            "pattern": "^MOD-"
+          },
+          "description": "F4 module IDs this invariant is associated with."
+        }
+      }
+    },
+    "change_policy": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["breaking_change_requires", "test_weakening_allowed", "human_approval_required"],
+      "properties": {
+        "breaking_change_requires": {
+          "type": "array",
+          "items": {
+            "enum": [
+              "doc_update",
+              "trace_update",
+              "test_update",
+              "migration",
+              "human_approval",
+              "adr"
+            ]
+          }
+        },
+        "test_weakening_allowed": {
+          "type": "boolean",
+          "description": "If false, any AST-level weakening of tests referencing this invariant is unjustified regardless of threshold."
+        },
+        "human_approval_required": {
+          "type": "boolean",
+          "description": "If true, any change to this invariant requires an explicit human Architect commit."
+        }
+      }
+    },
+    "tags": {
+      "type": "array",
+      "items": {
+        "type": "string"
+      }
+    },
+    "version": {
+      "type": "string",
+      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$",
+      "description": "Per-invariant semver, bumped on each substantive change. The aggregate `law/invariants/VERSION` file records the directory-level version."
+    },
+    "measurable_via": {
+      "type": "array",
+      "items": {
+        "type": "string",
+        "minLength": 1
+      },
+      "description": "Current facade action ids that measure this invariant (for example, 'check' or 'sense inventory'). Every registered action must be claimed by at least one invariant's measurable_via."
+    },
+    "measurable_via_mode": {
+      "enum": ["any", "all"],
+      "description": "How measurable_via entries combine. 'any' is used when absent and means one listed action is sufficient. 'all' requires every listed action, for invariants whose statement genuinely needs multiple observations."
+    },
+    "provenance": {
+      "type": "array",
+      "items": {
+        "type": "string"
+      },
+      "description": "Origin and replacement provenance for this invariant."
+    },
+    "supersedes": {
+      "type": ["array", "null"],
+      "items": {
+        "$ref": "common-defs.schema.json#/$defs/id_invariant"
+      }
+    },
+    "superseded_by": {
+      "anyOf": [
+        {
+          "$ref": "common-defs.schema.json#/$defs/id_invariant"
+        },
+        {
+          "type": "null"
+        }
+      ]
+    }
+  },
+  "allOf": [
+    {
+      "if": {
+        "required": ["severity", "status"],
+        "properties": {
+          "severity": {
+            "enum": ["constitutional", "hard-fail", "gate"]
+          },
+          "status": {
+            "const": "active"
+          },
+          "lifecycle": {
+            "not": {
+              "const": "experimental"
+            }
+          }
+        }
+      },
+      "then": {
+        "properties": {
+          "verification": {
+            "required": ["strategy"]
+          }
+        }
+      }
+    }
+  ],
+  "schema_version": "1.0.0",
+  "examples": [
+    {
+      "schemaVersion": "1.0.0",
+      "version": "1.0.0",
+      "id": "INV-AUTH-001",
+      "domain": "AUTH",
