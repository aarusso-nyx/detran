diff --git a/law/schemas/rtd-manifest.schema.json b/law/schemas/rtd-manifest.schema.json
new file mode 100644
index 00000000..0beb7ff6
--- /dev/null
+++ b/law/schemas/rtd-manifest.schema.json
@@ -0,0 +1,138 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://devai.nyxk.com.br/schemas/rtd-manifest.schema.json",
+  "title": "RTD Manifest",
+  "description": "Hash-stamped aggregate view over canonical specification slices. Produced through `devai evidence record --kind rtd` for citation and independent audit.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schemaVersion",
+    "id",
+    "generated_at",
+    "integration_head",
+    "components",
+    "readiness",
+    "manifest_hash"
+  ],
+  "properties": {
+    "schemaVersion": {
+      "const": "1.0.0"
+    },
+    "id": {
+      "type": "string",
+      "pattern": "^RTM-[0-9]{4,}$",
+      "description": "Monotonically-allocated id from the RTM counter (.devai/state/counters.json)."
+    },
+    "generated_at": {
+      "type": "string",
+      "format": "date-time"
+    },
+    "integration_head": {
+      "type": "string",
+      "description": "Git HEAD SHA at bundle time, or 40-char zero sentinel when --no-git is in effect."
+    },
+    "components": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "One entry per aggregated contract slice. `hash` is a SHA-256 over canonical JSON and `ok` reflects the slice validator. Counts are convenience numerics, never authoritative.",
+      "properties": {
+        "invariants": {
+          "$ref": "#/$defs/componentEntry"
+        },
+        "trace": {
+          "$ref": "#/$defs/componentEntry"
+        },
+        "journeys": {
+          "$ref": "#/$defs/componentEntry"
+        },
+        "glossary": {
+          "$ref": "#/$defs/componentEntry"
+        },
+        "adrs": {
+          "$ref": "#/$defs/componentEntry"
+        },
+        "forbidden_actions": {
+          "$ref": "#/$defs/componentEntry"
+        }
+      }
+    },
+    "readiness": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["ok", "sub_verdicts"],
+      "properties": {
+        "ok": {
+          "type": "boolean",
+          "description": "True iff every component's `ok` is true. The single signal external consumers gate on."
+        },
+        "sub_verdicts": {
+          "type": "array",
+          "items": {
+            "type": "object",
+            "additionalProperties": false,
+            "required": ["component", "ok"],
+            "properties": {
+              "component": {
+                "type": "string",
+                "minLength": 1
+              },
+              "ok": {
+                "type": "boolean"
+              },
+              "error_count": {
+                "type": "integer",
+                "minimum": 0
+              }
+            }
+          }
+        }
+      }
+    },
+    "manifest_hash": {
+      "type": "string",
+      "pattern": "^[a-f0-9]{64}$",
+      "description": "SHA-256 of the canonicalized manifest record minus this field. The single citable handle: `RTM-NNNN sha256:<manifest_hash>`."
+    }
+  },
+  "$defs": {
+    "componentEntry": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["hash", "ok"],
+      "properties": {
+        "count": {
+          "type": "integer",
+          "minimum": 0
+        },
+        "hash": {
+          "type": "string",
+          "pattern": "^[a-f0-9]{64}$"
+        },
+        "ok": {
+          "type": "boolean"
+        },
+        "errors": {
+          "type": "array",
+          "items": {
+            "type": "string"
+          }
+        }
+      }
+    }
+  },
+  "schema_version": "1.0.0",
+  "examples": [
+    {
+      "schemaVersion": "1.0.0",
+      "id": "RTM-0001",
+      "generated_at": "2026-05-13T05:13:10.858Z",
+      "integration_head": "98804f3c1b4f12af52239b37554bed0c6f6b2d15",
+      "components": {},
+      "readiness": {
+        "ok": true,
+        "sub_verdicts": []
+      },
+      "manifest_hash": "e01c22941a7fabd3c23b67cf94edd66e1bd438fdb3a7ed3018609cba83be1657"
+    }
+  ]
+}
diff --git a/law/schemas/runtime-charter.schema.json b/law/schemas/runtime-charter.schema.json
new file mode 100644
index 00000000..e1dd639f
--- /dev/null
+++ b/law/schemas/runtime-charter.schema.json
@@ -0,0 +1,186 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://devai.nyxk.com.br/schemas/runtime-charter.schema.json",
+  "title": "Runtime Probe Charter",
+  "description": "Charter that scopes a runtime probe run. It declares the mission, target environment, in-scope invariants, allowed credentials, probe sequence, expected evidence, and side-effect policy consumed through `devai sense run`.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": ["schemaVersion", "id", "kind", "mission", "target", "probes"],
+  "properties": {
+    "schemaVersion": {
+      "const": "1.0.0"
+    },
+    "id": {
+      "type": "string",
+      "pattern": "^RPC-[A-Za-z0-9_-]{1,64}$",
+      "description": "Stable charter id. Free-form within the pattern; not minted from a counter (charters are authored artifacts, not generated)."
+    },
+    "kind": {
+      "enum": ["api", "auth", "data"],
+      "description": "Which runtime-probe family executes this charter. api = HTTP/GraphQL/RPC; auth = RBAC/session/protected-surface; data = DB/state/consistency."
+    },
+    "mission": {
+      "type": "string",
+      "minLength": 1,
+      "description": "Plain-language statement of what this probe set is verifying."
+    },
+    "target": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["base_url"],
+      "properties": {
+        "base_url": {
+          "type": "string",
+          "description": "Base URL for the deployed runtime under probe. For data-kind probes this may be a DB connection string instead."
+        },
+        "environment": {
+          "enum": ["dev", "staging", "stage", "prod", "preview", "other"]
+        },
+        "deployed_artifact_ref": {
+          "type": "string",
+          "description": "Optional artifact-of-record id for evidence cross-referencing."
+        }
+      }
+    },
+    "threat_model": {
+      "type": "string",
+      "description": "Free-form threat model: what surfaces are sensitive, what side effects are explicitly allowed/forbidden."
+    },
+    "in_scope_invariants": {
+      "type": "array",
+      "items": {
+        "type": "string",
+        "pattern": "^INV-"
+      },
+      "description": "Invariants this probe set claims to exercise. Failures map back to these ids."
+    },
+    "allowed_credentials": {
+      "type": "array",
+      "items": {
+        "type": "object",
+        "additionalProperties": false,
+        "required": ["name", "role"],
+        "properties": {
+          "name": {
+            "type": "string",
+            "minLength": 1
+          },
+          "role": {
+            "type": "string",
+            "minLength": 1
+          },
+          "secret_ref": {
+            "type": "string",
+            "description": "Reference to a secret (env var, vault path); the charter never inlines secrets."
+          }
+        }
+      }
+    },
+    "probes": {
+      "type": "array",
+      "minItems": 1,
+      "items": {
+        "type": "object",
+        "additionalProperties": false,
+        "required": ["pid", "name", "expect"],
+        "properties": {
+          "pid": {
+            "type": "string",
+            "pattern": "^P[0-9]+$",
+            "description": "Probe id within this charter (P1, P2, …). Stable across charter revisions."
+          },
+          "name": {
+            "type": "string",
+            "minLength": 1
+          },
+          "method": {
+            "type": "string",
+            "description": "HTTP method or RPC verb (api/auth kinds)."
+          },
+          "path": {
+            "type": "string",
+            "description": "URL path or RPC name (api/auth kinds)."
+          },
+          "query": {
+            "type": "string",
+            "description": "SQL or DB-query expression (data kind)."
+          },
+          "as_credential": {
+            "type": "string",
+            "description": "Which allowed_credentials.name to use."
+          },
+          "body": {
+            "description": "Optional request body for the probe."
+          },
+          "expect": {
+            "type": "object",
+            "additionalProperties": false,
+            "properties": {
+              "status": {
+                "type": "integer",
+                "minimum": 100,
+                "maximum": 599
+              },
+              "row_count": {
+                "type": "integer",
+                "minimum": 0
+              },
+              "contains": {
+                "type": "array",
+                "items": {
+                  "type": "string"
+                },
+                "description": "Substrings expected in the response body."
+              },
+              "absent": {
+                "type": "array",
+                "items": {
+                  "type": "string"
+                },
+                "description": "Substrings that MUST NOT appear (e.g., leaked PII)."
+              },
+              "invariant": {
+                "type": "string",
+                "pattern": "^INV-",
+                "description": "Optional invariant this probe is the observable for."
+              }
+            }
+          }
+        }
+      }
+    },
+    "side_effects": {
+      "type": "object",
+      "additionalProperties": false,
+      "properties": {
+        "policy": {
+          "enum": ["read-only", "idempotent_writes", "destructive_with_isolation"],
+          "description": "Default: read-only. Probes that write must declare so explicitly."
+        },
+        "isolation_note": {
+          "type": "string",
+          "description": "For destructive_with_isolation: how isolation is achieved (per-test tenant, sandbox env, etc.)."
+        }
+      }
+    }
+  },
+  "schema_version": "1.0.0",
+  "examples": [
+    {
+      "schemaVersion": "1.0.0",
+      "id": "RPC-health",
+      "kind": "api",
+      "mission": "Verify the deployed health endpoint.",
+      "target": {
+        "base_url": "https://example.invalid"
+      },
+      "probes": [
+        {
+          "pid": "P1",
+          "name": "Health responds",
+          "expect": {}
+        }
+      ]
+    }
+  ]
+}
