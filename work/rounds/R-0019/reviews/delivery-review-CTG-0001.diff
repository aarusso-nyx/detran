+          "type": "string",
+          "pattern": "^PC-[a-f0-9]{16}$"
+        },
+        "max_iterations": {
+          "type": "integer",
+          "minimum": 1
+        },
+        "capabilities": {
+          "type": "array",
+          "uniqueItems": true,
+          "items": {
+            "type": "string",
+            "minLength": 1
+          }
+        },
+        "timeout_ms": {
+          "type": "integer",
+          "minimum": 1
+        }
+      }
+    },
+    "humanExecutor": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "kind",
+        "role",
+        "instructions_ref",
+        "completion_evidence",
+        "timeout_ms",
+        "timeout_behavior"
+      ],
+      "properties": {
+        "kind": {
+          "const": "human"
+        },
+        "role": {
+          "enum": ["owner", "architect", "inspector", "engineer", "auditor"]
+        },
+        "instructions_ref": {
+          "$ref": "#/$defs/relativePath"
+        },
+        "completion_evidence": {
+          "type": "array",
+          "minItems": 1,
+          "uniqueItems": true,
+          "items": {
+            "type": "string",
+            "minLength": 1
+          }
+        },
+        "timeout_ms": {
+          "type": "integer",
+          "minimum": 1
+        },
+        "timeout_behavior": {
+          "enum": ["block", "escalate"]
+        }
+      }
+    },
+    "compositeExecutor": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["kind", "child_task_ids", "dependencies", "failure_policy"],
+      "properties": {
+        "kind": {
+          "const": "composite"
+        },
+        "child_task_ids": {
+          "type": "array",
+          "minItems": 1,
+          "uniqueItems": true,
+          "items": {
+            "type": "string",
+            "pattern": "^TASK-[0-9]{4,}$"
+          }
+        },
+        "dependencies": {
+          "type": "array",
+          "uniqueItems": true,
+          "items": {
+            "type": "object",
+            "additionalProperties": false,
+            "required": ["task_id", "depends_on"],
+            "properties": {
+              "task_id": {
+                "type": "string",
+                "pattern": "^TASK-[0-9]{4,}$"
+              },
+              "depends_on": {
+                "type": "array",
+                "uniqueItems": true,
+                "items": {
+                  "type": "string",
+                  "pattern": "^TASK-[0-9]{4,}$"
+                }
+              }
+            }
+          }
+        },
+        "failure_policy": {
+          "enum": ["stop-dependent-branch", "stop-composite"]
+        }
+      }
+    }
+  },
+  "examples": [
+    {
+      "schemaVersion": "2.0.0",
+      "id": "TASK-7001",
+      "round_id": "R-0100",
+      "status": "queued",
+      "discipline": "engineer",
+      "title": "Implement the approved executor substrate",
+      "target_modules": [],
+      "target_substrates": ["F2"],
+      "created_at": "2026-08-07T00:00:00.000Z",
+      "db_isolation": "database",
+      "iteration_count": 0,
+      "executor": {
+        "kind": "routine",
+        "argv": ["pnpm", "run", "typecheck"],
+        "cwd": ".",
+        "inputs": ["packages"],
+        "outputs": [],
+        "effects": ["read"],
+        "timeout_ms": 120000,
+        "authority_checks": ["action-registry-effect-and-consent"]
+      }
+    }
+  ]
+}
diff --git a/law/schemas/test-weakening-config.schema.json b/law/schemas/test-weakening-config.schema.json
new file mode 100644
index 00000000..a8d044b5
--- /dev/null
+++ b/law/schemas/test-weakening-config.schema.json
@@ -0,0 +1,52 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://devai.nyxk.com.br/schemas/test-weakening-config.schema.json",
+  "title": "Test-Weakening Config",
+  "description": "Per-project override file for `sense test-weakening` thresholds. Lives at `.devai/config/test-weakening.json` (optional; absence means use D-21 defaults). Per D-21 evolution in Phase 16.F: defaults are educated guesses; per-project measurement refines them empirically.",
+  "type": "object",
+  "additionalProperties": false,
+  "properties": {
+    "schemaVersion": {
+      "const": "1.0.0"
+    },
+    "threshold_ratio": {
+      "type": "number",
+      "minimum": 0,
+      "maximum": 1,
+      "description": "Decrease ratio above which an assertion-count drop in a changed test file is flagged as unjustified weakening. D-21 default: 0.20 (a 20% decrease in a file's assertion count fires)."
+    },
+    "absolute_decrease_floor": {
+      "type": "integer",
+      "minimum": 0,
+      "description": "Minimum absolute decrease that always fires, regardless of ratio. D-21 default: 1 (any assertion removed in a file is a warning even if the ratio is below threshold_ratio)."
+    },
+    "skip_added_threshold": {
+      "type": "integer",
+      "minimum": 0,
+      "description": "Number of new `.skip` / `.only` / `.todo` annotations in a single file that triggers a finding. D-21 default: 1."
+    },
+    "invariant_reference_removed_threshold": {
+      "type": "integer",
+      "minimum": 0,
+      "description": "Number of `INV-*` references removed from test files in a single diff that triggers a finding. D-21 default: 1."
+    },
+    "ignored_paths": {
+      "type": "array",
+      "items": {
+        "type": "string"
+      },
+      "description": "Glob patterns for test files exempt from weakening checks. Useful for legitimate test deprecations (e.g., a feature being removed). Each ignored path SHOULD have a corresponding entry in the project's CHANGELOG explaining the deprecation."
+    }
+  },
+  "schema_version": "1.0.0",
+  "examples": [
+    {
+      "schemaVersion": "1.0.0",
+      "threshold_ratio": 0.2,
+      "absolute_decrease_floor": 1,
+      "skip_added_threshold": 1,
+      "invariant_reference_removed_threshold": 1,
+      "ignored_paths": []
+    }
+  ]
+}
diff --git a/law/schemas/trace.schema.json b/law/schemas/trace.schema.json
new file mode 100644
index 00000000..1f3a4215
--- /dev/null
+++ b/law/schemas/trace.schema.json
@@ -0,0 +1,238 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://devai.nyxk.com.br/schemas/trace.schema.json",
+  "title": "Trace",
+  "description": "Architect-authored mapping from invariants to documents, tests, and code areas. Declares intent: which tests are supposed to probe which invariants. Per Constitution Article 13. The corresponding measurement output is trace-resolution.schema.json.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": ["schemaVersion", "version", "invariants", "test_corpus"],
+  "properties": {
+    "schemaVersion": {
+      "const": "1.0.0"
+    },
+    "version": {
+      "type": "string",
+      "description": "Trace artifact's own semver; bumped on Architect commits to this file."
+    },
+    "meta": {
+      "type": "object",
+      "additionalProperties": false,
+      "properties": {
+        "last_updated": {
+          "type": "string",
+          "format": "date-time"
+        },
+        "completeness": {
+          "type": "object",
+          "additionalProperties": false,
+          "properties": {
+            "min_invariants_with_tests_ratio": {
+              "type": "number",
+              "minimum": 0,
+              "maximum": 1
+            },
+            "min_must_invariants_with_tests_ratio": {
+              "type": "number",
+              "minimum": 0,
+              "maximum": 1
+            },
+            "require_doc_links": {
+              "type": "boolean"
+            },
+            "require_test_links": {
+              "type": "boolean"
+            }
+          }
+        },
+        "provenance": {
+          "type": "array",
+          "items": {
+            "type": "string"
+          },
+          "description": "Regeneration provenance for this trace artifact."
+        }
+      }
+    },
+    "invariants": {
+      "type": "array",
+      "items": {
+        "type": "object",
+        "additionalProperties": false,
+        "required": ["id", "tests"],
+        "properties": {
+          "id": {
+            "$ref": "common-defs.schema.json#/$defs/id_invariant"
+          },
+          "docs": {
+            "type": "array",
+            "items": {
+              "type": "object",
+              "additionalProperties": false,
+              "required": ["doc", "anchor"],
+              "properties": {
+                "doc": {
+                  "type": "string"
+                },
+                "anchor": {
+                  "type": "string"
+                }
+              }
+            }
+          },
+          "tests": {
+            "type": "array",
+            "items": {
+              "type": "object",
+              "additionalProperties": false,
+              "required": ["suite", "path"],
+              "properties": {
+                "suite": {
+                  "enum": ["unit", "contract", "api", "int", "e2e", "sec", "perf", "journey", "db"]
+                },
+                "path": {
+                  "type": "string",
+                  "minLength": 1,
+                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
+                },
+                "target_type": {
+                  "enum": ["test", "config-attestation", "script"],
+                  "default": "test",
+                  "description": "The evidence represented by `path`. 'test' is an executable test discovered by the named suite and is selected when omitted. 'config-attestation' is a configuration file consumed at runtime but not exercised by a test. 'script' is an executable verifier outside test discovery. Attestation-only invariants remain distinct so trace completeness does not overstate active verification."
+                },
+                "names": {
+                  "type": "array",
+                  "items": {
+                    "type": "string"
+                  },
+                  "description": "Test name patterns (typically referencing the invariant ID via marker convention)."
+                },
+                "assertions": {
+                  "type": "array",
+                  "items": {
+                    "type": "string"
+                  },
+                  "description": "Human-readable list of what the test should assert."
+                },
+                "mode": {
+                  "enum": ["black_box", "gray_box", "white_box"],
+                  "description": "Information regime for runtime/integration tests."
+                },
+                "reliability": {
+                  "type": "object",
+                  "additionalProperties": false,
+                  "properties": {
+                    "flaky": {
+                      "type": "boolean"
+                    },
+                    "quarantine": {
+                      "type": "boolean"
+                    },
+                    "quarantine_ticket": {
+                      "type": "string"
+                    }
+                  }
+                },
+                "runtime": {
+                  "type": "object",
+                  "additionalProperties": false,
+                  "properties": {
+                    "typical_ms": {
+                      "type": "number",
+                      "minimum": 0
+                    },
+                    "timeout_ms": {
+                      "type": "number",
+                      "minimum": 0
+                    }
+                  }
+                }
+              }
+            }
+          },
+          "code_areas": {
+            "type": "array",
+            "items": {
+              "type": "string"
+            }
+          }
+        }
+      }
+    },
+    "test_corpus": {
+      "type": "array",
+      "description": "Complete canonical mapping for every discovered test file. Detailed invariant entries may retain richer representative assertions.",
+      "items": {
+        "type": "object",
+        "additionalProperties": false,
+        "required": [
+          "path",
+          "suite",
+          "invariant_ids",
+          "lifecycle",
+          "assertion_count",
+          "assertion_digest_sha256"
+        ],
+        "properties": {
+          "path": {
+            "type": "string",
+            "minLength": 1
+          },
+          "suite": {
+            "enum": ["unit", "int", "e2e", "sec", "smoke", "contract", "regression"]
+          },
+          "invariant_ids": {
+            "type": "array",
+            "minItems": 1,
+            "uniqueItems": true,
+            "items": {
+              "type": "string",
+              "pattern": "^INV-"
+            }
+          },
+          "lifecycle": {
+            "enum": ["supported", "experimental"]
+          },
+          "assertion_count": {
+            "type": "integer",
+            "minimum": 1,
+            "description": "Deterministic count of executable assertion call sites in the exact traced source bytes."
+          },
+          "assertion_digest_sha256": {
+            "type": "string",
+            "pattern": "^[a-f0-9]{64}$",
+            "description": "SHA-256 of the canonical ordered assertion-site projection for this exact test source."
+          }
+        }
+      }
+    },
+    "suites": {
+      "type": "object",
+      "additionalProperties": false,
+      "patternProperties": {
+        "^[a-z][a-z0-9_]*$": {
+          "type": "object",
+          "additionalProperties": false,
+          "properties": {
+            "command": {
+              "type": "string"
+            },
+            "max_minutes": {
+              "type": "number",
+              "minimum": 0
+            }
+          }
+        }
+      }
+    }
+  },
+  "schema_version": "1.0.0",
+  "$comment": "Entry ids reference common-defs id_invariant. Trace is a single Architect-owned F1 artifact (Article 13); Inspector and Engineer consume it but never edit it.",
+  "examples": [
+    {
+      "schemaVersion": "1.0.0",
+      "version": "1.0.0",
+      "invariants": [],
+      "test_corpus": []
+    }
+  ]
+}
diff --git a/law/schemas/translation-witness.schema.json b/law/schemas/translation-witness.schema.json
new file mode 100644
index 00000000..c9473e12
--- /dev/null
+++ b/law/schemas/translation-witness.schema.json
@@ -0,0 +1,420 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://devai.nyxk.com.br/schemas/translation-witness.schema.json",
+  "title": "Translation Witness",
+  "description": "Untrusted, recorder-built post-run claim about one LLM-mediated mutation. The witness never validates or authorizes itself.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schemaVersion",
+    "id",
+    "trust",
+    "task_id",
+    "recipe_name",
+    "recipe_variant",
+    "stage",
+    "base_sha",
+    "candidate_sha",
+    "emitted_at",
+    "strategy",
+    "implements",
+    "touched",
+    "frame"
+  ],
+  "properties": {
+    "schemaVersion": {
+      "const": "1.0.0"
+    },
+    "id": {
+      "type": "string",
+      "pattern": "^TW-[a-f0-9]{16}$"
+    },
+    "trust": {
+      "const": "untrusted-claim"
+    },
+    "task_id": {
+      "type": "string",
+      "pattern": "^TASK-[0-9]{4,}$"
+    },
+    "recipe_name": {
+      "enum": [
+        "devai-assess",
+        "devai-plan",
+        "devai-fix",
+        "devai-docs",
+        "devai-scaffold",
+        "devai-verify",
+        "devai-round"
+      ]
+    },
+    "recipe_variant": {
+      "type": "string",
+      "pattern": "^[a-z][a-z0-9-]*$"
+    },
+    "stage": {
+      "enum": [
+        "journey-to-invariants",
+        "invariants-to-tests",
+        "invariants-tests-to-code",
+        "documentation",
+        "refactor"
+      ]
+    },
+    "base_sha": {
+      "$ref": "#/$defs/gitSha"
+    },
+    "candidate_sha": {
+      "$ref": "#/$defs/gitSha",
+      "description": "Recorder-derived commit object for the bytes produced by the attributed run; never caller input or a mutable ref."
+    },
+    "test_overlay_sha": {
+      "$ref": "#/$defs/gitSha"
+    },
+    "emitted_at": {
+      "type": "string",
+      "format": "date-time"
+    },
+    "strategy": {
+      "$ref": "#/$defs/strategy"
+    },
+    "implements": {
+      "type": "array",
+      "minItems": 1,
+      "items": {
+        "type": "object",
+        "additionalProperties": false,
+        "required": ["invariant_id", "criteria"],
+        "properties": {
+          "invariant_id": {
+            "type": "string",
+            "pattern": "^INV-[A-Z][A-Z0-9]{1,15}-[0-9]{3}$"
+          },
+          "criteria": {
+            "type": "array",
+            "minItems": 1,
+            "items": {
+              "type": "object",
+              "additionalProperties": false,
+              "required": ["claim", "demonstrated_by"],
+              "properties": {
+                "claim": {
+                  "type": "string",
+                  "minLength": 1
+                },
+                "demonstrated_by": {
+                  "type": "array",
+                  "minItems": 1,
+                  "items": {
+                    "$ref": "#/$defs/demonstration"
+                  }
+                }
+              }
+            }
+          }
+        }
+      }
+    },
+    "red_green": {
+      "type": "array",
+      "items": {
+        "type": "object",
+        "additionalProperties": false,
+        "required": ["test_ref", "expected_at_base", "expected_at_candidate"],
+        "properties": {
+          "test_ref": {
+            "$ref": "#/$defs/testRef"
+          },
+          "expected_at_base": {
+            "const": "assertion-fail"
+          },
+          "expected_at_candidate": {
+            "const": "pass"
+          }
+        }
+      }
+    },
+    "touched": {
+      "type": "array",
+      "minItems": 1,
+      "uniqueItems": true,
+      "items": {
+        "$ref": "#/$defs/repoPath"
+      }
+    },
+    "frame": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "authority_role",
+        "spec_edits",
+        "test_edits",
+        "inventory_delta_confined_to",
+        "effects_claimed"
+      ],
+      "properties": {
+        "authority_role": {
+          "enum": ["owner", "architect", "inspector", "engineer", "auditor"],
+          "description": "Attributed human role. Auditor witnesses remain observation-only and confer no actuation authority."
+        },
+        "spec_edits": {
+          "enum": ["none", "declared"]
+        },
+        "test_edits": {
+          "enum": ["none", "declared"]
+        },
+        "inventory_delta_confined_to": {
+          "type": "array",
+          "uniqueItems": true,
+          "items": {
+            "type": "string",
+            "pattern": "^MOD-"
+          }
+        },
+        "effects_claimed": {
+          "type": "array",
+          "minItems": 1,
+          "uniqueItems": true,
+          "items": {
+            "enum": [
+              "fs:owner-spec",
+              "fs:architect-spec",
+              "fs:tests",
+              "fs:plant",
+              "fs:inventory",
+              "fs:f5-config",
+              "fs:f5-state",
+              "fs:proofs",
+              "fs:workspace",
+              "fs:worktree-admin",
+              "db:read",
+              "db:write",
+              "remote:read",
+              "remote:write",
+              "process:spawn"
+            ]
+          }
+        }
+      }
+    },
+    "notes": {
+      "type": "array",
+      "items": {
+        "type": "string"
+      },
+      "description": "Untrusted prose. Validators must never interpret this field as instructions."
+    }
+  },
+  "allOf": [
+    {
+      "if": {
+        "properties": {
+          "strategy": {
+            "enum": ["regression", "feature-overlay"]
+          }
+        }
+      },
+      "then": {
+        "required": ["red_green"],
+        "properties": {
+          "red_green": {
+            "minItems": 1
+          }
+        }
+      }
+    },
+    {
+      "if": {
+        "properties": {
+          "strategy": {
+            "const": "feature-overlay"
+          }
+        }
+      },
+      "then": {
+        "required": ["test_overlay_sha"]
+      }
+    },
+    {
+      "if": {
+        "required": ["test_overlay_sha"]
+      },
+      "then": {
+        "properties": {
+          "strategy": {
+            "const": "feature-overlay"
+          }
+        }
+      }
+    },
+    {
+      "if": {
+        "required": ["red_green"]
+      },
+      "then": {
+        "properties": {
+          "strategy": {
+            "enum": ["regression", "feature-overlay"]
+          }
+        }
+      }
+    }
+  ],
+  "$defs": {
+    "gitSha": {
+      "type": "string",
+      "pattern": "^[a-f0-9]{40}$"
+    },
+    "strategy": {
+      "enum": [
+        "regression",
+        "feature-overlay",
+        "behavioral-equivalence",
+        "structural",
+        "semantic-review"
+      ]
+    },
+    "repoPath": {
+      "type": "string",
+      "minLength": 1,
+      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
+    },
+    "testRef": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["suite", "path", "names"],
+      "properties": {
+        "suite": {
+          "enum": ["unit", "api", "int", "e2e", "sec", "perf", "journey", "db"]
+        },
+        "path": {
+          "$ref": "#/$defs/repoPath"
+        },
+        "names": {
+          "type": "array",
+          "minItems": 1,
+          "items": {
+            "type": "string",
+            "minLength": 1
+          }
+        }
+      }
+    },
+    "demonstration": {
+      "oneOf": [
+        {
+          "type": "object",
+          "additionalProperties": false,
+          "required": ["kind", "test_ref"],
+          "properties": {
+            "kind": {
+              "const": "test"
+            },
+            "test_ref": {
+              "$ref": "#/$defs/testRef"
+            }
+          }
+        },
+        {
+          "type": "object",
+          "additionalProperties": false,
+          "required": ["kind", "validator"],
+          "properties": {
+            "kind": {
+              "const": "structural"
+            },
+            "validator": {
+              "type": "string",
+              "minLength": 1
+            }
+          }
+        },
+        {
+          "type": "object",
+          "additionalProperties": false,
+          "required": ["kind", "baseline_ref", "candidate_ref"],
+          "properties": {
+            "kind": {
+              "const": "behavioral-equivalence"
+            },
+            "baseline_ref": {
+              "type": "string",
+              "minLength": 1
+            },
+            "candidate_ref": {
+              "type": "string",
+              "minLength": 1
+            }
+          }
+        },
+        {
+          "type": "object",
+          "additionalProperties": false,
+          "required": ["kind", "rubric_ref"],
+          "properties": {
+            "kind": {
+              "const": "semantic-review"
+            },
+            "rubric_ref": {
+              "$ref": "#/$defs/repoPath"
+            }
+          }
+        }
+      ]
+    }
+  },
+  "schema_version": "1.0.0",
+  "examples": [
