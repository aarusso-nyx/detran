+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://devai.nyxk.com.br/schemas/meta.schema.json",
+  "title": "DEVAI schema meta-schema",
+  "description": "Every shipped schema validates against this declarative gate. Recursive canonicalization rules live in `check schemas`, not in a custom JSON Schema dialect.",
+  "schema_version": "1.0.0",
+  "type": "object",
+  "properties": {
+    "$schema": {
+      "const": "https://json-schema.org/draft/2020-12/schema"
+    },
+    "$id": {
+      "type": "string",
+      "pattern": "^https://devai\\.nyxk\\.com\\.br/schemas/[a-z0-9-]+\\.schema\\.json$"
+    },
+    "title": {
+      "type": "string",
+      "minLength": 3
+    },
+    "description": {
+      "type": "string",
+      "minLength": 10
+    },
+    "schema_version": {
+      "type": "string",
+      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
+    },
+    "examples": {
+      "type": "array",
+      "minItems": 1
+    }
+  },
+  "required": ["$schema", "$id", "title", "description", "schema_version", "examples"],
+  "examples": [
+    {
+      "$schema": "https://json-schema.org/draft/2020-12/schema",
+      "$id": "https://devai.nyxk.com.br/schemas/example.schema.json",
+      "title": "Example schema",
+      "description": "Minimal meta-schema-conforming schema.",
+      "schema_version": "1.0.0",
+      "examples": [{}]
+    }
+  ]
+}
