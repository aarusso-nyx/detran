+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://devai.nyxk.com.br/schemas/routes-inventory.schema.json",
+  "$comment": "REDOX-Routes: absorbed from /Users/aarusso/Development/tools/redox/src/schemas/Routes.schema.json in Phase 17.B (D-57).",
+  "title": "Frontend Routes Inventory",
+  "description": "Inventory of frontend routes (Angular/React/AngularJS/Next/Remix) discovered by deterministic static introspection. Emitted as a SensorReading body at tier L0 by inventory_routes sensors (Phase 17.C). Per Constitution Article 17 (sensors); per D-57 (brownfield-adoption substrate).",
+  "type": "object",
+  "additionalProperties": false,
+  "properties": {
+    "schemaVersion": {
+      "type": "string",
+      "const": "1.0.0"
+    },
