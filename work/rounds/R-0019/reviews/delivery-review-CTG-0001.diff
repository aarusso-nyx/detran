diff --git a/law/schemas/mutation-scenario.schema.json b/law/schemas/mutation-scenario.schema.json
new file mode 100644
index 00000000..e7bfcc6f
--- /dev/null
+++ b/law/schemas/mutation-scenario.schema.json
@@ -0,0 +1,114 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://devai.nyxk.com.br/schemas/mutation-scenario.schema.json",
+  "title": "Mutation scenario",
+  "description": "One executable mutation scenario consumed by the current mutation runner.",
+  "schema_version": "1.0.0",
+  "type": "object",
+  "additionalProperties": false,
+  "required": ["schema_version", "id", "kind", "target", "mutations", "expectations"],
+  "properties": {
+    "schema_version": { "const": "1.0.0" },
+    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
+    "kind": { "const": "mutation" },
+    "target": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["file"],
+      "properties": {
+        "file": { "$ref": "#/$defs/relativePath" },
+        "symbol": { "type": "string", "minLength": 1 },
+        "invariant_ref": { "type": "string", "minLength": 1 }
+      }
+    },
+    "mutations": {
+      "type": "array",
+      "minItems": 1,
+      "items": { "$ref": "#/$defs/mutation" }
+    },
+    "expectations": {
+      "type": "array",
+      "minItems": 1,
+      "items": { "$ref": "#/$defs/expectation" }
+    },
+    "domain_tags": {
+      "type": "array",
+      "uniqueItems": true,
+      "items": { "type": "string", "minLength": 1 }
+    },
+    "rationale": { "type": "string", "minLength": 1 },
+    "timeout_ms": { "type": "integer", "minimum": 1 }
+  },
+  "$defs": {
+    "relativePath": {
+      "type": "string",
+      "minLength": 1,
+      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
+    },
+    "mutation": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["type", "replace"],
+      "properties": {
+        "type": { "enum": ["string-replace", "regex-replace"] },
+        "find": { "type": "string" },
+        "pattern": { "type": "string" },
+        "flags": { "type": "string", "pattern": "^[dgimsuvy]*$" },
+        "replace": { "type": "string" },
+        "mutator_name": { "type": "string", "minLength": 1 }
+      },
+      "allOf": [
+        {
+          "if": { "properties": { "type": { "const": "string-replace" } } },
+          "then": { "required": ["find"], "not": { "required": ["pattern"] } }
+        },
+        {
+          "if": { "properties": { "type": { "const": "regex-replace" } } },
+          "then": { "required": ["pattern"], "not": { "required": ["find"] } }
+        }
+      ]
+    },
+    "expectation": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["assertion", "specs"],
+      "properties": {
+        "assertion": { "enum": ["tests-detect", "tests-tolerate"] },
+        "specs": {
+          "type": "array",
+          "minItems": 1,
+          "uniqueItems": true,
+          "items": { "$ref": "#/$defs/relativePath" }
+        },
+        "threshold": {
+          "type": "object",
+          "additionalProperties": false,
+          "properties": {
+            "status": { "enum": ["Killed", "Survived", "Timeout", "RuntimeError"] }
+          }
+        }
+      }
+    }
+  },
+  "examples": [
+    {
+      "schema_version": "1.0.0",
+      "id": "example-string-replacement",
+      "kind": "mutation",
+      "target": { "file": "packages/example.ts" },
+      "mutations": [
+        {
+          "type": "string-replace",
+          "find": "before",
+          "replace": "after"
+        }
+      ],
+      "expectations": [
+        {
+          "assertion": "tests-detect",
+          "specs": ["tests/example.test.ts"]
+        }
+      ]
+    }
+  ]
+}
diff --git a/law/schemas/phase-closure.schema.json b/law/schemas/phase-closure.schema.json
new file mode 100644
index 00000000..dda65941
--- /dev/null
+++ b/law/schemas/phase-closure.schema.json
@@ -0,0 +1,212 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://devai.nyxk.com.br/schemas/phase-closure.schema.json",
+  "title": "PhaseClosure",
+  "description": "Append-only machine closure record including decision bindings, delivered units, gate posture, validation criteria, and source-repository disposition. Corrections append a new record linked through `supersedes`.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schemaVersion",
+    "id",
+    "round_id",
+    "declaring_decision",
+    "closing_decision",
+    "batches",
+    "gates",
+    "source_repo_deleted",
+    "validation_criteria",
+    "closed_at"
+  ],
+  "properties": {
+    "schemaVersion": {
+      "const": "1.0.0"
+    },
+    "id": {
+      "type": "string",
+      "pattern": "^PC-[0-9]{4}$",
+      "description": "Sequential closure id allocated as max(existing) + 1."
+    },
+    "round_id": {
+      "type": "string",
+      "minLength": 1,
+      "description": "Human identifier of the closed work unit."
+    },
+    "title": {
+      "type": "string",
+      "description": "One-line headline of what the closed work unit delivered."
+    },
+    "declaring_decision": {
+      "type": "string",
+      "pattern": "^(?:D-[0-9]+|DII-[0-9]+)$",
+      "description": "Decision record that declared the work unit."
+    },
+    "closing_decision": {
+      "type": "string",
+      "pattern": "^(?:D-[0-9]+|DII-[0-9]+)$",
+      "description": "Decision record containing the closing judgment."
+    },
+    "batches": {
+      "type": "array",
+      "minItems": 1,
+      "items": {
+        "type": "object",
+        "additionalProperties": false,
+        "required": ["id", "roles", "headline"],
+        "properties": {
+          "id": {
+            "type": "string",
+            "minLength": 1
+          },
+          "roles": {
+            "type": "array",
+            "minItems": 1,
+            "items": {
+              "enum": ["Owner", "Architect", "Inspector", "Engineer", "Auditor", "Machine"]
+            }
+          },
+          "commit": {
+            "type": "string",
+            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
+            "description": "Commit SHA containing the delivered unit. Optional when delivery is part of the closing commit."
+          },
+          "headline": {
+            "type": "string",
+            "minLength": 1
+          }
+        },
+        "allOf": [
+          {
+            "if": {
+              "properties": {
+                "roles": {
+                  "contains": {
+                    "const": "Machine"
+                  }
+                }
+              },
+              "required": ["roles"]
+            },
+            "then": {
+              "required": ["commit"]
+            }
+          }
+        ]
+      }
+    },
+    "gates": {
+      "type": "object",
+      "description": "Gate results at close, keyed by check name.",
+      "minProperties": 1,
+      "propertyNames": {
+        "type": "string",
+        "minLength": 1,
+        "pattern": ".*\\S.*"
+      },
+      "additionalProperties": {
+        "type": "object",
+        "additionalProperties": false,
+        "required": ["status"],
+        "properties": {
+          "status": {
+            "enum": ["pass", "fail", "skipped"]
+          },
+          "detail": {
+            "type": "string",
+            "description": "Free-form evidence, for example 'all selected checks passed'."
+          }
+        }
+      }
+    },
+    "source_repo_deleted": {
+      "type": "boolean",
+      "description": "Whether the closed work deleted a source repository."
+    },
+    "validation_criteria": {
+      "type": "array",
+      "minItems": 1,
+      "items": {
+        "type": "object",
+        "additionalProperties": false,
+        "required": ["criterion", "verdict"],
+        "properties": {
+          "criterion": {
+            "type": "string",
+            "minLength": 1
+          },
+          "verdict": {
+            "enum": ["pass", "fail", "n/a"]
+          },
+          "evidence": {
+            "type": "string"
+          }
+        }
+      }
+    },
+    "closed_at": {
+      "type": "string",
+      "format": "date-time"
+    },
+    "supersedes": {
+      "type": "string",
+      "pattern": "^PC-[0-9]{4}$",
+      "description": "Set when this record corrects an earlier closure; the earlier record's bytes stay untouched."
+    },
+    "merged_as": {
+      "type": "string",
+      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
+      "description": "The integration commit that contains the closed work unit. Current closure writes require this field."
+    },
+    "release_disposition": {
+      "enum": ["published", "changeset-pending", "none-needed", "missing"],
+      "description": "Whether package changes have a release path: published, changeset-pending, none-needed, or missing."
+    },
+    "evidence": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["proof_epoch", "terminal_sha256"],
+      "properties": {
+        "proof_epoch": {
+          "type": "string",
+          "minLength": 1
+        },
+        "terminal_sha256": {
+          "$ref": "common-defs.schema.json#/$defs/sha256"
+        }
+      },
+      "description": "Machine-evidence epoch bound by this closure. The terminal hash commits to the complete line-hash chain."
+    },
+    "notes": {
+      "type": "string"
+    }
+  },
+  "schema_version": "1.0.0",
+  "examples": [
+    {
+      "schemaVersion": "1.0.0",
+      "id": "PC-0001",
+      "closed_at": "2026-06-10T03:30:00.000Z",
+      "round_id": "maintenance",
+      "declaring_decision": "D-1",
+      "closing_decision": "D-2",
+      "batches": [
+        {
+          "id": "B1",
+          "roles": ["Architect"],
+          "headline": "Updated the declared contract and its validation evidence."
+        }
+      ],
+      "gates": {
+        "check": {
+          "status": "pass"
+        }
+      },
+      "source_repo_deleted": false,
+      "validation_criteria": [
+        {
+          "criterion": "declared checks pass",
+          "verdict": "pass"
+        }
+      ]
+    }
+  ]
+}
diff --git a/law/schemas/project-config.schema.json b/law/schemas/project-config.schema.json
new file mode 100644
index 00000000..dd366ceb
--- /dev/null
+++ b/law/schemas/project-config.schema.json
@@ -0,0 +1,311 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://devai.nyxk.com.br/schemas/project-config.schema.json",
+  "title": "DEVAI Project Config",
+  "description": "Per-repository DEVAI project declaration at .devai/config/project.json.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": ["schemaVersion", "project_type"],
+  "properties": {
+    "schemaVersion": {
+      "const": "1.0.0"
+    },
+    "project_type": {
+      "enum": ["runtime-host", "platform-package", "docs-archive", "framework"],
+      "description": "runtime-host is a deployed application; platform-package is a consumed library; docs-archive has no runtime; framework is supporting tooling without a client substrate."
+    },
+    "name": {
+      "type": "string",
+      "minLength": 1
+    },
+    "profile": {
+      "enum": ["tier1", "tier2", "tier3"],
+      "description": "Adoption profile. tier1 provides deterministic gates and evidence; tier2 adds specification and sensor contracts; tier3 adds the complete human-supervised workflow. When absent, the strict tier3 posture applies."
+    },
+    "adopted_at": {
+      "type": "string",
+      "format": "date-time",
+      "description": "When the repo first adopted DEVAI."
+    },
+    "devai_version": {
+      "type": "string",
+      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$",
+      "description": "Machine-managed package version stamped during initialization. `devai doctor` compares it with the installed @aarusso-nyx/devai version."
+    },
+    "constitution": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["version"],
+      "description": "Constitution binding pin for the vendored `.devai/pin/constitution.md` copy. `devai doctor` verifies the digest; `devai init bind --constitution --write` refreshes the copy and pin.",
+      "properties": {
+        "version": {
+          "type": "string",
+          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
+          "description": "The constitution version the repo is bound to, parsed from the vendored copy's version header."
+        },
+        "sha256": {
+          "type": "string",
+          "pattern": "^[a-f0-9]{64}$",
+          "description": "sha256 of the vendored constitution text. Makes the pin load-bearing: doctor fails the binding check when the pin and the vendored copy disagree."
+        }
+      }
+    },
+    "invariant_filters": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "Per-type rule filtering. Invariants whose `project_types` array (when present) excludes this project_type are skipped by validators.",
+      "properties": {
+        "include_tags": {
+          "type": "array",
+          "items": {
+            "type": "string"
+          }
+        },
+        "exclude_tags": {
+          "type": "array",
+          "items": {
+            "type": "string"
+          }
+        }
+      }
+    },
+    "feature_flags": {
+      "type": "object",
+      "additionalProperties": {
+        "type": "boolean"
+      },
+      "description": "Per-repo toggles for opt-in DEVAI features."
+    },
+    "authority_enforcement": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["mode"],
+      "properties": {
+        "mode": {
+          "enum": ["cli-only", "host-integrated"],
+          "description": "cli-only covers DEVAI runtime actions; host-integrated additionally declares external-tool enforcement."
+        },
+        "adapter_config": {
+          "type": "string",
+          "minLength": 1,
+          "description": "Repo-relative host adapter configuration, required for host-integrated mode."
+        }
+      },
+      "allOf": [
+        {
+          "if": {
+            "properties": {
+              "mode": {
+                "const": "host-integrated"
+              }
+            }
+          },
+          "then": {
+            "required": ["adapter_config"]
+          }
+        }
+      ]
+    },
+    "repo": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "Repository classification metadata documented in docs/adopters/docs-layout.md#repository-classification-and-builder.",
+      "required": ["kind"],
+      "properties": {
+        "kind": {
+          "enum": ["library", "application"],
+          "description": "library: package consumed by other projects (MUST use docusaurus). application: business app running production traffic."
+        }
+      }
+    },
+    "docs": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "Documentation build and publish configuration documented in docs/adopters/docs-layout.md.",
+      "required": ["builder"],
+      "properties": {
+        "builder": {
+          "enum": ["docusaurus", "jekyll"],
+          "description": "Documentation builder. Library repositories must use Docusaurus; see docs/adopters/docs-layout.md#repository-classification-and-builder."
+        },
+        "build_command": {
+          "type": "string",
+          "minLength": 1,
+          "description": "Command to build the docs site. Defaults per builder if absent."
+        },
+        "output_dir": {
+          "type": "string",
+          "minLength": 1,
+          "description": "Relative path from repo root to the build output directory."
+        },
+        "publish_target": {
+          "enum": ["gh-pages"],
+          "description": "Reviewed documentation publication target. Publication remains a separately authorized external effect."
+        },
+        "gh_pages_branch": {
+          "type": "string",
+          "minLength": 1,
+          "description": "Exact branch inspected by documentation governance when publish_target is gh-pages."
+        },
+        "custom_domain": {
+          "type": ["string", "null"],
+          "description": "Custom domain for the published docs site. null or empty string means no custom domain (no CNAME file written)."
+        },
+        "ia": {
+          "type": "object",
+          "additionalProperties": false,
+          "description": "Documentation information-architecture declarations described in docs/adopters/docs-layout.md#information-architecture.",
+          "properties": {
+            "collapsed_sections": {
+              "type": "array",
+              "items": {
+                "enum": ["theory", "framework", "roles", "adopters", "reference", "meta"]
+              },
+              "uniqueItems": true,
+              "description": "Sections an application-tier adopter with no downstream consumers collapses to a single stub page pointing upstream instead of authoring in full; see docs/adopters/docs-layout.md#information-architecture."
+            },
+            "path_overrides": {
+              "type": "object",
+              "additionalProperties": {
+                "type": "string",
+                "minLength": 1
+              },
+              "description": "D-125: maps a canonical F1/reading-order key (a docs/-rooted path with the docs/ prefix stripped, e.g. \"framework/contracts\") to the adopter's actual current relative path (e.g. \"reference/contracts\") when a binding ADR has relocated that substrate. Consulted by `devai doctor`'s f1-paths-present and agents-claude-sync checks before they test path existence / reading-order substring match. Absent key, or absent docs.ia entirely, leaves both checks byte-identical to pre-D-125 behavior."
+            }
+          }
+        }
+      }
+    },
+    "ci_economy": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "CI-economy configuration documented in docs/adopters/ci-economy.md and amended by D-116.",
+      "properties": {
+        "profile": {
+          "enum": ["full", "gate-staged"],
+          "description": "Enforcement profile for `devai check --only ci-economy`. full makes every rule binding. gate-staged keeps the evidence-gate rule visible but advisory while the other rules remain binding."
+        },
+        "local_evidence": {
+          "type": "object",
+          "additionalProperties": false,
+          "required": ["required_jobs"],
+          "description": "Local-CI-evidence policy (D-117; see docs/adopters/ci-economy.md). Declares what a local-evidence manifest must prove for `devai evidence local verify` to let the remote gate skip heavy tiers. Absent means the repo does not accept local evidence and the gate's fallback path runs heavy tiers remotely.",
+          "properties": {
+            "manifest_path": {
+              "type": "string",
+              "minLength": 1,
+              "description": "Committed manifest location. Default: .ci/evidence/local-ci.json (matches pre-promotion consumers; zero migration)."
+            },
+            "max_age_hours": {
+              "type": "integer",
+              "minimum": 1,
+              "maximum": 168,
+              "description": "Maximum manifest age accepted by verification. Default 24."
+            },
+            "required_jobs": {
+              "type": "array",
+              "items": {
+                "type": "string",
+                "minLength": 1
+              },
+              "minItems": 1,
+              "uniqueItems": true,
+              "description": "Local job names that must all be present with result=success in the manifest."
+            },
+            "allowed_platforms": {
+              "type": "array",
+              "items": {
+                "type": "string",
+                "pattern": "^(linux|darwin)/(amd64|arm64)$"
+              },
+              "minItems": 1,
+              "uniqueItems": true,
+              "description": "Platforms local jobs may run on. Default: linux/arm64, linux/amd64."
+            },
+            "forbidden_paths": {
+              "type": "array",
+              "items": {
+                "type": "string",
+                "minLength": 1
+              },
+              "description": "Path prefixes whose changes reject evidence mode (policy-sensitive surfaces). Merged with the built-in defaults (.github/workflows/, .devai/config/, the manifest's own directory); entries here extend, never replace."
+            },
+            "require_docker": {
+              "type": "boolean",
+              "description": "When true, verification requires observed docker version evidence in the manifest. Default false (not every adopter's local CI is containerized)."
+            }
+          }
+        },
+        "attested_rc": {
+          "type": "object",
+          "additionalProperties": false,
+          "required": [
+            "profile",
+            "transport",
+            "tag_prefix",
+            "binding",
+            "required_check",
+            "failure_mode",
+            "local_only_nodes"
+          ],
+          "description": "Trusted local RC evidence policy. When present, local-only nodes execute under Inspector authority and GitHub verifies the protected-tag attestation without executing candidate product commands.",
+          "properties": {
+            "profile": {
+              "const": "rc"
+            },
+            "transport": {
+              "const": "protected-tag-v1"
+            },
+            "tag_prefix": {
+              "type": "string",
+              "pattern": "^devai-local-evidence/[A-Za-z0-9._/-]*$"
+            },
+            "binding": {
+              "const": "exact-tree"
+            },
+            "required_check": {
+              "const": "verified-local-rc"
+            },
+            "failure_mode": {
+              "const": "fail-closed"
+            },
+            "local_only_nodes": {
+              "type": "array",
+              "minItems": 1,
+              "uniqueItems": true,
+              "items": {
+                "type": "string",
+                "minLength": 1
+              }
+            }
+          }
+        }
+      }
+    },
+    "governance_tracking": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["adapter", "config"],
+      "description": "Optional opt-in tracking binding. Absence means tracking is disabled and preserves pre-1.3.0 behavior exactly: no tracking state, no network call, and no readiness effect. Presence binds the repository capability only; it activates no round and grants no publication authority.",
+      "properties": {
+        "adapter": {
+          "const": "github-issues"
+        },
+        "config": {
+          "const": ".devai/config/github-issues-tracking.json",
+          "description": "Path to the bound adapter configuration materialized by init bind."
+        },
+        "workflow": {
+          "const": ".github/workflows/devai-issue-tracking.yml"
+        }
+      }
+    }
+  },
+  "schema_version": "1.0.0",
+  "examples": [
+    {
+      "schemaVersion": "1.0.0",
+      "project_type": "runtime-host"
+    }
+  ]
+}
diff --git a/law/schemas/proof-epoch.schema.json b/law/schemas/proof-epoch.schema.json
new file mode 100644
index 00000000..9d1f16cd
--- /dev/null
+++ b/law/schemas/proof-epoch.schema.json
@@ -0,0 +1,73 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://devai.nyxk.com.br/schemas/proof-epoch.schema.json",
+  "title": "Proof epoch JSONL line",
+  "description": "One canonical line in a per-round/per-kind proof epoch. Records and errata bind the preceding line; the terminal line additionally binds the final non-terminal hash and declared record count so truncation fails closed.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schemaVersion",
+    "line_type",
+    "round_id",
+    "kind",
+    "sequence",
+    "timestamp",
+    "payload",
+    "previous_line_hash",
+    "line_hash"
+  ],
+  "properties": {
+    "$schema": { "type": "string" },
+    "schemaVersion": { "const": "1.0.0" },
+    "line_type": { "enum": ["record", "errata", "terminal"] },
+    "round_id": { "type": "string", "pattern": "^R-[0-9]{4}$" },
+    "kind": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
+    "sequence": { "type": "integer", "minimum": 1 },
+    "timestamp": { "type": "string", "format": "date-time" },
+    "payload": { "type": "object" },
+    "previous_line_hash": {
+      "type": ["string", "null"],
+      "pattern": "^[a-f0-9]{64}$"
+    },
+    "line_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
+    "corrects_sequence": { "type": "integer", "minimum": 1 },
+    "reason": { "type": "string", "minLength": 1 },
+    "record_count": { "type": "integer", "minimum": 0 },
+    "terminal_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
+  },
+  "allOf": [
+    {
+      "if": { "properties": { "sequence": { "const": 1 } } },
+      "then": { "properties": { "previous_line_hash": { "type": "null" } } },
+      "else": { "properties": { "previous_line_hash": { "type": "string" } } }
+    },
+    {
+      "if": { "properties": { "line_type": { "const": "errata" } } },
+      "then": { "required": ["corrects_sequence", "reason"] },
+      "else": {
+        "not": { "anyOf": [{ "required": ["corrects_sequence"] }, { "required": ["reason"] }] }
+      }
+    },
+    {
+      "if": { "properties": { "line_type": { "const": "terminal" } } },
+      "then": { "required": ["record_count", "terminal_hash"] },
+      "else": {
+        "not": { "anyOf": [{ "required": ["record_count"] }, { "required": ["terminal_hash"] }] }
+      }
+    }
+  ],
+  "schema_version": "1.0.0",
+  "examples": [
+    {
+      "schemaVersion": "1.0.0",
+      "line_type": "record",
+      "round_id": "R-0100",
+      "kind": "test-results",
+      "sequence": 1,
+      "timestamp": "2026-07-26T00:00:00.000Z",
+      "payload": { "status": "pass" },
+      "previous_line_hash": null,
+      "line_hash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
+    }
+  ]
+}
