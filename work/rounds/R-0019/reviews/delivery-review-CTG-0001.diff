+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://devai.nyxk.com.br/schemas/glossary-entry.schema.json",
+  "title": "Glossary Entry",
+  "description": "Shared term definition mediating between business and technical language. Joint Owner/Architect authority per Constitution Article 6 (Owner-authority paths).",
+  "type": "object",
+  "additionalProperties": false,
+  "required": ["schemaVersion", "id", "term", "definition", "authority", "status"],
+  "properties": {
+    "schemaVersion": {
+      "const": "1.0.0"
+    },
+    "id": {
+      "type": "string",
+      "pattern": "^GE-[0-9]{3}$"
+    },
+    "term": {
+      "type": "string",
+      "minLength": 1,
+      "description": "Canonical form of the term, exactly as used in specs."
+    },
+    "aliases": {
+      "type": "array",
+      "items": {
+        "type": "string"
+      },
+      "description": "Alternate forms, synonyms, abbreviations, or historical names."
+    },
+    "definition": {
+      "type": "string",
+      "minLength": 1,
+      "description": "Single, unambiguous, closed-world definition. No 'usually' or 'typically'."
+    },
+    "authority": {
+      "$ref": "common-defs.schema.json#/$defs/role",
+      "description": "joint entries require dual sign-off in merge protocol."
+    },
+    "category": {
+      "enum": ["business", "technical", "regulatory", "operational"]
+    },
+    "see_also": {
+      "type": "array",
+      "items": {
+        "type": "string",
+        "pattern": "^GE-[0-9]{3}$"
+      }
+    },
+    "related_invariants": {
+      "type": "array",
+      "items": {
+        "type": "string",
+        "pattern": "^INV-"
+      }
+    },
+    "examples": {
+      "type": "array",
+      "items": {
+        "type": "string"
+      }
+    },
+    "counterexamples": {
+      "type": "array",
+      "items": {
+        "type": "string"
+      },
+      "description": "Things that look like the term but are not. Useful for disambiguation."
+    },
+    "status": {
+      "enum": ["draft", "active", "deprecated", "retired"]
+    },
+    "provenance": {
+      "type": "array",
+      "items": {
+        "type": "string"
+      },
+      "description": "Absorption/supersession provenance per the record meta-structure (\u00a75.1)."
+    },
+    "supersedes": {
+      "type": ["array", "null"],
+      "items": {
+        "type": "string"
+      }
+    },
+    "superseded_by": {
+      "type": ["string", "null"]
+    }
+  },
+  "schema_version": "1.0.0",
+  "examples": [
+    {
+      "schemaVersion": "1.0.0",
+      "id": "GE-001",
+      "term": "Owner",
+      "definition": "The role with authority over business and behavioral specifications. The Owner authors journeys, user stories, and acceptance criteria under docs/product/; co-owns the glossary with the Architect. The Owner does not write invariants directly (D-7); Owner artifacts compile to Architect-authored invariants via explicit related_invariants references.",
+      "authority": "joint",
+      "category": "business",
+      "status": "active",
+      "see_also": ["GE-004", "GE-005", "GE-019"],
+      "related_invariants": ["INV-DEVAI-001"]
+    }
+  ],
+  "$comment": "W02 RESOLVED: glossary authority uses the shared role vocabulary, including the joint token required by Constitution Article 6."
+}
diff --git a/law/schemas/governance-event-segment.schema.json b/law/schemas/governance-event-segment.schema.json
new file mode 100644
index 00000000..bdbd4279
--- /dev/null
+++ b/law/schemas/governance-event-segment.schema.json
@@ -0,0 +1,134 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://devai.nyxk.com.br/schemas/governance-event-segment.schema.json",
+  "title": "Sealed governance event-chain segment",
+  "description": "An immutable, hash-linked checkpoint over a contiguous run of one session's governance events. Segments are written by the executing verb into machine-written proof storage and are never edited; they are the durable evidence a projection is rebuilt from after a crash, an offline round, or a lost remote.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schemaVersion",
+    "segment_id",
+    "repository_id",
+    "round_id",
+    "authority_session_id",
+    "sequence_range",
+    "event_ids",
+    "chain",
+    "sealed_at",
+    "segment_digest_sha256"
+  ],
+  "properties": {
+    "schemaVersion": {
+      "const": "1.0.0"
+    },
+    "segment_id": {
+      "type": "string",
+      "pattern": "^GSEG-[0-9a-f]{16}$"
+    },
+    "repository_id": {
+      "type": "string",
+      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
+    },
+    "round_id": {
+      "type": "string",
+      "pattern": "^R-[0-9]{4,}$"
+    },
+    "authority_session_id": {
+      "type": "string",
+      "pattern": "^(?:AUTH-SESSION|DIRECT-CLI)-[A-Za-z0-9][A-Za-z0-9_-]{15,127}$"
+    },
+    "sequence_range": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["first", "last"],
+      "description": "Inclusive per-session sequence bounds. Segments of one session are contiguous and non-overlapping.",
+      "properties": {
+        "first": {
+          "type": "integer",
+          "minimum": 1
+        },
+        "last": {
+          "type": "integer",
+          "minimum": 1
+        }
+      }
+    },
+    "event_ids": {
+      "type": "array",
+      "minItems": 1,
+      "uniqueItems": true,
+      "items": {
+        "type": "string",
+        "pattern": "^GEV-[0-9a-f]{16}$"
+      },
+      "description": "Every event in the segment, in this session's recorded order."
+    },
+    "chain": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "previous_segment_digest_sha256",
+        "first_event_digest_sha256",
+        "last_event_digest_sha256"
+      ],
+      "properties": {
+        "previous_segment_digest_sha256": {
+          "oneOf": [
+            {
+              "$ref": "#/$defs/sha256"
+            },
+            {
+              "type": "null"
+            }
+          ]
+        },
+        "first_event_digest_sha256": {
+          "$ref": "#/$defs/sha256"
+        },
+        "last_event_digest_sha256": {
+          "$ref": "#/$defs/sha256"
+        }
+      }
+    },
+    "sealed_at": {
+      "type": "string",
+      "format": "date-time"
+    },
+    "seal_reason": {
+      "enum": ["checkpoint", "round_close", "tracking_disabled", "recovery"]
+    },
+    "segment_digest_sha256": {
+      "$ref": "#/$defs/sha256",
+      "description": "Canonical digest over every field of this segment except segment_digest_sha256 itself."
+    }
+  },
+  "$defs": {
+    "sha256": {
+      "type": "string",
+      "pattern": "^[0-9a-f]{64}$"
+    }
+  },
+  "schema_version": "1.0.0",
+  "examples": [
+    {
+      "schemaVersion": "1.0.0",
+      "segment_id": "GSEG-a1b2c3d4e5f60718",
+      "repository_id": "devai",
+      "round_id": "R-0042",
+      "authority_session_id": "AUTH-SESSION-0f1e2d3c4b5a69788796",
+      "sequence_range": {
+        "first": 1,
+        "last": 3
+      },
+      "event_ids": ["GEV-3f2a91c40b7d5e68", "GEV-77c1a0e5b3d29f14", "GEV-0b9d4e6a2f8c1357"],
+      "chain": {
+        "previous_segment_digest_sha256": null,
+        "first_event_digest_sha256": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08",
+        "last_event_digest_sha256": "2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae"
+      },
+      "sealed_at": "2026-08-27T12:05:00.000Z",
+      "seal_reason": "checkpoint",
+      "segment_digest_sha256": "486ea46224d1bb4fb680f34f7c9ad96a8f24ec88be73ea8e5a6c65260e9cb8a7"
+    }
+  ]
+}
diff --git a/law/schemas/governance-event.schema.json b/law/schemas/governance-event.schema.json
new file mode 100644
index 00000000..2331f94e
--- /dev/null
+++ b/law/schemas/governance-event.schema.json
@@ -0,0 +1,239 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://devai.nyxk.com.br/schemas/governance-event.schema.json",
+  "title": "Governance event",
+  "description": "One canonical, locally recorded governed finding or mediated action. Events are append-only and correction-by-supersession only, per Constitution Article 41. Recording is local-first and never depends on any remote projection; a projection acknowledgement can never alter event bytes.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schemaVersion",
+    "event_id",
+    "repository_id",
+    "round_id",
+    "authority_session_id",
+    "session_source",
+    "role",
+    "session_sequence",
+    "previous_event_digest_sha256",
+    "kind",
+    "recorded_at",
+    "coverage",
+    "public_safe_summary",
+    "payload_digest_sha256"
+  ],
+  "properties": {
+    "schemaVersion": {
+      "const": "1.0.0"
+    },
+    "event_id": {
+      "type": "string",
+      "pattern": "^GEV-[0-9a-f]{16}$",
+      "description": "Content-derived identity. Computed as canonical SHA-256 over every field of this event except event_id itself, truncated to 16 hex characters."
+    },
+    "repository_id": {
+      "type": "string",
+      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
+    },
+    "round_id": {
+      "type": "string",
+      "pattern": "^R-[0-9]{4,}$"
+    },
+    "task_id": {
+      "type": ["string", "null"],
+      "pattern": "^TASK-",
+      "description": "Null when the event is not bound to one task (round-level events)."
+    },
+    "authority_session_id": {
+      "type": "string",
+      "pattern": "^(?:AUTH-SESSION|DIRECT-CLI)-[A-Za-z0-9][A-Za-z0-9_-]{15,127}$",
+      "description": "Chain identity. An AUTH-SESSION- value is a real, validated authority session. A DIRECT-CLI- value is a deterministic chain identity for direct invocations that declared a role but no session; it is derived, never minted per invocation, and is always labelled as such by session_source."
+    },
+    "role": {
+      "enum": ["owner", "architect", "inspector", "engineer", "auditor"]
+    },
+    "session_sequence": {
+      "type": "integer",
+      "minimum": 1,
+      "description": "Per-authority-session monotonic sequence. Ordering is per session only; DEVAI never fabricates a global order across independent worktrees or disconnected hosts."
+    },
+    "previous_event_digest_sha256": {
+      "oneOf": [
+        {
+          "$ref": "#/$defs/sha256"
+        },
+        {
+          "type": "null"
+        }
+      ],
+      "description": "Digest of the preceding event in this session's chain; null for the first event of the session."
+    },
+    "kind": {
+      "enum": [
+        "session_opened",
+        "finding_emitted",
+        "finding_classified",
+        "authorization_recorded",
+        "action_intended",
+        "action_completed",
+        "verification_result",
+        "divergence_detected",
+        "failure_observed",
+        "evidence_superseded",
+        "round_verdict",
+        "tracking_disabled"
+      ]
+    },
+    "recorded_at": {
+      "type": "string",
+      "format": "date-time"
+    },
+    "status": {
+      "enum": ["pass", "review", "fail", "inconclusive", "not_applicable"],
+      "description": "Outcome when the event kind carries one. Article 39: inconclusive is recorded rather than resolved into false precision."
+    },
+    "commit_binding": {
+      "type": ["object", "null"],
+      "additionalProperties": false,
+      "required": ["base_commit", "base_tree"],
+      "description": "Exact base and candidate identity, present only when the event kind is bound to a tree.",
+      "properties": {
+        "base_commit": {
+          "$ref": "#/$defs/git_object"
+        },
+        "base_tree": {
+          "$ref": "#/$defs/git_object"
+        },
+        "candidate_commit": {
+          "oneOf": [
+            {
+              "$ref": "#/$defs/git_object"
+            },
+            {
+              "type": "null"
+            }
+          ]
+        },
+        "candidate_tree": {
+          "oneOf": [
+            {
+              "$ref": "#/$defs/git_object"
+            },
+            {
+              "type": "null"
+            }
+          ]
+        }
+      }
+    },
+    "coverage": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["mediated"],
+      "description": "Article 6 host-boundary disclosure. DEVAI reports the boundary rather than implying control it does not possess.",
+      "properties": {
+        "mediated": {
+          "type": "boolean",
+          "description": "True only for registered runtime actions and declared host-adapter events. Arbitrary editor or shell activity outside DEVAI is never covered and is never recorded as mediated."
+        },
+        "adapter_id": {
+          "type": ["string", "null"],
+          "minLength": 1
+        },
+        "uncovered_reason": {
+          "type": ["string", "null"],
+          "minLength": 1
+        }
+      }
+    },
+    "public_safe_summary": {
+      "type": "string",
+      "minLength": 1,
+      "maxLength": 512,
+      "description": "Redacted, disclosure-profile-validated summary. Never contains raw prompts, command output, tokens, environment values, signing material, or sensitive paths."
+    },
+    "evidence_refs": {
+      "type": "array",
+      "items": {
+        "type": "string",
+        "pattern": "^(?:EV|TXE|RGR|REL)-"
+      },
+      "description": "References to existing hash-chained evidence records. References only; payload bytes are never inlined."
+    },
+    "payload_digest_sha256": {
+      "$ref": "#/$defs/sha256",
+      "description": "Digest of the full local payload this event summarizes. Published in place of withheld content so a projection stays verifiable without disclosing it."
+    },
+    "supersedes_event_id": {
+      "type": ["string", "null"],
+      "pattern": "^GEV-[0-9a-f]{16}$",
+      "description": "Set only on evidence_superseded events. Correction is a new appended record; the superseded event is never edited or removed."
+    },
+    "session_source": {
+      "enum": ["session-state", "direct-cli"],
+      "description": "Provenance of the chain identity. Article 39: a direct-CLI chain is reported as what it is rather than presented as an authority session it never was."
+    }
+  },
+  "allOf": [
+    {
+      "if": {
+        "properties": {
+          "kind": {
+            "const": "evidence_superseded"
+          }
+        },
+        "required": ["kind"]
+      },
+      "then": {
+        "properties": {
+          "supersedes_event_id": {
+            "type": "string"
+          }
+        },
+        "required": ["supersedes_event_id"]
+      },
+      "else": {
+        "properties": {
+          "supersedes_event_id": {
+            "type": "null"
+          }
+        }
+      }
+    }
+  ],
+  "$defs": {
+    "sha256": {
+      "type": "string",
+      "pattern": "^[0-9a-f]{64}$"
+    },
+    "git_object": {
+      "type": "string",
+      "pattern": "^[0-9a-f]{40}$"
+    }
+  },
+  "schema_version": "1.0.0",
+  "examples": [
+    {
+      "schemaVersion": "1.0.0",
+      "event_id": "GEV-3f2a91c40b7d5e68",
+      "repository_id": "devai",
+      "round_id": "R-0042",
+      "task_id": null,
+      "authority_session_id": "AUTH-SESSION-0f1e2d3c4b5a69788796",
+      "session_source": "session-state",
+      "role": "owner",
+      "session_sequence": 1,
+      "previous_event_digest_sha256": null,
+      "kind": "session_opened",
+      "recorded_at": "2026-08-27T12:00:00.000Z",
+      "coverage": {
+        "mediated": true,
+        "adapter_id": null,
+        "uncovered_reason": null
+      },
+      "public_safe_summary": "Owner authority session opened for round R-0042.",
+      "evidence_refs": [],
+      "payload_digest_sha256": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08",
+      "supersedes_event_id": null
+    }
+  ]
+}
diff --git a/law/schemas/governance-projection-batch.schema.json b/law/schemas/governance-projection-batch.schema.json
new file mode 100644
index 00000000..54656d44
--- /dev/null
+++ b/law/schemas/governance-projection-batch.schema.json
@@ -0,0 +1,238 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://devai.nyxk.com.br/schemas/governance-projection-batch.schema.json",
+  "title": "Governance projection batch",
+  "description": "One public-safe, lossless batch of sealed governance events queued for output-only projection to a governed round's GitHub Issue. A batch names every event it covers by content-derived ID and preserves each session's recorded order; it never reorders across sessions and never fabricates a global order. Projection is rebuildable: the same outbox projected twice yields the same remote state.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schemaVersion",
+    "batch_id",
+    "repository_id",
+    "round_id",
+    "adapter",
+    "disclosure_profile",
+    "reason",
+    "sessions",
+    "event_ids",
+    "entries",
+    "segment_digests_sha256",
+    "batch_digest_sha256"
+  ],
+  "properties": {
+    "schemaVersion": {
+      "const": "1.0.0"
+    },
+    "batch_id": {
+      "type": "string",
+      "pattern": "^GBAT-[0-9a-f]{16}$"
+    },
+    "marker": {
+      "type": "string",
+      "pattern": "^devai-governance-batch:[0-9a-f]{16}$",
+      "description": "Stable hidden identity marker searched for before posting. Finding it is proof the batch already landed; it is what makes a retry after an ambiguous response idempotent instead of duplicating."
+    },
+    "repository_id": {
+      "type": "string",
+      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
+    },
+    "round_id": {
+      "type": "string",
+      "pattern": "^R-[0-9]{4,}$"
+    },
+    "adapter": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["id", "adapter_version", "package_version"],
+      "properties": {
+        "id": {
+          "const": "github-issues"
+        },
+        "adapter_version": {
+          "$ref": "#/$defs/semver"
+        },
+        "package_version": {
+          "$ref": "#/$defs/semver"
+        }
+      }
+    },
+    "disclosure_profile": {
+      "const": "public-safe-v1"
+    },
+    "reason": {
+      "enum": ["checkpoint", "round_close", "tracking_disabled", "reconciliation"]
+    },
+    "sessions": {
+      "type": "array",
+      "minItems": 1,
+      "description": "Per-session ordering preserved by the batch. Independent worktrees and disconnected hosts each keep their own chain.",
+      "items": {
+        "type": "object",
+        "additionalProperties": false,
+        "required": ["authority_session_id", "first", "last"],
+        "properties": {
+          "authority_session_id": {
+            "type": "string",
+            "pattern": "^(?:AUTH-SESSION|DIRECT-CLI)-[A-Za-z0-9][A-Za-z0-9_-]{15,127}$"
+          },
+          "first": {
+            "type": "integer",
+            "minimum": 1
+          },
+          "last": {
+            "type": "integer",
+            "minimum": 1
+          }
+        }
+      }
+    },
+    "event_ids": {
+      "type": "array",
+      "minItems": 1,
+      "uniqueItems": true,
+      "items": {
+        "type": "string",
+        "pattern": "^GEV-[0-9a-f]{16}$"
+      },
+      "description": "Every canonical event this batch projects, exactly once. Losslessness is checked against this list by ID, never by rendered text."
+    },
+    "entries": {
+      "type": "array",
+      "minItems": 1,
+      "description": "Rendered public-safe rows, one per event_id, in the same order.",
+      "items": {
+        "type": "object",
+        "additionalProperties": false,
+        "required": ["event_id", "role", "kind", "public_safe_summary", "payload_digest_sha256"],
+        "properties": {
+          "event_id": {
+            "type": "string",
+            "pattern": "^GEV-[0-9a-f]{16}$"
+          },
+          "role": {
+            "enum": ["owner", "architect", "inspector", "engineer", "auditor"]
+          },
+          "kind": {
+            "type": "string",
+            "minLength": 1
+          },
+          "status": {
+            "type": ["string", "null"],
+            "enum": ["pass", "review", "fail", "inconclusive", "not_applicable", null]
+          },
+          "public_safe_summary": {
+            "type": "string",
+            "minLength": 1,
+            "maxLength": 512
+          },
+          "commit": {
+            "oneOf": [
+              {
+                "$ref": "#/$defs/git_object"
+              },
+              {
+                "type": "null"
+              }
+            ]
+          },
+          "tree": {
+            "oneOf": [
+              {
+                "$ref": "#/$defs/git_object"
+              },
+              {
+                "type": "null"
+              }
+            ]
+          },
+          "evidence_digests_sha256": {
+            "type": "array",
+            "items": {
+              "$ref": "#/$defs/sha256"
+            }
+          },
+          "payload_digest_sha256": {
+            "$ref": "#/$defs/sha256",
+            "description": "Published in place of withheld payload text so the projection remains verifiable without disclosing content."
+          },
+          "mediated": {
+            "type": "boolean"
+          }
+        }
+      }
+    },
+    "segment_digests_sha256": {
+      "type": "array",
