+                "target_kinds": {
+                  "type": "array",
+                  "minItems": 1,
+                  "uniqueItems": true,
+                  "items": {
+                    "enum": [
+                      "fs",
+                      "git-ref",
+                      "db",
+                      "remote",
+                      "artifact-sink",
+                      "protected-certification-provider",
+                      "certification-evidence-sink",
+                      "protected-export-signer"
+                    ]
+                  }
+                },
+                "bounds": {
+                  "type": "object",
+                  "additionalProperties": false,
+                  "required": ["max_batches", "max_targets_per_batch", "max_total_targets"],
+                  "properties": {
+                    "max_batches": {
+                      "type": "integer",
+                      "minimum": 1,
+                      "maximum": 10000
+                    },
+                    "max_targets_per_batch": {
+                      "type": "integer",
+                      "minimum": 1,
+                      "maximum": 10000
+                    },
+                    "max_total_targets": {
+                      "type": "integer",
+                      "minimum": 1,
+                      "maximum": 100000
+                    }
+                  }
+                },
+                "recovery": {
+                  "const": "preserve-and-report"
+                }
+              }
+            }
+          ]
+        },
+        "boundary": {
+          "oneOf": [
+            {
+              "type": "object",
+              "additionalProperties": false,
+              "required": ["kind"],
+              "properties": {
+                "kind": {
+                  "const": "none"
+                }
+              }
+            },
+            {
+              "type": "object",
+              "additionalProperties": false,
+              "required": ["kind", "adapter_ids", "final_reverification"],
+              "properties": {
+                "kind": {
+                  "const": "mutation-adapters"
+                },
+                "adapter_ids": {
+                  "type": "array",
+                  "minItems": 1,
+                  "uniqueItems": true,
+                  "items": {
+                    "type": "string",
+                    "minLength": 1
+                  }
+                },
+                "final_reverification": {
+                  "const": true
+                }
+              }
+            }
+          ]
+        },
+        "readiness": {
+          "type": "object",
+          "additionalProperties": false,
+          "required": ["requires_binding", "independent_acceptance_required"],
+          "properties": {
+            "requires_binding": {
+              "type": "boolean"
+            },
+            "independent_acceptance_required": {
+              "const": true
+            }
+          }
+        }
+      },
+      "allOf": [
+        {
+          "if": {
+            "properties": {
+              "effect": {
+                "const": "read"
+              }
+            },
+            "required": ["effect"]
+          },
+          "then": {
+            "properties": {
+              "subject": {
+                "properties": {
+                  "kind": {
+                    "const": "none"
+                  }
+                }
+              },
+              "consent": {
+                "properties": {
+                  "write": {
+                    "const": false
+                  },
+                  "allow_publish": {
+                    "const": false
+                  }
+                }
+              },
+              "planner": {
+                "properties": {
+                  "kind": {
+                    "const": "none"
+                  }
+                }
+              },
+              "boundary": {
+                "properties": {
+                  "kind": {
+                    "const": "none"
+                  }
+                }
+              },
+              "readiness": {
+                "properties": {
+                  "requires_binding": {
+                    "const": false
+                  }
+                }
+              }
+            }
+          },
+          "else": {
+            "properties": {
+              "subject": {
+                "not": {
+                  "properties": {
+                    "kind": {
+                      "const": "none"
+                    }
+                  },
+                  "required": ["kind"]
+                }
+              },
+              "consent": {
+                "properties": {
+                  "write": {
+                    "const": true
+                  }
+                }
+              },
+              "planner": {
+                "not": {
+                  "properties": {
+                    "kind": {
+                      "const": "none"
+                    }
+                  },
+                  "required": ["kind"]
+                }
+              },
+              "boundary": {
+                "not": {
+                  "properties": {
+                    "kind": {
+                      "const": "none"
+                    }
+                  },
+                  "required": ["kind"]
+                }
+              },
+              "readiness": {
+                "properties": {
+                  "requires_binding": {
+                    "const": true
+                  }
+                }
+              }
+            }
+          }
+        },
+        {
+          "if": {
+            "properties": {
+              "effect": {
+                "const": "remote-write"
+              }
+            },
+            "required": ["effect"]
+          },
+          "then": {
+            "properties": {
+              "consent": {
+                "properties": {
+                  "allow_publish": {
+                    "const": true
+                  }
+                }
+              }
+            }
+          }
+        }
+      ]
+    }
+  },
+  "examples": [{}]
+}
diff --git a/law/schemas/action-result.schema.json b/law/schemas/action-result.schema.json
new file mode 100644
index 00000000..d126b5dd
--- /dev/null
+++ b/law/schemas/action-result.schema.json
@@ -0,0 +1,117 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://devai.nyxk.com.br/schemas/action-result.schema.json",
+  "title": "DEVAI action result",
+  "description": "Closed action-bound machine envelope for one successful result or one structured error. Human presentation is outside this contract.",
+  "schema_version": "1.0.0",
+  "type": "object",
+  "additionalProperties": false,
+  "required": ["schemaVersion", "action_id", "ok"],
+  "properties": {
+    "schemaVersion": {
+      "const": "1.0.0"
+    },
+    "action_id": {
+      "type": "string",
+      "pattern": "^[a-z0-9][a-z0-9_-]*( [a-z0-9][a-z0-9_-]*)*$"
+    },
+    "ok": {
+      "type": "boolean"
+    },
+    "result": {
+      "$ref": "#/$defs/result"
+    },
+    "error": {
+      "$ref": "error.schema.json"
+    }
+  },
+  "oneOf": [
+    {
+      "required": ["result"],
+      "properties": {
+        "ok": {
+          "const": true
+        }
+      },
+      "not": {
+        "required": ["error"]
+      }
+    },
+    {
+      "required": ["error"],
+      "properties": {
+        "ok": {
+          "const": false
+        }
+      },
+      "not": {
+        "required": ["result"]
+      }
+    }
+  ],
+  "$defs": {
+    "result": {
+      "description": "A closed transport frame. JSON payload semantics remain governed by the action's payload schema when one is declared.",
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["verdict", "media_type", "value"],
+      "properties": {
+        "verdict": {
+          "enum": ["pass", "review"]
+        },
+        "media_type": {
+          "enum": ["application/json", "text/plain", "none"]
+        },
+        "value": {}
+      },
+      "allOf": [
+        {
+          "if": {
+            "properties": {
+              "media_type": {
+                "const": "text/plain"
+              }
+            },
+            "required": ["media_type"]
+          },
+          "then": {
+            "properties": {
+              "value": {
+                "type": "string"
+              }
+            }
+          }
+        },
+        {
+          "if": {
+            "properties": {
+              "media_type": {
+                "const": "none"
+              }
+            },
+            "required": ["media_type"]
+          },
+          "then": {
+            "properties": {
+              "value": {
+                "type": "null"
+              }
+            }
+          }
+        }
+      ]
+    }
+  },
+  "examples": [
+    {
+      "schemaVersion": "1.0.0",
+      "action_id": "catalog actions",
+      "ok": true,
+      "result": {
+        "verdict": "pass",
+        "media_type": "application/json",
+        "value": []
+      }
+    }
+  ]
+}
diff --git a/law/schemas/actions-list-output.schema.json b/law/schemas/actions-list-output.schema.json
new file mode 100644
