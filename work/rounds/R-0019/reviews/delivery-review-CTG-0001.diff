diff --git a/law/schemas/adr-v2.schema.json b/law/schemas/adr-v2.schema.json
new file mode 100644
index 00000000..0410f19f
--- /dev/null
+++ b/law/schemas/adr-v2.schema.json
@@ -0,0 +1,182 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://devai.nyxk.com.br/schemas/adr-v2.schema.json",
+  "title": "Architecture Decision Record v2",
+  "description": "Frontmatter contract for scoped ADR markdown under law/adr/. Identity is ADR-<SCOPE>-<NNNN> and is mandatory. Supersession is recorded forward on the superseding record only: this contract has no superseded_by field, so a superseding decision never requires editing the bytes of the record it supersedes. Frontmatter is restricted to scalars and block string arrays so the governed frontmatter reader parses it without a general YAML engine.",
+  "schema_version": "2.0.0",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "id",
+    "title",
+    "type",
+    "status",
+    "date",
+    "authority",
+    "supersedes",
+    "provenance",
+    "affected_rules",
+    "inspector_acceptance"
+  ],
+  "properties": {
+    "id": {
+      "$ref": "#/$defs/adr_v2_id",
+      "description": "Mandatory scoped identity. The one-or-more scope segments are the sole scope declaration; scope is never restated in a separate field."
+    },
+    "title": {
+      "type": "string",
+      "minLength": 1,
+      "maxLength": 200
+    },
+    "type": {
+      "const": "adr"
+    },
+    "status": {
+      "enum": ["proposed", "accepted", "rejected", "superseded"],
+      "description": "Exactly four lifecycle values. Only accepted is binding; proposed, rejected, and superseded carry no authority over the reference signal."
+    },
+    "date": {
+      "type": "string",
+      "format": "date"
+    },
+    "authority": {
+      "const": "Architect",
+      "description": "Article 6 binds law/adr to Architect authority. No other authority may author an ADR."
+    },
+    "supersedes": {
+      "type": "array",
+      "uniqueItems": true,
+      "description": "Exact identities of the records this decision supersedes. This is the sole supersession mechanism: the superseded record is never edited.",
+      "items": {
+        "$ref": "#/$defs/adr_reference"
+      }
+    },
+    "provenance": {
+      "type": "array",
+      "minItems": 1,
+      "uniqueItems": true,
+      "items": {
+        "type": "string",
+        "minLength": 1,
+        "maxLength": 500
+      }
+    },
+    "affected_rules": {
+      "type": "array",
+      "uniqueItems": true,
+      "items": {
+        "$ref": "#/$defs/affected_rule_subject"
+      }
+    },
+    "inspector_acceptance": {
+      "type": "array",
+      "uniqueItems": true,
+      "description": "Adversarial acceptance obligations the Inspector must discharge before the decision is treated as demonstrated. Each entry names one attack the contract must survive, not one happy-path assertion.",
+      "items": {
+        "type": "string",
+        "minLength": 12,
+        "maxLength": 500,
+        "pattern": "^IA-[0-9]{3} -- .+$",
+        "description": "The separator is ' -- ' rather than ': ' so the entry stays an unquoted plain scalar in frontmatter and the governed frontmatter reader returns the text without surrounding quote characters."
+      }
+    },
+    "disposition": {
+      "type": "string",
+      "minLength": 1,
+      "maxLength": 500,
+      "description": "Why a non-binding record is non-binding. Required for rejected and superseded records."
+    }
+  },
+  "allOf": [
+    {
+      "if": {
+        "properties": {
+          "status": {
+            "const": "accepted"
+          }
+        },
+        "required": ["status"]
+      },
+      "then": {
+        "properties": {
+          "inspector_acceptance": {
+            "minItems": 1
+          },
+          "affected_rules": {
+            "minItems": 1
+          }
+        },
+        "required": ["inspector_acceptance"]
+      }
+    },
+    {
+      "if": {
+        "properties": {
+          "status": {
+            "enum": ["rejected", "superseded"]
+          }
+        },
+        "required": ["status"]
+      },
+      "then": {
+        "required": ["disposition"]
+      },
+      "else": {
+        "not": {
+          "required": ["disposition"]
+        }
+      }
+    },
+    {
+      "if": {
+        "properties": {
+          "status": {
+            "const": "rejected"
+          }
+        },
+        "required": ["status"]
+      },
+      "then": {
+        "properties": {
+          "supersedes": {
+            "maxItems": 0
+          }
+        }
+      }
+    }
+  ],
+  "$defs": {
+    "adr_v2_id": {
+      "type": "string",
+      "pattern": "^ADR-[A-Z][A-Z0-9]{1,15}(?:-[A-Z][A-Z0-9]{1,15})*-[0-9]{4}$"
+    },
+    "adr_reference": {
+      "type": "string",
+      "pattern": "^(?:ADR-(?:[A-Z][A-Z0-9]{1,15}(?:-[A-Z][A-Z0-9]{1,15})*-[0-9]{4}|[0-9]{3,})|LEGACY:[A-Za-z0-9][A-Za-z0-9._-]{0,199})$",
+      "description": "A v2 scoped identity, a legacy numeric identity, or an explicitly catalogued LEGACY: identity. A LEGACY: reference resolves only through the validation policy's exact reference allowlist."
+    },
+    "affected_rule_subject": {
+      "type": "string",
+      "minLength": 1,
+      "maxLength": 200,
+      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*\\u0000)(?!.*[*?\\[\\]{}])(?:[^/\\u0000\\\\]+/)*[^/\\u0000\\\\]+$",
+      "description": "Lexically canonical repository-relative POSIX governed or review subject. It has no POSIX or Windows-drive absolute form, dot segment, repeated separator, backslash, NUL, glob, or trailing separator. Semantic resolution requires input already normalized to Unicode NFC and performs no filesystem or Git lookup."
+    }
+  },
+  "examples": [
+    {
+      "id": "ADR-GOV-0001",
+      "title": "Example scoped decision",
+      "type": "adr",
+      "status": "accepted",
+      "date": "2026-09-03",
+      "authority": "Architect",
+      "supersedes": [],
+      "provenance": ["law/constitution.md#article-9"],
+      "affected_rules": ["scripts/check-workflows.mjs"],
+      "inspector_acceptance": [
+        "IA-001 -- A record with a missing id is rejected rather than defaulted to a derived id."
+      ]
+    }
+  ]
+}
diff --git a/law/schemas/adr-validation-policy.schema.json b/law/schemas/adr-validation-policy.schema.json
new file mode 100644
index 00000000..33c088b5
--- /dev/null
+++ b/law/schemas/adr-validation-policy.schema.json
@@ -0,0 +1,1349 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://devai.nyxk.com.br/schemas/adr-validation-policy.schema.json",
+  "title": "ADR validation policy",
+  "description": "Fail-closed contract for validating every Markdown file under law/adr/. The scan is recursive and total: a file is either a conforming ADR v2 record or an exact catalogued exception, and anything else is a failure. Exceptions are pinned by exact repository-relative path and sha256, and the catalog itself is digest-bound so an entry cannot be added, removed, or repointed silently. Validation is two passes: every record is checked against the record schema, and the record set is then resolved by the named semantic resolver, which decides the effective accepted authority of each exact affected-rule subject and explicit supersession-connected lineage.",
+  "schema_version": "1.0.0",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schemaVersion",
+    "id",
+    "status",
+    "authority",
+    "policy_version",
+    "record_schema",
+    "scan",
+    "identity",
+    "lifecycle",
+    "body",
+    "supersession",
+    "semantic_resolver",
+    "exception_catalog",
+    "fail_closed"
+  ],
+  "properties": {
+    "$schema": {
+      "type": "string",
+      "minLength": 1
+    },
+    "schemaVersion": {
+      "const": "1.0.0"
+    },
+    "id": {
+      "const": "adr-validation"
+    },
+    "status": {
+      "const": "active"
+    },
+    "authority": {
+      "const": "Architect"
+    },
+    "policy_version": {
+      "$ref": "#/$defs/semver"
+    },
+    "record_schema": {
+      "const": "law/schemas/adr-v2.schema.json"
+    },
+    "scan": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "root",
+        "recursive",
+        "include",
+        "extension_match",
+        "follow_symlinks",
+        "unreadable_behavior",
+        "unmatched_file_behavior",
+        "empty_directory_behavior"
+      ],
+      "properties": {
+        "root": {
+          "const": "law/adr"
+        },
+        "recursive": {
+          "const": true,
+          "description": "Every descendant directory is scanned. A nested directory never hides a record."
+        },
+        "include": {
+          "const": ["*.md", "**/*.md"],
+          "description": "Root-level and recursively nested Markdown files are both in the census; extension matching is case-insensitive."
+        },
+        "extension_match": {
+          "const": "case-insensitive",
+          "description": "A .MD or .Md file is a Markdown file. Case is never an escape hatch from the scan."
+        },
+        "follow_symlinks": {
+          "const": false
+        },
+        "unreadable_behavior": {
+          "const": "fail",
+          "description": "Article 41: a failure to read is a failure to observe and never a pass."
+        },
+        "unmatched_file_behavior": {
+          "const": "fail",
+          "description": "A Markdown file that is neither a conforming record nor a catalogued exception fails the scan."
+        },
+        "empty_directory_behavior": {
+          "const": "pass"
+        }
+      }
+    },
+    "identity": {
