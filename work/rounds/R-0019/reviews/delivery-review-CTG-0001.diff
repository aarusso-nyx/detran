+            }
+          }
+        }
+      ]
+    },
+    "rule": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "rule_id",
+        "origin",
+        "precedence",
+        "action_ids",
+        "selector",
+        "effect",
+        "subjects",
+        "required_consent",
+        "constitutional_anchors",
