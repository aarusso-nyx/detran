+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://devai.nyxk.com.br/schemas/task-execution-evidence.schema.json",
+  "title": "Task execution evidence",
+  "description": "Candidate-bound evidence for one resolved task execution. It binds the immutable requested executor only by digest and records the distinct resolved executor, selection, versions, prompt, inputs, outputs, usage, cost, timestamps, verdict, and evidence references.",
+  "schema_version": "1.0.0",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schemaVersion",
+    "id",
+    "task_id",
+    "round_id",
+    "candidate_sha",
+    "task_record_digest_sha256",
+    "requested_executor_digest_sha256",
+    "resolved_executor",
+    "adapter_versions",
+    "tool_versions",
+    "input_digests",
+    "output_digests",
+    "selection",
+    "prompt",
+    "usage",
+    "cost",
+    "started_at",
+    "completed_at",
+    "verdict",
+    "evidence_refs"
+  ],
+  "properties": {
+    "schemaVersion": {
+      "const": "1.0.0"
+    },
+    "id": {
+      "type": "string",
+      "pattern": "^TXE-[a-f0-9]{16}$"
+    },
+    "task_id": {
+      "type": "string",
+      "pattern": "^TASK-[0-9]{4,}$"
+    },
+    "round_id": {
+      "type": "string",
+      "pattern": "^R-[0-9]{4}$"
+    },
+    "candidate_sha": {
+      "type": "string",
+      "pattern": "^[a-f0-9]{40}$"
+    },
+    "task_record_digest_sha256": {
+      "$ref": "common-defs.schema.json#/$defs/sha256"
+    },
+    "requested_executor_digest_sha256": {
+      "$ref": "common-defs.schema.json#/$defs/sha256",
+      "description": "SHA-256 of the canonical immutable task.executor object. The executor object is never copied into or mutated by this record."
+    },
+    "resolved_executor": {
+      "type": "object",
+      "additionalProperties": false,
+      "properties": {
+        "kind": {},
+        "action_id": {},
+        "argv": {},
+        "cwd": {},
+        "effects": {},
+        "registry_id": {},
+        "runtime": {},
+        "model": {},
+        "effort": {},
+        "recipe_name": {},
+        "recipe_variant": {},
+        "role": {},
+        "completion_evidence": {},
+        "child_task_ids": {},
+        "child_execution_evidence_ids": {}
+      },
+      "oneOf": [
+        {
+          "$ref": "#/$defs/resolvedRoutine",
+          "properties": {
+            "kind": {
+              "const": "routine"
+            }
+          }
+        },
+        {
+          "$ref": "#/$defs/resolvedAgent",
+          "properties": {
+            "kind": {
+              "const": "agent"
+            }
+          }
+        },
+        {
+          "$ref": "#/$defs/resolvedHuman",
+          "properties": {
+            "kind": {
+              "const": "human"
+            }
+          }
+        },
+        {
+          "$ref": "#/$defs/resolvedComposite",
+          "properties": {
+            "kind": {
+              "const": "composite"
+            }
+          }
+        }
+      ]
+    },
+    "adapter_versions": {
+      "type": "array",
+      "minItems": 1,
+      "uniqueItems": true,
+      "items": {
+        "$ref": "#/$defs/versionBinding"
+      }
+    },
+    "tool_versions": {
+      "type": "array",
+      "uniqueItems": true,
+      "items": {
+        "$ref": "#/$defs/versionBinding"
+      }
+    },
+    "input_digests": {
+      "type": "array",
