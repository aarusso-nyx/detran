+      "items": {
+        "$ref": "#/$defs/Route"
+      }
+    }
+  },
+  "required": ["schemaVersion", "generatedAt", "framework", "routes"],
+  "$defs": {
+    "Evidence": {
+      "type": "object",
+      "additionalProperties": false,
