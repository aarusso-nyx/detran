+    "started_at": {
+      "type": "string",
+      "format": "date-time"
+    },
+    "ended_at": {
+      "type": "string",
+      "format": "date-time"
+    },
+    "caller": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["kind", "name"],
+      "properties": {
+        "kind": {
+          "enum": ["recipe", "sense", "loop", "cli", "subagent"]
+        },
+        "name": {
+          "type": "string",
+          "minLength": 1
+        },
+        "version": {
+          "type": "string"
+        }
+      }
+    },
+    "files_read": {
+      "type": "array",
+      "items": {
+        "type": "string",
+        "minLength": 1
+      },
+      "description": "Repo-relative paths the agent read during the run."
+    },
+    "files_written": {
+      "type": "array",
+      "items": {
+        "type": "string",
+        "minLength": 1
+      }
+    },
+    "commands_run": {
+      "type": "array",
+      "items": {
+        "type": "object",
+        "additionalProperties": false,
+        "required": ["argv", "exit_code", "duration_ms"],
+        "properties": {
+          "argv": {
+            "type": "array",
+            "minItems": 1,
+            "items": {
+              "type": "string"
+            }
+          },
+          "exit_code": {
+            "type": "integer"
+          },
+          "duration_ms": {
+            "type": "integer",
+            "minimum": 0
+          }
+        }
+      }
+    },
+    "subagent_invocations": {
+      "type": "array",
+      "items": {
+        "type": "object",
+        "additionalProperties": false,
+        "required": ["agent_type", "prompt_pc_id"],
+        "properties": {
+          "agent_type": {
+            "type": "string"
+          },
+          "prompt_pc_id": {
+            "type": "string",
+            "pattern": "^PC-"
+          },
+          "returned_summary": {
+            "type": "string"
+          },
+          "parent_verification": {
+            "enum": ["pass", "fail", "skipped"]
+          }
+        }
+      }
+    },
+    "compliance": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["invariant_ids"],
+      "properties": {
+        "invariant_ids": {
+          "type": "array",
+          "items": {
+            "type": "string",
+            "pattern": "^INV-"
+          }
+        },
+        "overrides_in_play": {
+          "type": "array",
+          "items": {
+            "type": "string",
+            "pattern": "^OVR-"
+          }
+        }
+      }
+    },
+    "outcome": {
+      "type": "object",
+      "additionalProperties": false,
+      "properties": {
+        "status": {
+          "enum": ["pass", "fail", "review", "skipped"]
+        },
+        "notes": {
+          "type": "array",
+          "items": {
+            "type": "string"
+          }
+        }
+      }
+    },
+    "prev_hash": {
+      "type": ["string", "null"],
+      "pattern": "^([a-f0-9]{64}|GENESIS)$"
+    },
+    "manifest_hash": {
+      "type": "string",
+      "pattern": "^[a-f0-9]{64}$"
+    }
+  },
+  "schema_version": "1.0.0",
+  "examples": [
+    {
+      "schemaVersion": "1.0.0",
+      "run_id": "AR-019e384d-257c-7fde-ba4f-5ccb7243843f",
+      "started_at": "2026-05-17T23:37:20.487Z",
+      "ended_at": "2026-05-17T23:37:20.508Z",
+      "caller": {
+        "kind": "recipe",
+        "name": "devai-assess"
+      },
+      "files_read": [],
+      "files_written": [],
+      "commands_run": [],
+      "compliance": {
+        "invariant_ids": []
+      },
+      "prev_hash": "GENESIS",
+      "manifest_hash": "359ae1fb4a9fee1283e84f415630634811be616415366cffe34f7ce2da67c997"
+    }
+  ]
+}
