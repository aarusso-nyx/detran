diff --git a/law/schemas/sensor-reading.schema.json b/law/schemas/sensor-reading.schema.json
new file mode 100644
index 00000000..838e29c3
--- /dev/null
+++ b/law/schemas/sensor-reading.schema.json
@@ -0,0 +1,235 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://devai.nyxk.com.br/schemas/sensor-reading.schema.json",
+  "title": "Sensor Reading",
+  "description": "Uniform output envelope for any executable or analytical sensor. Per Constitution Article 32 (sensor adapter uniformity).",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schemaVersion",
+    "id",
+    "sensor",
+    "timestamp",
+    "status",
+    "deterministic",
+    "command",
+    "command_hash"
+  ],
+  "properties": {
+    "schemaVersion": {
+      "const": "1.0.0"
+    },
+    "lifecycle": {
+      "enum": ["supported", "experimental"],
+      "default": "supported",
+      "description": "Experimental readings are retained but excluded from supported readiness aggregation."
+    },
+    "id": {
+      "type": "string",
+      "pattern": "^SR-[a-f0-9]{16}$",
+      "description": "Machine-only content-derived ID."
+    },
+    "sensor": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["name", "kind"],
+      "properties": {
+        "name": {
+          "type": "string",
+          "minLength": 1
+        },
+        "kind": {
+          "enum": [
+            "type_check",
+            "lint",
+            "build",
+            "unit_test",
+            "integration_test",
+            "api_test",
+            "db_test",
+            "e2e_test",
+            "journey_test",
+            "migration_check",
+            "contract_validation",
+            "inventory_regeneration",
+            "test_weakening_review",
+            "trace_resolution",
+            "mutation_test",
+            "security_scan",
+            "perf_test",
+            "llm_judge",
+            "runtime_probe_api",
+            "runtime_probe_auth",
+            "runtime_probe_data",
+            "inventory_api",
+            "inventory_routes",
+            "inventory_data_model",
+            "inventory_rbac",
+            "inventory_data_handling",
+            "inventory_dep_graph",
+            "inventory_coverage",
+            "spec_depth",
+            "spec_idiomaticity",
+            "spec_freshness",
+            "plant_coverage",
+            "test_coverage_depth",
+            "test_invariant_alignment",
+            "inventory_adherence",
+            "inventory_determinism",
+            "harness_security",
+            "harness_green_main",
+            "spec_alignment",
+            "spec_security_coverage",
+            "spec_performance_targets",
+            "spec_robustness_targets",
+            "plant_depth",
+            "plant_coherence",
+            "test_coherence",
+            "test_idiomaticity",
+            "test_security_coverage",
+            "test_performance_coverage",
+            "test_robustness_coverage",
+            "harness_coverage",
+            "harness_depth",
+            "harness_coherence",
+            "harness_invariant_alignment",
+            "harness_idiomaticity",
+            "harness_performance",
+            "harness_robustness",
+            "inventory_performance",
+            "docs_drift",
+            "site_drift",
+            "action_effect_inference"
+          ]
+        },
+        "version": {
+          "type": "string"
+        }
+      }
+    },
+    "timestamp": {
+      "type": "string",
+      "format": "date-time"
+    },
+    "duration_ms": {
+      "type": "integer",
+      "minimum": 0
+    },
+    "tier": {
+      "enum": ["L0", "L1", "L2", "semantic"],
+      "description": "Sensor latency and scope tier. L0 is static module-local feedback; L1 is dynamic layer-local behavior; L2 is cross-layer integrity; semantic covers system-wide semantic confidence. The optional tier lets progressive checks select the appropriate readings."
+    },
+    "status": {
+      "enum": ["pass", "fail", "review", "skipped", "killed", "error", "unknown"],
+      "description": "Tri-state plus operational states. 'killed' = timeout exceeded; 'error' = sensor itself failed; 'unknown' = explicit uncertainty (Article 39)."
+    },
+    "deterministic": {
+      "type": "boolean",
+      "description": "True if the sensor produces identical output for identical input. Stochastic sensors require retry-and-vote handling and a confidence field."
+    },
+    "command": {
+      "type": "string",
+      "minLength": 1
+    },
+    "command_hash": {
+      "type": "string",
+      "pattern": "^[a-f0-9]{64}$",
+      "description": "SHA-256 of the canonical command for drift detection."
+    },
+    "exit_code": {
+      "type": ["integer", "null"]
+    },
+    "evidence_path": {
+      "type": ["string", "null"],
+      "description": "Path under .devai/evidence/ where full output is retained."
+    },
+    "out_head": {
+      "type": "string",
+      "maxLength": 4096
+    },
+    "err_head": {
+      "type": "string",
+      "maxLength": 4096
+    },
+    "killed": {
+      "type": "boolean",
+      "description": "True if the sensor was terminated due to timeout exceeded."
+    },
+    "findings": {
+      "type": "array",
+      "items": {
+        "type": "object",
+        "additionalProperties": false,
+        "required": ["severity", "code", "message"],
+        "properties": {
+          "severity": {
+            "enum": ["info", "warning", "error", "critical"]
+          },
+          "code": {
+            "type": "string",
+            "minLength": 1
+          },
+          "message": {
+            "type": "string",
+            "minLength": 1
+          },
+          "file": {
+            "type": "string"
+          },
+          "line": {
+            "type": "integer",
+            "minimum": 1
+          },
+          "invariant_id": {
+            "type": "string",
+            "pattern": "^INV-"
+          }
+        }
+      }
+    },
+    "metrics": {
+      "type": "object",
+      "additionalProperties": {
+        "type": ["number", "string", "boolean"]
+      },
+      "description": "Sensor-specific metrics (test count, coverage %, score, etc.)."
+    },
+    "confidence": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "Required for stochastic sensors; optional for deterministic.",
+      "properties": {
+        "score": {
+          "type": "number",
+          "minimum": 0,
+          "maximum": 1
+        },
+        "interval_low": {
+          "type": "number"
+        },
+        "interval_high": {
+          "type": "number"
+        },
+        "method": {
+          "type": "string"
+        }
+      }
+    }
+  },
+  "schema_version": "1.0.0",
+  "examples": [
+    {
+      "schemaVersion": "1.0.0",
+      "id": "SR-89f7974460e256a3",
+      "sensor": {
+        "name": "build",
+        "kind": "build"
+      },
+      "timestamp": "2026-07-14T23:48:45.669Z",
+      "status": "pass",
+      "deterministic": true,
+      "command": "pnpm run build",
+      "command_hash": "ce4dccceab6682814be8785fab6f7cc4c874a7a03ce125006766123b57dee5c8"
+    }
+  ]
+}
diff --git a/law/schemas/sensor-registry.schema.json b/law/schemas/sensor-registry.schema.json
new file mode 100644
index 00000000..9fb0600e
--- /dev/null
+++ b/law/schemas/sensor-registry.schema.json
@@ -0,0 +1,196 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://devai.nyxk.com.br/schemas/sensor-registry.schema.json",
+  "title": "DEVAI sensor registry",
+  "description": "The single schema-backed registry of current emitter-backed sensor kinds, scorecard reachability, execution tiers, and design-note state.",
+  "schema_version": "1.0.0",
+  "type": "object",
+  "additionalProperties": false,
+  "required": ["schemaVersion", "id", "entries"],
+  "properties": {
+    "schemaVersion": {
+      "const": "1.0.0"
+    },
+    "id": {
+      "const": "sensor-registry"
+    },
+    "entries": {
+      "type": "array",
+      "minItems": 1,
+      "uniqueItems": true,
+      "items": {
+        "$ref": "#/$defs/entry"
+      }
+    }
+  },
+  "$defs": {
+    "entry": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "id",
+        "title",
+        "type",
+        "status",
+        "date",
+        "authority",
+        "kind",
+        "emitter_module",
+        "effect",
+        "tiers",
+        "design_note"
+      ],
+      "properties": {
+        "id": {
+          "type": "string",
+          "pattern": "^[a-z][a-z0-9_]*$"
+        },
+        "title": {
+          "type": "string",
+          "minLength": 1
+        },
+        "type": {
+          "const": "sensor-registry-entry"
+        },
+        "status": {
+          "const": "active"
+        },
+        "date": {
+          "type": "string",
+          "format": "date"
+        },
+        "authority": {
+          "const": "Architect"
+        },
+        "kind": {
+          "type": "string",
+          "pattern": "^[a-z][a-z0-9_]*$"
+        },
+        "emitter_module": {
+          "type": "string",
+          "pattern": "^packages/[A-Za-z0-9._/-]+\\.ts$"
+        },
+        "effect": {
+          "enum": ["read", "harness-write", "local-write", "remote-write"],
+          "description": "Maximum intrinsic effect of executing this sensor kind without implicit reading persistence. Generic sense-run persistence is separately forbidden by the preset policy."
+        },
+        "effect_basis": {
+          "type": "object",
+          "additionalProperties": false,
+          "required": ["capabilities", "source_paths", "rationale"],
+          "properties": {
+            "capabilities": {
+              "type": "array",
+              "minItems": 1,
+              "uniqueItems": true,
+              "items": {
+                "type": "string",
+                "pattern": "^(fs:(f5-config|f5-state|f4-inventory|proofs|worktree-admin|workspace|unknown-write)|db:(read|write|unclassified)|host-cache:write|proc:[a-z0-9._-]+|net:[a-z0-9._-]+)$"
+              }
+            },
+            "source_paths": {
+              "type": "array",
+              "minItems": 1,
+              "uniqueItems": true,
+              "items": {
+                "type": "string",
+                "pattern": "^(packages|law)/[A-Za-z0-9._/-]+$"
+              }
+            },
+            "rationale": {
+              "type": "string",
+              "minLength": 20
+            }
+          }
+        },
+        "cells": {
+          "type": "array",
+          "minItems": 1,
+          "uniqueItems": true,
+          "items": {
+            "type": "object",
+            "additionalProperties": false,
+            "required": ["substrate", "property"],
+            "properties": {
+              "substrate": {
+                "$ref": "common-defs.schema.json#/$defs/substrate"
+              },
+              "property": {
+                "$ref": "common-defs.schema.json#/$defs/transversal"
+              }
+            }
+          }
+        },
+        "diagnostic": {
+          "const": true
+        },
+        "tiers": {
+          "type": "array",
+          "minItems": 1,
+          "uniqueItems": true,
+          "contains": {
+            "const": "SWEEP"
+          },
+          "items": {
+            "enum": ["BASELINE", "TIER2", "TIER3", "SWEEP"]
+          }
+        },
+        "design_note": {
+          "$ref": "#/$defs/designNote"
+        }
+      },
+      "oneOf": [
+        {
+          "required": ["cells"],
+          "not": {
+            "required": ["diagnostic"]
+          }
+        },
+        {
+          "required": ["diagnostic"],
+          "not": {
+            "required": ["cells"]
+          }
+        }
+      ],
+      "allOf": [
+        {
+          "if": {
+            "required": ["effect"],
+            "properties": {
+              "effect": {
+                "not": {
+                  "const": "read"
+                }
+              }
+            }
+          },
+          "then": {
+            "required": ["effect_basis"]
+          },
+          "else": {
+            "not": {
+              "required": ["effect_basis"]
+            }
+          }
+        }
+      ]
+    },
+    "designNote": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["state", "path"],
+      "properties": {
+        "state": {
+          "const": "active"
+        },
+        "path": {
+          "type": "string",
+          "pattern": "^law/policy/sensor-notes/[a-z][a-z0-9_]*\\.md$",
+          "minLength": 1
+        }
+      }
+    }
+  },
+  "examples": [{}]
+}
diff --git a/law/schemas/subprocess-effects.schema.json b/law/schemas/subprocess-effects.schema.json
new file mode 100644
index 00000000..2c28015d
--- /dev/null
+++ b/law/schemas/subprocess-effects.schema.json
@@ -0,0 +1,147 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://devai.nyxk.com.br/schemas/subprocess-effects.schema.json",
+  "title": "Subprocess Effects Registry",
+  "description": "Architect-authored classification of statically extracted subprocess command templates. This is the complete trusted annotation surface for effects that cross the in-program analysis boundary.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": ["schemaVersion", "id", "source_authority", "materialization", "templates"],
+  "properties": {
+    "schemaVersion": {
+      "const": "1.0.0"
+    },
+    "id": {
+      "const": "subprocess-effects"
+    },
+    "source_authority": {
+      "const": "F1-architect"
+    },
+    "materialization": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "target",
+        "allowed_verbs",
+        "authority_and_consent_required",
+        "byte_identity_required",
+        "adopter_binding_path_required",
+        "direct_writes_forbidden"
+      ],
+      "properties": {
+        "target": {
+          "const": ".devai/config/subprocess-effects.json"
+        },
+        "allowed_verbs": {
+          "const": ["devai init bind"]
+        },
+        "authority_and_consent_required": {
+          "const": true
+        },
+        "byte_identity_required": {
+          "const": true
+        },
+        "adopter_binding_path_required": {
+          "const": true
+        },
+        "direct_writes_forbidden": {
+          "const": true
+        }
+      }
+    },
+    "templates": {
+      "type": "array",
+      "uniqueItems": true,
+      "items": {
+        "type": "object",
+        "additionalProperties": false,
+        "required": [
+          "template_id",
+          "executable",
+          "argv_shape",
+          "capabilities",
+          "effect",
+          "reason",
+          "owner"
+        ],
+        "properties": {
+          "template_id": {
+            "type": "string",
+            "pattern": "^[a-z][a-z0-9-]*$"
+          },
+          "executable": {
+            "type": "string",
+            "pattern": "^[a-zA-Z0-9._+-]+$"
+          },
+          "argv_shape": {
+            "type": "array",
+            "minItems": 1,
+            "items": {
+              "type": "string",
+              "minLength": 1
+            }
+          },
+          "capabilities": {
+            "type": "array",
+            "minItems": 1,
+            "uniqueItems": true,
+            "items": {
+              "oneOf": [
+                {
+                  "enum": [
+                    "fs:f5-config",
+                    "fs:f5-state",
+                    "fs:f4-inventory",
+                    "fs:proofs",
+                    "fs:worktree-admin",
+                    "fs:workspace",
+                    "fs:unknown-write",
+                    "db:read",
+                    "db:write",
+                    "db:unclassified",
+                    "host-cache:write"
+                  ]
+                },
+                {
+                  "type": "string",
+                  "pattern": "^proc:[a-z][a-z0-9-]*$"
+                },
+                {
+                  "type": "string",
+                  "pattern": "^net:[a-z][a-z0-9-]*$"
+                }
+              ]
+            }
+          },
+          "effect": {
+            "enum": ["read", "harness-write", "local-write", "remote-write"],
+            "description": "Derived public consent summary retained for a mechanical capabilities-to-effect consistency check."
+          },
+          "reason": {
+            "type": "string",
+            "minLength": 1
+          },
+          "owner": {
+            "const": "architect"
+          }
+        }
+      }
+    }
+  },
+  "schema_version": "1.0.0",
+  "examples": [
+    {
+      "schemaVersion": "1.0.0",
+      "id": "subprocess-effects",
+      "source_authority": "F1-architect",
+      "materialization": {
+        "target": ".devai/config/subprocess-effects.json",
+        "allowed_verbs": ["devai init bind"],
+        "authority_and_consent_required": true,
+        "byte_identity_required": true,
+        "adopter_binding_path_required": true,
+        "direct_writes_forbidden": true
+      },
+      "templates": []
+    }
+  ]
+}
diff --git a/law/schemas/task-execution-evidence.schema.json b/law/schemas/task-execution-evidence.schema.json
