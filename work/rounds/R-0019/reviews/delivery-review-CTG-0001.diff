+      ],
+      "properties": {
+        "rule_id": {
+          "type": "string",
+          "pattern": "^[a-z][a-z0-9._-]{2,127}$"
+        },
+        "origin": {
+          "enum": ["immutable-core", "additive-extension"]
+        },
+        "precedence": {
