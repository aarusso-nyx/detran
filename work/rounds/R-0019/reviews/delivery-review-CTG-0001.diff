+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://devai.nyxk.com.br/schemas/release-publication-receipt.schema.json",
+  "title": "Signed release publication receipt",
+  "description": "The signed attestation emitted by the protected external workflow after a dispatched publication completes. No DEVAI action emits it. It binds the exact publication_dispatched state it answers, the exact candidate and artifacts that were published, the exact workflow identity that observed the publication, and the exact trust identity that signed it. release resume may derive the observation-only state published from it, and only when every one of those bindings matches the recorded dispatch. The receipt grants no authority: it is evidence that a publication happened, never permission for one, and it is never appended as a state record. Every digest it carries is computed under one frozen canonicalization kernel in one computable order, so no digest is an input to itself.",
+  "$comment": "The embedded example signature is verified only with the external fixture devai-publication-receipt-example-trust-fixture-v1, identified by trust_root_id, trust_store_digest_sha256, and key_id. Its signed-payload, receipt-id, and whole-receipt digests remain exact without embedding key material.",
+  "schema_version": "1.1.0",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schemaVersion",
+    "receipt_kind",
+    "canonicalization",
+    "receipt_id",
+    "attests_state",
+    "outcome",
+    "repository",
+    "candidate",
+    "dispatched_state",
+    "artifacts",
+    "publication",
+    "workflow",
+    "trust",
+    "emitted_by",
+    "grants",
+    "emitted_at",
+    "receipt_digest_sha256"
+  ],
+  "properties": {
+    "schemaVersion": {
+      "enum": ["1.0.0", "1.1.0"],
+      "description": "Version 1.0.0 retains the legacy path artifact projection. Version 1.1.0 binds the current opaque sink-handle projection emitted by a v2.1 lifecycle state. The two projections never mix within one receipt."
+    },
+    "receipt_kind": {
+      "const": "release-publication-receipt"
+    },
+    "canonicalization": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "kernel_id",
+        "encoding",
+        "json_form",
+        "digest_algorithm",
+        "signed_payload_projection_excludes",
+        "whole_receipt_projection_excludes",
+        "calculation_order"
+      ],
+      "description": "The frozen projection and calculation order every digest in this receipt is computed under. The two projections are nested rather than mutual: the signed payload excludes all three derived fields, and the whole-receipt projection excludes only the field being computed. No digest in this receipt is an input to itself.",
+      "properties": {
+        "kernel_id": {
+          "const": "devai.kernel.publication-receipt-canonicalization.v1",
+          "description": "Named canonicalization kernel. A receipt computed under any other kernel is a different document and does not verify."
+        },
+        "encoding": {
+          "const": "utf-8"
+        },
+        "json_form": {
+          "const": "rfc8785-jcs",
+          "description": "RFC 8785 JSON Canonicalization Scheme: lexicographic member ordering, no insignificant whitespace, canonical number and string escaping."
+        },
+        "digest_algorithm": {
+          "const": "sha256"
+        },
+        "signed_payload_projection_excludes": {
+          "const": [
+            "receipt_id",
+            "trust.signature",
+            "trust.signed_payload_digest_sha256",
+            "receipt_digest_sha256"
+          ],
+          "description": "The signed payload omits every derived field, including the identity derived from it. Signing a payload that contained receipt_id or its own digest would be circular."
+        },
+        "whole_receipt_projection_excludes": {
+          "const": ["receipt_digest_sha256"],
+          "description": "The whole-receipt projection omits only the field being computed. receipt_id, trust.signed_payload_digest_sha256, and trust.signature are all present in it, so the receipt digest covers the identity and the signature."
+        },
+        "calculation_order": {
+          "type": "array",
+          "minItems": 4,
+          "maxItems": 4,
+          "items": false,
+          "description": "The four steps in the only order in which they are computable. Each step consumes only values fixed by an earlier step.",
+          "prefixItems": [
+            {
+              "const": "compute-signed-payload-digest-sha256-over-the-signed-payload-projection"
+            },
+            {
+              "const": "derive-receipt-id-as-RPU-hyphen-plus-the-first-16-lowercase-hex-characters-of-the-signed-payload-digest"
+            },
+            {
+              "const": "sign-the-signed-payload-digest-into-trust-signature"
+            },
+            {
+              "const": "compute-receipt-digest-sha256-over-the-whole-receipt-projection"
+            }
+          ]
+        }
+      }
+    },
+    "receipt_id": {
+      "type": "string",
+      "pattern": "^RPU-[0-9a-f]{16}$",
+      "description": "Content-derived identity: RPU- followed by the first 16 lowercase hex characters of trust.signed_payload_digest_sha256. It is derived from the signed payload digest and is never an input to it."
+    },
+    "attests_state": {
+      "type": ["string", "null"],
+      "enum": [null, "published"],
+      "description": "The derived state this receipt attests. Null when the publication did not complete. An attestation is not a state record and is never appended."
+    },
+    "outcome": {
+      "enum": ["published", "failed"]
+    },
+    "repository": {
+      "$ref": "#/$defs/repository"
+    },
+    "candidate": {
+      "$ref": "#/$defs/candidate"
+    },
+    "dispatched_state": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["state", "state_id", "record_digest_sha256"],
+      "description": "The exact publication_dispatched record this receipt answers. A receipt naming a different dispatch derives nothing about this one.",
+      "properties": {
+        "state": {
+          "const": "publication_dispatched"
+        },
+        "state_id": {
+          "type": "string",
+          "pattern": "^RLS-[0-9a-f]{16}$"
+        },
+        "record_digest_sha256": {
+          "$ref": "#/$defs/sha256"
+        }
+      }
+    },
+    "artifacts": {
+      "type": "array",
+      "minItems": 1,
+      "uniqueItems": true,
+      "description": "The exact artifacts the workflow observed published, pinned by content digest. Version 1.0.0 uses the legacy path projection; version 1.1.0 uses the current opaque sink-handle projection. A digest or sink identity that differs from the dispatched artifact is a different artifact."
+    },
+    "publication": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["system_id", "exact_identifier", "operation"],
+      "description": "Exactly one publication target. Identifiers are literal: no glob, no prefix match, no default remainder.",
+      "properties": {
+        "system_id": {
+          "type": "string",
+          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$"
+        },
+        "exact_identifier": {
+          "type": "string",
+          "minLength": 1,
+          "maxLength": 500,
+          "pattern": "^(?!.*[*?\\[\\]])[^\\u0000]+$"
+        },
+        "operation": {
+          "const": "publish"
+        }
+      }
+    },
+    "workflow": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "repository",
+        "workflow_path",
+        "workflow_sha",
+        "protected_environment",
+        "run_id",
+        "run_attempt",
+        "protected",
+        "candidate_product_execution"
+      ],
+      "description": "Exact identity of the protected workflow that observed the publication. An unprotected or unidentified workflow attests nothing.",
+      "properties": {
+        "repository": {
+          "type": "string",
+          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$"
+        },
+        "workflow_path": {
+          "$ref": "#/$defs/relative_path"
+        },
+        "workflow_sha": {
+          "$ref": "#/$defs/git_object",
+          "description": "The immutable commit the workflow ran from. A branch or tag name would let the attested logic change under a stable label."
+        },
+        "protected_environment": {
+          "type": "string",
+          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
+        },
+        "run_id": {
+          "type": "string",
+          "pattern": "^[0-9]{1,32}$"
+        },
+        "run_attempt": {
+          "type": "integer",
+          "minimum": 1
+        },
+        "protected": {
+          "const": true
+        },
+        "candidate_product_execution": {
+          "const": false,
+          "description": "The workflow observes the publication; it never executes the candidate product to decide the outcome."
+        }
+      }
+    },
+    "trust": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "trust_root_id",
+        "trust_store_digest_sha256",
+        "key_id",
+        "signature_algorithm",
+        "signature",
+        "signed_payload_digest_sha256"
+      ],
+      "description": "Exact signing identity. Signature validity is necessary and never sufficient: a validly signed receipt for a different dispatch, candidate, or artifact is a statement about something else.",
+      "properties": {
+        "trust_root_id": {
+          "type": "string",
+          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$"
+        },
+        "trust_store_digest_sha256": {
+          "$ref": "#/$defs/sha256",
+          "description": "Digest of the exact external public trust store expected by the recorded dispatch; no key material is embedded."
+        },
+        "key_id": {
+          "type": "string",
+          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
+        },
+        "signature_algorithm": {
+          "enum": ["ed25519", "ecdsa-p256-sha256", "rsa-pss-sha256"]
+        },
+        "signature": {
+          "type": "string",
+          "minLength": 1,
+          "maxLength": 4096,
+          "pattern": "^[A-Za-z0-9+/]+={0,2}$",
+          "description": "Base64 signature over the exact bytes of trust.signed_payload_digest_sha256. The signature covers the payload digest, never the receipt digest."
+        },
+        "signed_payload_digest_sha256": {
+          "$ref": "#/$defs/sha256",
+          "description": "Canonical sha256 over the signed payload projection: this receipt with receipt_id, trust.signature, trust.signed_payload_digest_sha256, and receipt_digest_sha256 omitted. receipt_id is derived from this value."
+        }
+      }
+    },
+    "emitted_by": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["emitter", "devai_action_id", "emitted_by_devai_action"],
+      "properties": {
+        "emitter": {
+          "const": "protected-external-workflow"
+        },
+        "devai_action_id": {
+          "type": "null",
+          "description": "No DEVAI action emits this receipt. A receipt claiming a DEVAI emitter is self-attestation, which the separation exists to prevent."
+        },
+        "emitted_by_devai_action": {
+          "const": false
+        }
+      }
+    },
+    "grants": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "authority",
+        "publication_authority",
+        "lifecycle_transition",
+        "appended_as_state_record"
+      ],
+      "properties": {
+        "authority": {
+          "const": false
+        },
+        "publication_authority": {
+          "const": false,
+          "description": "Evidence that a publication happened never authorizes another one."
+        },
+        "lifecycle_transition": {
+          "const": false
+        },
+        "appended_as_state_record": {
