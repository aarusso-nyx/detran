+{
+  "schemaVersion": "1.0.0",
+  "roles": [
+    "Recepção",
+    "Técnico Biométrico",
+    "Candidato/condutor",
+    "Junta Médica ou Psicológica",
+    "Médico (exame médico) ou Psicólogo (exame psicológico)",
+    "Médico, Psicólogo ou Supervisor",
+    "Profissional autorizado",
+    "O sistema",
+    "Médico (ou Psicólogo, quando aplicável)",
+    "SENATRAN/RENACH",
+    "Adaptador SENATRAN",
+    "PEC",
+    "Operador de integração",
+    "Sistema",
+    "Gestor DETRAN (ou DPO, em conformidade LGPD)"
+  ],
+  "cases": [
+    {
+      "id": "UC-PEC-001",
+      "title": "Abrir processo RENACH e agendar exame",
+      "goal": "Recepção (ou o processo já aberto pelo DETRAN/AM) liga o candidato/condutor a um processo RENACH e agenda o atendimento na clínica credenciada, dando início à trilha clínica que o PEC controla. Origem: UCAP-UC-01 (\"Abrir Processo de Habilitação no RENACH\") + SUC-UC-08 (\"Criar agendamento\").",
+      "actors": ["Recepção"],
+      "mainFlow": [
+        {
+          "id": "UC-PEC-001-001",
+          "action": "Recepção consulta/abre o processo RENACH para o paciente: `POST /integrations/renach/processes`."
+        },
+        {
+          "id": "UC-PEC-001-002",
+          "action": "O adaptador RENACH retorna `renachProcessKey`, `status` (`OPENED`|`ALREADY_OPEN`) e um `requestId`."
+        },
+        {
+          "id": "UC-PEC-001-003",
+          "action": "O PEC grava `renach_process_key` em `pec.encounters` (ou o mantém disponível para quando o encounter for aberto) — unicidade garantida por `(tenant_id, patient_id, renach_process_key)`."
+        },
+        {
+          "id": "UC-PEC-001-004",
+          "action": "Recepção cria o agendamento: `POST /appointments` — estado inicial `SCHEDULED` — ver WF-PEC-003."
+        },
+        {
+          "id": "UC-PEC-001-005",
+          "action": "Consultas de identidade complementares (`findDriverByCpf` etc.) podem retornar indicadores de negócio (`requiresMedical`, `requiresPsychological`, `requiresBiometrics`, `requiresPaymentClearance`) que orientam quais etapas subsequentes são necessárias."
+        }
+      ]
+    },
+    {
+      "id": "UC-PEC-002",
+      "title": "Abrir atendimento clínico (encounter)",
+      "goal": "Recepção abre o encounter clínico que servirá de guarda-chuva para o exame médico e/ou psicológico do paciente, formalizando o início do episódio. Origem: SUC-UC-10.",
+      "actors": ["Recepção"],
+      "mainFlow": [
+        {
+          "id": "UC-PEC-002-001",
+          "action": "Recepção chama `POST /encounters` com o `patientId` (e opcionalmente `appointmentId`)."
+        },
+        {
+          "id": "UC-PEC-002-002",
+          "action": "Sistema valida que existe um agendamento `CHECKED_IN` associado; se não houver `appointmentId` explícito, busca o agendamento `CHECKED_IN` mais recente do paciente."
+        },
+        {
+          "id": "UC-PEC-002-003",
+          "action": "Encounter é criado com `status='OPEN'`."
+        },
+        {
+          "id": "UC-PEC-002-004",
+          "action": "Se o agendamento vinculado ainda não estava `CHECKED_IN`, o sistema o atualiza para esse status como efeito colateral."
+        },
+        {
+          "id": "UC-PEC-002-005",
+          "action": "A partir daqui, o encounter segue o ciclo de vida de WF-PEC-001."
+        }
+      ]
+    },
+    {
+      "id": "UC-PEC-003",
+      "title": "Tratar exceção de biometria",
+      "goal": "Técnico Biométrico registra a falha de captura biométrica e solicita ao Supervisor uma liberação temporária controlada, sem comprometer a rastreabilidade do processo. Origem: UCAP-UC-04 (\"Tratar Exceções de Biometria\"), MAN-CASO-07 (\"Aprovar exceção biométrica\"). Ver JRN-PEC-003 para a narrativa completa.",
+      "actors": ["Técnico Biométrico"],
+      "mainFlow": [
+        {
+          "id": "UC-PEC-003-001",
+          "action": "Técnico Biométrico registra a falha e a justificativa."
+        },
+        {
+          "id": "UC-PEC-003-002",
+          "action": "Anexa evidências (documentais) sujeitas a dupla checagem."
+        },
+        {
+          "id": "UC-PEC-003-003",
+          "action": "Solicita a exceção ao Supervisor."
+        },
+        {
+          "id": "UC-PEC-003-004",
+          "action": "Supervisor aprova → sistema concede liberação temporária controlada com prazo/escopo limitados (`pec.biometric_exceptions.expires_at`)."
+        },
+        {
+          "id": "UC-PEC-003-005",
+          "action": "Trilha de auditoria reforçada é gravada (falha, justificativa, aprovação, liberação), vinculando ID biométrico, IP/estação e hash."
+        }
+      ]
+    },
+    {
