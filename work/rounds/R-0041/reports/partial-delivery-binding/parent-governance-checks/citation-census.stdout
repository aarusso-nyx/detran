    {
      "path": "law/schemas/release-lifecycle-policy.schema.json",
      "sha256": "b35e294aa7563447d2323a3ee33e7be229a7c5616d430ff386b3f784a2157946",
      "jsonPointer": "/$defs/plan_determination/const/prerelease_ladder/description",
      "location": "value",
      "originalString": "Prerelease channel ladder declared by ADR-REL-0028. A prerelease identifier takes the semver 2.0 dot form <rung>.<n> with n a non-negative integer without leading zeros, for example 1.6.0-alpha.1; any other prerelease identifier blocks with invalid-semver precedence and is never defaulted to a rung. The kernel identifier stays devai.kernel.release-plan-determination.v3 because this section adds a rung table and a dist-tag map without altering any existing transition, block condition, capability selection, or receipt semantics: stable transitions and the existing v1.5.0-rc.1 lineage resolve exactly as before.",
      "reference": "ADR-REL-0028",
      "occurrenceIndex": 0,
      "stringOffset": 38,
      "context": {
        "mode": "data-keyword-value",
        "observedKeywords": [
          "$defs",
          "const"
        ],
        "ancestorSegments": [
          "$defs",
          "plan_determination",
          "const",
          "prerelease_ladder"
        ]
      }
    },
    {
