      "jsonPointer": "/properties/proof_sha256/description",
      "location": "value",
      "originalString": "ADR-EVI-0002 anchor: the SHA-256 of the anchored line bytes, exclusive of the terminating newline.",
      "reference": "ADR-EVI-0002",
