    {
      "path": "law/schemas/experimental-activation.schema.json",
      "sha256": "07113176ac50f51668c980893ca9f619037266178d1568a98be08b2c5472e9a7",
      "jsonPointer": "/description",
      "location": "value",
      "originalString": "Owner-authored, expiring activation, written only by the Owner-only `round dispatch activate` action to .devai/state/experimental/activation.json (ADR-MDL-0006), of experimental agent execution in one adopter repository (ADR-MDL-0005 D-1). It names the exact runtimes, models, efforts, disciplines, and budgets an invocation of `round dispatch --write --experimental` may use. Values never exceed law/policy/experimental-execution.json; the expiry is at most that policy's max_validity_days after issued_at, which the runtime checks.",
      "reference": "ADR-MDL-0005",
      "occurrenceIndex": 1,
      "stringOffset": 221,
      "context": {
        "mode": "annotation-value",
        "observedKeywords": [
