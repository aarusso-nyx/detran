    {
      "path": "law/schemas/release-intent.schema.json",
      "sha256": "a7802916ff50c554d8932a33b9822ec8ce5c0f0dc4652a0ef4a51f542a549911",
      "jsonPointer": "/properties/channel/description",
      "location": "value",
      "originalString": "Optional prerelease channel derived from target_version under the lifecycle policy prerelease ladder (ADR-REL-0028): the rung named by the prerelease identifier, or stable when there is none. The kernel blocks when the declared channel disagrees with the version string.",
      "reference": "ADR-REL-0028",
      "occurrenceIndex": 0,
      "stringOffset": 102,
