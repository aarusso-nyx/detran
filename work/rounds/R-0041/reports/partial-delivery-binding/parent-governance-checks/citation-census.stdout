    {
      "path": "law/schemas/evidence.schema.json",
      "sha256": "591886e0bd2cd23775de825d82270e30f10f742461d68abc98554db39bc5e173",
      "jsonPointer": "/properties/proof_path/description",
      "location": "value",
      "originalString": "ADR-EVI-0002 anchor: the canonical repository-relative path of the proof epoch file that holds the anchored line (forward slashes, no dot segment). Optional so that historical entries, which carry the anchor only in notes, stay valid.",
      "reference": "ADR-EVI-0002",
      "occurrenceIndex": 0,
      "stringOffset": 0,
      "context": {
