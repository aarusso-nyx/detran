    {
      "path": "law/schemas/forbidden-actions.schema.json",
      "sha256": "5e9d41a9d0c4321a94f8a3fde5a2a091a0793744c11fc396af898dc217515bd7",
      "jsonPointer": "/properties/actions/items/properties/maintenance_exemptions/description",
      "location": "value",
      "originalString": "Optional registry-maintenance exemptions for this action (ADR-GOV-0022). Each item names one governed file whose validated, append-only change is maintenance rather than a mutation. A commit changes that path as maintenance only when the resulting file validates against the named schema and the change is append-only: every member of the parent version of the collection is present in the child version with identical bytes and in the same order, the child appends zero or more members after them, and every other root member of the file is unchanged. Both versions are read from the commit trees, never from the working tree. For a maintenance change the scanner omits the path from the operation lines it matches for this action in every inspection pass, both the name-status pass that synthesizes git add and git rm lines and the patch pass. Any other change to the path, every other path in the same commit, and a commit-message match keep their findings.",
      "reference": "ADR-GOV-0022",
      "occurrenceIndex": 0,
      "stringOffset": 58,
      "context": {
        "mode": "annotation-value",
        "observedKeywords": [
          "properties",
