    },
    {
      "path": "law/schemas/test-task-exclusivity.schema.json",
      "sha256": "da8c63d7cd1f492fdb98321a53f7bc7b1817daac7a39539c7a693043dc4aed80",
      "jsonPointer": "/properties/nodes/description",
      "location": "value",
      "originalString": "Declarations keyed by descriptor nodeId. An empty declaration `{}` holds no key and conflicts only through the implicit rules of ADR-CHK-0007.",
      "reference": "ADR-CHK-0007",
      "occurrenceIndex": 0,
      "stringOffset": 129,
      "context": {
