          "items",
          "properties",
          "sensorKinds"
        ]
      }
    },
    {
      "path": "law/schemas/test-task-exclusivity.schema.json",
      "sha256": "da8c63d7cd1f492fdb98321a53f7bc7b1817daac7a39539c7a693043dc4aed80",
      "jsonPointer": "/description",
      "location": "value",
      "originalString": "Shared-state declarations the check runner reads to schedule plan nodes in parallel (ADR-CHK-0007). The file is `test-task-exclusivity.json` beside `test-tasks.json`, separate from the descriptor so that the descriptor bytes, the descriptor digest, and the package-owned evidence verifier's descriptor validation stay unchanged (ADR-CHK-0006). `exclusive` names state a node mutates; `shared` names state it only reads. Two declared nodes conflict when either holds exclusively a key the other holds in either list. A descriptor node with no entry here conflicts with every node; an absent file declares no node, so every plan runs one node at a time. An entry naming a node the descriptor does not declare is refused. The package-owned verifier never reads the file as a declaration; where a task's input selectors match it (a `**` glob), it is hashed as an ordinary tracked input, consistently by the runner and the verifier.",
      "reference": "ADR-CHK-0007",
      "occurrenceIndex": 0,
      "stringOffset": 85,
      "context": {
        "mode": "annotation-value",
        "observedKeywords": [
          "description"
        ],
        "ancestorSegments": []
      }
    },
    {
      "path": "law/schemas/test-task-exclusivity.schema.json",
      "sha256": "da8c63d7cd1f492fdb98321a53f7bc7b1817daac7a39539c7a693043dc4aed80",
      "jsonPointer": "/description",
      "location": "value",
      "originalString": "Shared-state declarations the check runner reads to schedule plan nodes in parallel (ADR-CHK-0007). The file is `test-task-exclusivity.json` beside `test-tasks.json`, separate from the descriptor so that the descriptor bytes, the descriptor digest, and the package-owned evidence verifier's descriptor validation stay unchanged (ADR-CHK-0006). `exclusive` names state a node mutates; `shared` names state it only reads. Two declared nodes conflict when either holds exclusively a key the other holds in either list. A descriptor node with no entry here conflicts with every node; an absent file declares no node, so every plan runs one node at a time. An entry naming a node the descriptor does not declare is refused. The package-owned verifier never reads the file as a declaration; where a task's input selectors match it (a `**` glob), it is hashed as an ordinary tracked input, consistently by the runner and the verifier.",
      "reference": "ADR-CHK-0006",
      "occurrenceIndex": 1,
      "stringOffset": 329,
      "context": {
        "mode": "annotation-value",
        "observedKeywords": [
          "description"
        ],
        "ancestorSegments": []
