    {
      "path": "law/schemas/campaign.schema.json",
      "sha256": "23d38995312663cb486a1af7ce3b5818c6c198c4caf1fe50fc0c1c0f5b992747",
      "jsonPointer": "/$defs/task/properties/execution/properties/resolved/description",
      "location": "value",
      "originalString": "The tier map this task resolved at task_start: the default of law/policy/model-tiers.json merged with the campaign override, every alias in the runtime:model registry id form, with the default policy_version (ADR-MDL-0002). Absent until the task starts. A later change to the default or to the override never reinterprets this task; Article 19 escalation climbs this map.",
      "reference": "ADR-MDL-0002",
      "occurrenceIndex": 0,
      "stringOffset": 209,
      "context": {
        "mode": "annotation-value",
        "observedKeywords": [
          "$defs",
          "properties",
          "properties",
          "description"
        ],
        "ancestorSegments": [
          "$defs",
          "task",
