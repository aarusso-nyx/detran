          "properties",
          "argv_precedence"
        ]
      }
    },
    {
      "path": "law/schemas/task-execution-evidence.schema.json",
      "sha256": "a20e30bb09cf14bc0cb237c65acfb0532e708f6148e80a87ac7de73dcae2aac0",
      "jsonPointer": "/$defs/costUnknown/description",
      "location": "value",
      "originalString": "The provider did not report a cost; it is unknown, never 0 (ADR-MDL-0005 D-7).",
      "reference": "ADR-MDL-0005",
      "occurrenceIndex": 0,
      "stringOffset": 60,
      "context": {
        "mode": "annotation-value",
        "observedKeywords": [
          "$defs",
          "description"
        ],
        "ancestorSegments": [
