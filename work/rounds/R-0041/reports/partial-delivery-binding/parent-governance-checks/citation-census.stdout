    {
      "path": "law/schemas/task.schema.json",
      "sha256": "906286acd8b7660e5a185b16d08b9bd46effbf851655a45d6bbcf99a3f956c35",
      "jsonPointer": "/$defs/agentExecutor/properties/instructions_ref/description",
      "location": "value",
      "originalString": "Repository-relative task instructions, such as a campaign task prompt (ADR-MDL-0009). When present, its bytes are a hashed task-layer component of the composed prompt, so editing it changes the prompt composition id.",
      "reference": "ADR-MDL-0009",
      "occurrenceIndex": 0,
      "stringOffset": 71,
      "context": {
