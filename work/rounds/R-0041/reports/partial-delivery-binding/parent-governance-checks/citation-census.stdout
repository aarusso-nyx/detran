      }
    },
    {
      "path": "law/schemas/coverage-matrix.schema.json",
      "sha256": "30b4dfacc9bfc53a87e7d440308690c769621feb9fada651ce0d732d5d3a8143",
      "jsonPointer": "/properties/endpoints/description",
      "location": "value",
      "originalString": "Complete unique endpoint observation identities from the API population. Distinct source variants sharing method/path remain distinct. A legacy METHOD path reference resolves only to exactly one endpoint; ambiguity earns no endpoint coverage (ADR-SCR-0016).",
      "reference": "ADR-SCR-0016",
      "occurrenceIndex": 0,
