        ]
      }
    },
    {
      "path": "law/schemas/test-result-population.schema.json",
      "sha256": "51c5574d1d0c662e23917999ee463d2ecd2bdd08e63e7e14ac93011a6d637926",
      "jsonPointer": "/description",
      "location": "value",
      "originalString": "Opt-in outputContract.resultPopulation under command-result. Standing requires host-verified execution origin, package-owned native collection and complete final results from the same execution, agreeing with expected IDs and selected source census. Results-only and authored rosters prove no selection. Node TAP remains diagnostic UNKNOWN without complete native provenance (ADR-SCR-0017).",
      "reference": "ADR-SCR-0017",
      "occurrenceIndex": 0,
      "stringOffset": 376,
      "context": {
        "mode": "annotation-value",
        "observedKeywords": [
          "description"
        ],
        "ancestorSegments": []
      }
    },
    {
      "path": "law/schemas/test-result-population.schema.json",
      "sha256": "51c5574d1d0c662e23917999ee463d2ecd2bdd08e63e7e14ac93011a6d637926",
      "jsonPointer": "/properties/serviceProfile/description",
      "location": "value",
      "originalString": "Optional finite owned service request (ADR-SCR-0020). Missing/candidate backend records or an unimplemented backend/profile refuse before provisioning. Declaration alone grants no effect, endpoint, execution origin or standing.",
      "reference": "ADR-SCR-0020",
      "occurrenceIndex": 0,
      "stringOffset": 39,
      "context": {
        "mode": "annotation-value",
        "observedKeywords": [
          "properties",
          "description"
        ],
        "ancestorSegments": [
          "properties",
          "serviceProfile"
        ]
      }
    },
    {
      "path": "law/schemas/test-task-descriptor.schema.json",
      "sha256": "677e24b51f27d34888b9130503374c634171653f49eb17ccca9801d777c9b59a",
      "jsonPointer": "/$defs/selector/description",
      "location": "value",
      "originalString": "Input selector. exact compares the whole path, prefix a leading substring, glob the check-runner glob grammar. class selects every path the change-taxonomy binding assigns to the named class (ADR-GOV-0017); its pattern is restricted to the closed class enum of law/schemas/change-taxonomy.schema.json.",
      "reference": "ADR-GOV-0017",
      "occurrenceIndex": 0,
      "stringOffset": 192,
      "context": {
        "mode": "annotation-value",
        "observedKeywords": [
          "$defs",
          "description"
        ],
        "ancestorSegments": [
          "$defs",
          "selector"
        ]
      }
    },
    {
      "path": "law/schemas/test-task-descriptor.schema.json",
      "sha256": "677e24b51f27d34888b9130503374c634171653f49eb17ccca9801d777c9b59a",
      "jsonPointer": "/description",
      "location": "value",
      "originalString": "Adopter-owned test task DAG. Every node names a runner; a node under any runner except `preflight-v1` declares an `argv` contract, while a `preflight-v1` node declares a `probes` array of preflight probe objects (preflight-probe.schema.json, ADR-CHK-0001) and carries no argv. A task outcome is one of five values: PASS, FAIL, SKIPPED, CACHED, and BLOCKED. BLOCKED is the outcome of a preflight node whose extrinsic probe did not pass; its dependents are marked blocked-environment and not executed, and no BLOCKED result is ever written as a reusable cache entry. An intrinsic probe mismatch is FAIL, as for any other node. The descriptor and each task are closed objects: an unknown or misspelled property is refused. Scheduling declarations for parallel execution live in the separate test-task-exclusivity.json (test-task-exclusivity.schema.json, ADR-CHK-0007), never here, so the package-owned evidence verifier keeps reading the descriptor unchanged (ADR-CHK-0006).",
      "reference": "ADR-CHK-0001",
      "occurrenceIndex": 0,
      "stringOffset": 242,
      "context": {
        "mode": "annotation-value",
        "observedKeywords": [
          "description"
        ],
        "ancestorSegments": []
      }
    },
    {
      "path": "law/schemas/test-task-descriptor.schema.json",
      "sha256": "677e24b51f27d34888b9130503374c634171653f49eb17ccca9801d777c9b59a",
      "jsonPointer": "/description",
      "location": "value",
      "originalString": "Adopter-owned test task DAG. Every node names a runner; a node under any runner except `preflight-v1` declares an `argv` contract, while a `preflight-v1` node declares a `probes` array of preflight probe objects (preflight-probe.schema.json, ADR-CHK-0001) and carries no argv. A task outcome is one of five values: PASS, FAIL, SKIPPED, CACHED, and BLOCKED. BLOCKED is the outcome of a preflight node whose extrinsic probe did not pass; its dependents are marked blocked-environment and not executed, and no BLOCKED result is ever written as a reusable cache entry. An intrinsic probe mismatch is FAIL, as for any other node. The descriptor and each task are closed objects: an unknown or misspelled property is refused. Scheduling declarations for parallel execution live in the separate test-task-exclusivity.json (test-task-exclusivity.schema.json, ADR-CHK-0007), never here, so the package-owned evidence verifier keeps reading the descriptor unchanged (ADR-CHK-0006).",
      "reference": "ADR-CHK-0007",
      "occurrenceIndex": 1,
      "stringOffset": 851,
      "context": {
        "mode": "annotation-value",
        "observedKeywords": [
          "description"
        ],
        "ancestorSegments": []
      }
    },
    {
      "path": "law/schemas/test-task-descriptor.schema.json",
      "sha256": "677e24b51f27d34888b9130503374c634171653f49eb17ccca9801d777c9b59a",
      "jsonPointer": "/description",
      "location": "value",
      "originalString": "Adopter-owned test task DAG. Every node names a runner; a node under any runner except `preflight-v1` declares an `argv` contract, while a `preflight-v1` node declares a `probes` array of preflight probe objects (preflight-probe.schema.json, ADR-CHK-0001) and carries no argv. A task outcome is one of five values: PASS, FAIL, SKIPPED, CACHED, and BLOCKED. BLOCKED is the outcome of a preflight node whose extrinsic probe did not pass; its dependents are marked blocked-environment and not executed, and no BLOCKED result is ever written as a reusable cache entry. An intrinsic probe mismatch is FAIL, as for any other node. The descriptor and each task are closed objects: an unknown or misspelled property is refused. Scheduling declarations for parallel execution live in the separate test-task-exclusivity.json (test-task-exclusivity.schema.json, ADR-CHK-0007), never here, so the package-owned evidence verifier keeps reading the descriptor unchanged (ADR-CHK-0006).",
      "reference": "ADR-CHK-0006",
      "occurrenceIndex": 2,
      "stringOffset": 957,
      "context": {
        "mode": "annotation-value",
        "observedKeywords": [
