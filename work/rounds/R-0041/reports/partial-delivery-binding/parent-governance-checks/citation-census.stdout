          "description"
        ],
        "ancestorSegments": [
          "properties",
          "actions",
          "items",
          "properties",
          "maintenance_exemptions"
        ]
      }
    },
    {
      "path": "law/schemas/github-issues-tracking-policy.schema.json",
      "sha256": "1e19af70fe9ac5b6e55c761afd7acdb65868739b19f4df1487dfa9c0c733530f",
      "jsonPointer": "/properties/defaults/properties/backlog_projection/description",
      "location": "value",
      "originalString": "ADR-GOV-0019 extension: projection of repository backlog items into the governed round's issue. It reuses the Owner activation and the public-safe disclosure profile of the round; it has no activation, profile, or authority of its own, and a backlog item with no explicit round attribution is never projected.",
      "reference": "ADR-GOV-0019",
      "occurrenceIndex": 0,
      "stringOffset": 0,
