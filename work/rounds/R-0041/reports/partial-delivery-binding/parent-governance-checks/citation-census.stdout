          "costUnknown"
        ]
      }
    },
    {
      "path": "law/schemas/task-execution-evidence.schema.json",
      "sha256": "a20e30bb09cf14bc0cb237c65acfb0532e708f6148e80a87ac7de73dcae2aac0",
      "jsonPointer": "/$defs/sandboxEvidence/description",
      "location": "value",
      "originalString": "The write confinement the provider's own sandbox enforced for one experimental agent attempt whose provider process started (ADR-MDL-0008); an attempt refused or failed before any provider process ran records none. flags is the exact confinement subsequence the broker asserted in the spawned argv, with the attempt worktree's path written as {attempt-worktree}.",
      "reference": "ADR-MDL-0008",
      "occurrenceIndex": 0,
      "stringOffset": 125,
      "context": {
        "mode": "annotation-value",
        "observedKeywords": [
          "$defs",
          "description"
        ],
        "ancestorSegments": [
          "$defs",
          "sandboxEvidence"
        ]
      }
    },
    {
      "path": "law/schemas/task-execution-evidence.schema.json",
      "sha256": "a20e30bb09cf14bc0cb237c65acfb0532e708f6148e80a87ac7de73dcae2aac0",
      "jsonPointer": "/$defs/usageCounter/description",
      "location": "value",
      "originalString": "One provider usage counter. A counter the provider did not report is missing with a null value; it is never zero (ADR-MDL-0005 D-7).",
      "reference": "ADR-MDL-0005",
      "occurrenceIndex": 0,
      "stringOffset": 114,
      "context": {
