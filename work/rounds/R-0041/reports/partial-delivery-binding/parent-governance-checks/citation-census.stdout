          "kind"
        ]
      }
    },
    {
      "path": "law/schemas/sensor-reading.schema.json",
      "sha256": "bdf104d7739623c09acf4c1e2531afc527779ebd7905831d7ea0b641e7c6f7c8",
      "jsonPointer": "/properties/sensor/properties/kind/description",
      "location": "value",
      "originalString": "Closed set of admitted sensor kinds. Every kind a sense preset can select is admitted here (ADR-SCR-0011); a registry entry the schema intentionally does not admit is refused before the sensor runs and never emitted as a reading. Five values name no registry entry and are kept as legacy so recorded readings under them stay valid (ADR-SCR-0008): api_test, contract_validation, db_test, journey_test, mutation_test.",
