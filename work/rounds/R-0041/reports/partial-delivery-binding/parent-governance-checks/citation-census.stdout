          "0"
        ]
      }
    },
    {
      "path": "law/schemas/subprocess-effects.schema.json",
      "sha256": "9c75db1312b5b18b443d5d6d46387a984dbeb963af953ba43697adbfaa9e1f91",
      "jsonPointer": "/properties/templates/items/properties/argv_precedence/description",
      "location": "value",
      "originalString": "Ordered sources of the concrete argv a sensor executes under this template, highest precedence first (ADR-AUT-0002). A template without this field takes its argv from its emitter alone. The field declares which source wins; it never widens the shape the broker admits, which stays argv_shape.",
      "reference": "ADR-AUT-0002",
      "occurrenceIndex": 0,
      "stringOffset": 102,
      "context": {
        "mode": "annotation-value",
        "observedKeywords": [
          "properties",
