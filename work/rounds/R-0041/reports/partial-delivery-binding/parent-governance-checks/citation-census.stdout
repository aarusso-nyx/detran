    },
    {
      "path": "law/schemas/test-task-descriptor.schema.json",
      "sha256": "677e24b51f27d34888b9130503374c634171653f49eb17ccca9801d777c9b59a",
      "jsonPointer": "/properties/tasks/items/properties/sensorKinds/description",
      "location": "value",
      "originalString": "Explicit sensor consumers admitted to reference this exact executable node by taskId (ADR-SCR-0015); a probe-only preflight-v1 node is not a sensor execution. Omitting the field admits no sensor task reference. It does not grant effects, widen environment, or alter ordinary check/RC execution.",
      "reference": "ADR-SCR-0015",
      "occurrenceIndex": 0,
      "stringOffset": 86,
      "context": {
        "mode": "annotation-value",
        "observedKeywords": [
          "properties",
          "items",
          "properties",
          "description"
        ],
        "ancestorSegments": [
          "properties",
