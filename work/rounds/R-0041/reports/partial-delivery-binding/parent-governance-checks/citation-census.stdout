    {
      "path": "law/schemas/proof-orphan-declaration.schema.json",
      "sha256": "e27d43971c0165255512c1c386b4fa7aa2f782211eab2643ff0c6e102e8146d2",
      "jsonPointer": "/description",
      "location": "value",
      "originalString": "The payload of a historical declaration proof line of kind `historical-gap` under ADR-EVI-0002. The line is appended through `evidence record`, is itself directly anchored in the chain with a digest, names each orphaned proof line by canonical path, sequence, and line digest, carries the Architect's authorization as the declaring decision, and applies only to lines whose baseline entry was observed at the first verification, at the cutoff; a line observed after the cutoff is rejected as POST_CUTOFF. A declaration never restores provenance: the lines it names read as `historical gap acknowledged` in the verification result.",
      "reference": "ADR-EVI-0002",
      "occurrenceIndex": 0,
      "stringOffset": 82,
      "context": {
        "mode": "annotation-value",
        "observedKeywords": [
          "description"
