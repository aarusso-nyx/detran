{
  "schemaVersion": "1.0.0",
  "descriptorVersion": "1.0.0",
  "repositoryId": "aarusso-nyx/detran",
  "fallbackNodeId": "backend-kernel",
  "dynamicFallbackSelectors": [
    {
      "kind": "glob",
      "pattern": "**/*"
    }
  ],
  "tasks": [
    {
      "nodeId": "backend-kernel",
      "dependencies": [],
      "argv": ["pnpm", "run", "ci:backend-kernel:local"],
      "cwd": ".",
      "runner": "pnpm",
      "inputSelectors": [
        {
          "kind": "glob",
          "pattern": "backend/**/*"
        },
        {
          "kind": "glob",
          "pattern": "apps/**/*"
        },
        {
          "kind": "glob",
          "pattern": "packages/**/*"
        },
        {
          "kind": "glob",
          "pattern": "senatran-mock/**/*"
        },
        {
          "kind": "glob",
          "pattern": "tools/**/*"
        },
        {
          "kind": "glob",
          "pattern": "docs/framework/**/*"
        },
        {
          "kind": "glob",
          "pattern": "schemas/**/*"
        },
        {
          "kind": "glob",
          "pattern": ".devai/config/**/*"
        },
        {
          "kind": "glob",
          "pattern": "law/policy/**/*"
        },
        {
          "kind": "glob",
          "pattern": ".github/workflows/ci.yml"
        },
        {
          "kind": "glob",
          "pattern": "package.json"
        },
        {
          "kind": "glob",
          "pattern": "pnpm-lock.yaml"
        },
        {
          "kind": "glob",
          "pattern": "pnpm-workspace.yaml"
        },
        {
          "kind": "glob",
          "pattern": "tsconfig*.json"
        },
        {
          "kind": "glob",
          "pattern": "vitest*.ts"
        },
        {
          "kind": "glob",
          "pattern": "eslint.config.*"
        },
        {
          "kind": "glob",
          "pattern": ".prettier*"
        },
        {
          "kind": "glob",
          "pattern": "test-tasks.json"
        }
      ],
      "toolchainKeys": ["node", "pnpm"],
      "allowlistedEnv": [
        "DEVAI_DB_TESTS",
        "DETRAN_RC_CONTAINER_RUNTIME",
        "DETRAN_RC_POSTGIS_IMAGE",
        "DETRAN_RC_POSTGRES_MAJOR",
        "DETRAN_RC_POSTGIS_VERSION"
      ],
      "outputContract": {}
    }
  ],
  "profiles": [
    {
      "profileId": "rc",
      "mode": "fixed",
      "requiredNodes": ["backend-kernel"]
    }
  ]
}
