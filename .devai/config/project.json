{
  "schemaVersion": "1.0.0",
  "project_type": "runtime-host",
  "authority_enforcement": {
    "mode": "cli-only"
  },
  "profile": "tier3",
  "constitution": {
    "version": "1.0.2",
    "sha256": "d7f8791f1d00a7247bced66bdcdf8b1af431bb57e49d03b6ddd7024cb52f957d"
  },
  "devai_version": "2.2.0",
  "name": "detran",
  "repo": {
    "kind": "application"
  },
  "docs": {
    "builder": "docusaurus",
    "build_command": "npm --prefix docs/site run build",
    "output_dir": "docs/site/build",
    "publish_target": "gh-pages",
    "gh_pages_branch": "gh-pages",
    "custom_domain": null,
    "ia": {
      "collapsed_sections": [
        "roles"
      ]
    }
  },
  "ci_economy": {
    "profile": "full",
    "attested_rc": {
      "profile": "rc",
      "transport": "protected-tag-v1",
      "tag_prefix": "devai-local-evidence/",
      "binding": "exact-tree",
      "required_check": "verified-local-rc",
      "failure_mode": "fail-closed",
      "local_only_nodes": [
        "backend-kernel"
      ]
    }
  }
}
