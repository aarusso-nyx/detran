ck","value":{"columns":["resolution"],"deferrable":false,"deferred":false,"expression":"((resolution IS NULL) OR (resolution = ANY (ARRAY['device-wins'::text, 'server-wins'::text, 'manual-review'::text, 'accept_server'::text, 'reject'::text, 'retry_after_correction'::text, 'manual_review'::text])))","kind":"c","match":" ","noInherit":false,"onDelete":" ","onUpdate":" ","referencedColumns":null,"referencedSchema":null,"referencedTable":null,"validated":true}},{"kind":"constraint","name":"sync_conflicts.sync_conflicts_resolved_by_check","value":{"columns":["resolved_by"],"deferrable":false,"deferred":false,"expression":"((resolved_by IS NULL) OR (octet_length(resolved_by) <= 255))","kind":"c","match":" ","noInherit":false,"onDelete":" ","onUpdate":" ","referencedColumns":null,"referencedSchema":null,"referencedTable":null,"validated":true}},{"kind":"constraint","name":"sync_conflicts.sync_conflicts_status_check","value":{"columns":["status"],"deferrable":false,"deferred":false,"expression":"(status = ANY (ARRAY['open'::text, 'resolved'::text]))","kind":"c","match":" ","noInherit":false,"onDelete":" ","onUpdate":" ","referencedColumns":null,"referencedSchema":null,"referencedTable":null,"validated":true}},{"kind":"constraint","name":"sync_conflicts.sync_conflicts_tenant_id_fkey","value":{"columns":["tenant_id"],"deferrable":false,"deferred":false,"expression":null,"kind":"f","match":"s","noInherit":true,"onDelete":"c","onUpdate":"a","referencedColumns":["id"],"referencedSchema":"auth","referencedTable":"tenants","validated":true}},{"kind":"constraint","name":"sync_conflicts.sync_conflicts_tenant_id_id_key","value":{"columns":["tenant_id","id"],"deferrable":false,"deferred":false,"expression":null,"kind":"u","match":" ","noInherit":true,"onDelete":" ","onUpdate":" ","referencedColumns":null,"referencedSchema":null,"referencedTable":null,"validated":true}},{"kind":"constraint","name":"sync_conflicts.sync_conflicts_tenant_id_sync_queue_item_id_fkey","value":{"columns":["t