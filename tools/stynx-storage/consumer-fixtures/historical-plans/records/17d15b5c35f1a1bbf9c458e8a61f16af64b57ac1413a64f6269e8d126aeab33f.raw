\set ON_ERROR_STOP on
\pset tuples_only on
\pset format unaligned
BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY;
SET LOCAL timezone='UTC'; SET LOCAL row_security=on; SET LOCAL search_path=pg_catalog;
SELECT (current_database()='detran_r22_161_g03_upgrade' AND (SELECT oid FROM pg_database WHERE datname=current_database())::text='18767' AND (pg_control_system()).system_identifier::text='7696293464811719840' AND current_user='postgres' AND session_user='postgres' AND current_setting('port')='65462' AND current_setting('server_version_num')='180002' AND current_setting('transaction_read_only')='on' AND current_setting('row_security')='on' AND current_setting('data_directory')='/Users/aarusso/.codex/worktrees/detran-r22-adoption-160/detran/scratch/r22-adoption-161/db-rehearsal/cluster-02/data' AND split_part(pg_read_file('postmaster.pid'),E'\n',1)='64859') AS identity_ok \gset
\if :identity_ok
\else
\quit 3
\endif
SELECT jsonb_build_object('kind','identity','value',to_jsonb(x))::text FROM (SELECT current_database() AS database,d.oid::text AS oid,pg_get_userbyid(d.datdba) AS owner,(pg_control_system()).system_identifier::text AS system_identifier,current_user::text AS acting,session_user::text AS login,current_setting('data_directory') AS datadir,current_setting('port') AS port,current_setting('listen_addresses') AS addresses,current_setting('unix_socket_directories') AS sockets,current_setting('server_version') AS server_version,current_setting('transaction_read_only') AS readonly,current_setting('transaction_isolation') AS isolation,current_setting('row_security') AS rls,current_setting('session_replication_role') AS replication,pg_backend_pid() AS backend_pid,to_char(clock_timestamp() AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.US"Z"') AS observed_at_utc FROM pg_database d WHERE datname=current_database()) x;
SELECT jsonb_build_object('kind','activity','rows',coalesce(jsonb_agg(to_jsonb(a) ORDER BY pid),'[]'))::text FROM (SELECT pid,datname,usename,application_name,client_addr::text,client_port,state,backend_type,xact_start::text,query_start::text,wait_event_type,wait_event,query FROM pg_stat_activity WHERE backend_type='client backend' ORDER BY pid) a;
SELECT jsonb_build_object('kind','roles','rows',coalesce(jsonb_agg(to_jsonb(a) ORDER BY rolname),'[]'))::text FROM (SELECT oid::text,rolname,rolsuper,rolinherit,rolcreaterole,rolcreatedb,rolcanlogin,rolreplication,rolbypassrls,rolconnlimit,rolvaliduntil::text FROM pg_roles) a;
SELECT jsonb_build_object('kind','memberships','rows',coalesce(jsonb_agg(to_jsonb(a) ORDER BY roleid,member),'[]'))::text FROM pg_auth_members a;
SELECT jsonb_build_object('kind','effective-role-closure','rows',coalesce(jsonb_agg(to_jsonb(a) ORDER BY principal,reachable),'[]'))::text FROM (SELECT p.rolname AS principal,r.rolname AS reachable,pg_has_role(p.oid,r.oid,'SET') AS can_set,pg_has_role(p.oid,r.oid,'USAGE') AS inherits,pg_has_role(p.oid,r.oid,'MEMBER') AS member,r.rolsuper,r.rolbypassrls,r.rolcreaterole,r.rolcreatedb,r.rolreplication,has_database_privilege(r.oid,current_database(),'CREATE') AS database_create,has_schema_privilege(r.oid,'public','CREATE') AS public_create FROM pg_roles p CROSS JOIN pg_roles r WHERE p.rolname IN ('role_app_backend','role_auditor_min','role_r22_161_app') AND (p.oid=r.oid OR pg_has_role(p.oid,r.oid,'SET') OR pg_has_role(p.oid,r.oid,'USAGE') OR pg_has_role(p.oid,r.oid,'MEMBER'))) a;
SELECT jsonb_build_object('kind','schemas','rows',coalesce(jsonb_agg(to_jsonb(a) ORDER BY nspname COLLATE "C"),'[]'))::text FROM (SELECT oid::text,nspname,pg_get_userbyid(nspowner) AS owner,nspacl::text,obj_description(oid,'pg_namespace') AS description FROM pg_namespace WHERE nspname !~ '^pg_' AND nspname<>'information_schema') a;
SELECT jsonb_build_object('kind','relations','rows',coalesce(jsonb_agg(to_jsonb(a) ORDER BY schema_name COLLATE "C",relation_name COLLATE "C"),'[]'))::text FROM (SELECT n.nspname AS schema_name,c.relname AS relation_name,c.oid::text,c.relkind,c.relrowsecurity,c.relforcerowsecurity,c.relreplident,c.relpersistence,pg_get_userbyid(c.relowner) AS owner,c.relacl::text,c.reloptions,obj_description(c.oid,'pg_class') AS description FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname IN ('auth','integration','outbox','offline','public')) a;
SELECT jsonb_build_object('kind','columns','rows',coalesce(jsonb_agg(to_jsonb(a) ORDER BY schema_name,relation_name,attnum),'[]'))::text FROM (SELECT n.nspname AS schema_name,c.relname AS relation_name,a.attnum,a.attname,format_type(a.atttypid,a.atttypmod) AS type,a.attnotnull,a.attidentity,a.attgenerated,a.attisdropped,a.attacl::text,pg_get_expr(d.adbin,d.adrelid) AS default_expression FROM pg_attribute a JOIN pg_class c ON c.oid=a.attrelid JOIN pg_namespace n ON n.oid=c.relnamespace LEFT JOIN pg_attrdef d ON d.adrelid=a.attrelid AND d.adnum=a.attnum WHERE a.attnum>0 AND n.nspname IN ('auth','integration','outbox','offline','public')) a;
SELECT jsonb_build_object('kind','constraints','rows',coalesce(jsonb_agg(to_jsonb(a) ORDER BY schema_name,relation_name,conname),'[]'))::text FROM (SELECT n.nspname AS schema_name,c.relname AS relation_name,k.oid::text,k.conname,k.contype,k.conkey,k.confkey,k.confrelid::regclass::text,k.conindid::text,k.convalidated,k.condeferrable,k.condeferred,k.conislocal,k.coninhcount,k.connoinherit,k.conparentid::text,pg_get_constraintdef(k.oid,true) AS definition FROM pg_constraint k JOIN pg_class c ON c.oid=k.conrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname IN ('auth','integration','outbox','offline','public')) a;
SELECT jsonb_build_object('kind','indexes','rows',coalesce(jsonb_agg(to_jsonb(a) ORDER BY schemaname,tablename,indexname),'[]'))::text FROM pg_indexes a WHERE schemaname IN ('auth','integration','outbox','offline','public');
SELECT jsonb_build_object('kind','policies','rows',coalesce(jsonb_agg(to_jsonb(a) ORDER BY schemaname,tablename,policyname),'[]'))::text FROM pg_policies a WHERE schemaname IN ('auth','integration','outbox','offline','public');
SELECT jsonb_build_object('kind','triggers','rows',coalesce(jsonb_agg(to_jsonb(a) ORDER BY schema_name,relation_name,tgname),'[]'))::text FROM (SELECT n.nspname AS schema_name,c.relname AS relation_name,t.oid::text,t.tgname,t.tgtype,t.tgenabled,t.tgisinternal,t.tgconstraint::text,t.tgconstrrelid::regclass::text,t.tgconstrindid::text,t.tgfoid::regprocedure::text AS function_identity,pg_get_triggerdef(t.oid,true) AS definition FROM pg_trigger t JOIN pg_class c ON c.oid=t.tgrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname IN ('auth','integration','outbox','offline','public')) a;
SELECT jsonb_build_object('kind','functions','rows',coalesce(jsonb_agg(to_jsonb(a) ORDER BY schema_name,name,arguments),'[]'))::text FROM (SELECT n.nspname AS schema_name,p.proname AS name,pg_get_function_identity_arguments(p.oid) AS arguments,pg_get_userbyid(p.proowner) AS owner,p.prosecdef,p.proconfig,p.proacl::text,pg_get_functiondef(p.oid) AS definition FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE n.nspname IN ('auth','integration','outbox','offline','public') AND p.prokind<>'a') a;
SELECT jsonb_build_object('kind','extensions','rows',coalesce(jsonb_agg(to_jsonb(a) ORDER BY extname),'[]'))::text FROM (SELECT extname,extversion,extnamespace::regnamespace::text AS schema FROM pg_extension) a;
SELECT format('SELECT jsonb_build_object(''kind'',''table-rows'',''schema'',%L,''table'',%L,''rows'',coalesce(jsonb_agg(raw ORDER BY raw COLLATE "C"),''[]''))::text FROM (SELECT row_to_json(x)::text AS raw FROM %I.%I x) t;',n.nspname,c.relname,n.nspname,c.relname) FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname IN ('auth','integration','outbox','offline','public') AND c.relkind IN ('r','p') ORDER BY n.nspname COLLATE "C",c.relname COLLATE "C" \gexec
SELECT format('SELECT jsonb_build_object(''kind'',''sequence-state'',''schema'',%L,''sequence'',%L,''state'',to_jsonb(x))::text FROM (SELECT last_value::text,is_called FROM %I.%I) x;',n.nspname,c.relname,n.nspname,c.relname) FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname IN ('auth','integration','outbox','offline','public') AND c.relkind='S' ORDER BY n.nspname COLLATE "C",c.relname COLLATE "C" \gexec
SELECT jsonb_build_object(
      'schemas',(SELECT coalesce(jsonb_agg(jsonb_build_object('name',nspname,'owner',pg_get_userbyid(nspowner),'acl',nspacl::text) ORDER BY nspname COLLATE "C"),'[]') FROM pg_namespace WHERE nspname !~ '^pg_' AND nspname <> 'information_schema'),
      'relations',(SELECT coalesce(jsonb_agg(jsonb_build_object('schema',n.nspname,'name',c.relname,'kind',c.relkind,'owner',pg_get_userbyid(c.relowner)) ORDER BY n.nspname COLLATE "C",c.relname COLLATE "C"),'[]') FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname !~ '^pg_' AND n.nspname <> 'information_schema'),
      'functions',(SELECT coalesce(jsonb_agg(jsonb_build_object('schema',n.nspname,'name',p.proname,'arguments',pg_get_function_identity_arguments(p.oid),'owner',pg_get_userbyid(p.proowner)) ORDER BY n.nspname COLLATE "C",p.proname COLLATE "C",p.oid),'[]') FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE n.nspname !~ '^pg_' AND n.nspname <> 'information_schema'),
      'types',(SELECT coalesce(jsonb_agg(jsonb_build_object('schema',n.nspname,'name',t.typname,'kind',t.typtype) ORDER BY n.nspname COLLATE "C",t.typname COLLATE "C"),'[]') FROM pg_type t JOIN pg_namespace n ON n.oid=t.typnamespace WHERE n.nspname !~ '^pg_' AND n.nspname <> 'information_schema'),
      'eventTriggers',(SELECT coalesce(jsonb_agg(jsonb_build_object('name',evtname,'event',evtevent,'enabled',evtenabled,'owner',pg_get_userbyid(evtowner)) ORDER BY evtname COLLATE "C"),'[]') FROM pg_event_trigger),
      'extensions',(SELECT coalesce(jsonb_agg(extname ORDER BY extname COLLATE "C"),'[]') FROM pg_extension),
      'defaults',(SELECT coalesce(jsonb_agg(to_jsonb(d) ORDER BY oid),'[]') FROM pg_default_acl d),
      'roleSettings',(SELECT coalesce(jsonb_agg(to_jsonb(s) ORDER BY setdatabase,setrole),'[]') FROM pg_db_role_setting s WHERE setdatabase=0 OR setdatabase=(SELECT oid FROM pg_database WHERE datname=current_database())),
      'foreignWrappers',(SELECT coalesce(jsonb_agg(fdwname ORDER BY fdwname COLLATE "C"),'[]') FROM pg_foreign_data_wrapper),
      'foreignServers',(SELECT coalesce(jsonb_agg(srvname ORDER BY srvname COLLATE "C"),'[]') FROM pg_foreign_server),
      'publications',(SELECT coalesce(jsonb_agg(pubname ORDER BY pubname COLLATE "C"),'[]') FROM pg_publication),
      'subscriptions',(SELECT coalesce(jsonb_agg(subname ORDER BY subname COLLATE "C"),'[]') FROM pg_subscription)
      ) AS pristine;
ROLLBACK;
