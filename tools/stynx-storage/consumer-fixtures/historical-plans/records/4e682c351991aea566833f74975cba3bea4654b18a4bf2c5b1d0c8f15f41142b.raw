        {
          "kind": "constraint",
          "name": "numbering_ranges.numbering_ranges_administered_cancellation_check",
          "value": {
            "kind": "c",
            "match": " ",
            "columns": [
              "created_by",
              "status",
              "cancelled_by",
              "cancelled_at"
            ],
            "deferred": false,
            "onDelete": " ",
            "onUpdate": " ",
            "noInherit": false,
            "validated": true,
            "deferrable": false,
            "expression": "((created_by IS NULL) OR (status <> 'cancelled'::text) OR ((cancelled_by IS NOT NULL) AND (cancelled_at IS NOT NULL)))",
            "referencedTable": null,
            "referencedSchema": null,
            "referencedColumns": null
          }
        },
        {
          "kind": "constraint",
          "name": "numbering_ranges.numbering_ranges_cancellation_evidence_check",
          "value": {
            "kind": "c",
            "match": " ",
            "columns": [
              "cancelled_by",
              "cancelled_at",
              "cancellation_reason",
              "status"
            ],
            "deferred": false,
            "onDelete": " ",
            "onUpdate": " ",
            "noInherit": false,
            "validated": true,
            "deferrable": false,
            "expression": "(((cancelled_by IS NULL) AND (cancelled_at IS NULL) AND (cancellation_reason IS NULL)) OR ((cancelled_by IS NOT NULL) AND (cancelled_at IS NOT NULL) AND isfinite(cancelled_at) AND (status = 'cancelled'::text)))",
            "referencedTable": null,
            "referencedSchema": null,
            "referencedColumns": null
          }
        },
        {
          "kind": "constraint",
          "name": "numbering_ranges.numbering_ranges_cancellation_reason_check",
          "value": {
            "kind": "c",
            "match": " ",
            "columns": [
