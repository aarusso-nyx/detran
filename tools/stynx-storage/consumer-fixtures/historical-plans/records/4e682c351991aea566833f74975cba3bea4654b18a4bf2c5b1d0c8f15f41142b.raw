            "leakproof": false,
            "definition": "CREATE OR REPLACE FUNCTION offline.guard_sync_import_receipt()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'pg_catalog'\nAS $function$\nBEGIN\n  RAISE EXCEPTION USING ERRCODE = 'STY50', MESSAGE = 'Offline import receipts are append-only.';\nEND\n$function$\n",
            "volatility": "v",
            "securityDefiner": false
          }
