            ],
            "deferred": false,
            "onDelete": " ",
            "onUpdate": " ",
            "noInherit": false,
            "validated": true,
            "deferrable": false,
            "expression": "((cancellation_reason IS NULL) OR (octet_length(cancellation_reason) <= 500))",
            "referencedTable": null,
            "referencedSchema": null,
            "referencedColumns": null
          }
        },
        {
          "kind": "constraint",
          "name": "numbering_ranges.numbering_ranges_cancelled_by_check",
          "value": {
            "kind": "c",
            "match": " ",
            "columns": [
              "cancelled_by"
            ],
            "deferred": false,
            "onDelete": " ",
            "onUpdate": " ",
            "noInherit": false,
            "validated": true,
            "deferrable": false,
            "expression": "((cancelled_by IS NULL) OR ((octet_length(cancelled_by) >= 1) AND (octet_length(cancelled_by) <= 255)))",
            "referencedTable": null,
            "referencedSchema": null,
            "referencedColumns": null
          }
        },
        {
