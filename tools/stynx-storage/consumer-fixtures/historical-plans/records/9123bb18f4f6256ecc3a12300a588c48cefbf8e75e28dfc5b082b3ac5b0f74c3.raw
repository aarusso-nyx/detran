story","functionSchema":"offline","type":31}},{"kind":"trigger","name":"numbering_reservations.numbering_reservations_active_scope_guard","value":{"arguments":"","condition":null,"enabled":"O","function":"guard_active_numbering_reservation","functionSchema":"offline","type":23}},{"kind":"trigger","name":"sync_batches.sync_batches_archive_guard","value":{"arguments":"","condition":null,"enabled":"O","function":"guard_archived_sync_batch","functionSchema":"offline","type":31}},{"kind":"trigger","name":"sync_import_receipts.sync_import_receipts_append_only","value":{"arguments":"","condition":null,"enabled":"O","function":"guard_sync_import_receipt","functionSchema":"offline","type":27}}],"contractVersion":"1.0.0","dependencies":["PostgreSQL gen_random_uuid(), clock_timestamp(), advisory transaction locks","trusted app.tenant_id and app.actor_id transaction settings","READ COMMITTED writable primary transactions for durable allocation and batch admission","range FOR UPDATE locks and normalized tenant/device/nullable-shift scope fences","tenant UUID key with uniqueness and configured owner migration privileges","owner full visibility and fixed-order ACCESS EXCLUSIVE offline locks for atomic imports","consumer maintenance and independent archived-response provenance verification"],"packageVersion":"1.6.0","sources":[{"path":"packages/data/migrations/platform/0001_roles.sql","sha256":"626a77418b483b87077fdfd4c24140c2f7018ad615acfa81100c468bfe7bd2c6"},{"path":"packages/data/migrations/platform/0002_extensions.sql","sha256":"d15c9759138c1a83a9a2c35b46989140a45b95123b392d08ee883fbe43477d5a"},{"path":"packages/data/migrations/platform/0003_schemas.sql","sha256":"8521739a9b9346ba2e8dd6c54209244ca734ae6b7005acf34ef0813d1a099cc4"},{"path":"packages/data/migrations/platform/0004_tenancy.sql","sha256":"4b6f9125de975817fd363b65f5083378f9dbf4307bfd2d77fa92355b03ae9375"},{"path":"packages/data/migrations/platform/0005_auth.sql","sha256":"356f4917d7403fb74f3a6345eb379f1bd0d26b9ed18c5b