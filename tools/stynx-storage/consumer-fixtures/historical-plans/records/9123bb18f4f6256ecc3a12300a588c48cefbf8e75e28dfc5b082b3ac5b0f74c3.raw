724a2931a3b300c46da6cae50b4a701d1feef540e55dcc3f7f6f5"},{"path":"packages/data/migrations/platform/0018_notifications.sql","sha256":"b4f599ab847af938c2e7a452ee77c99129c55d5ab5e103ab4a87f071a9acaea9"},{"path":"packages/data/migrations/platform/0018_outbox.sql","sha256":"220fa5db0a8f0dce9298c905998a9986f30cdf4a5c0194a6d43380914e3d63a6"},{"path":"packages/data/migrations/platform/0018_worklist.sql","sha256":"87ec2580cefa32381012892c798091eb2a4d704cfbb95e4587086bd75412ee7d"},{"path":"packages/data/migrations/platform/0019_jobs_actor_timezone.sql","sha256":"99d2466eb567cdd939f24400f0788209cd67515ead875ebba185a971ace5bb2b"},{"path":"packages/data/migrations/platform/0020_transactional_commands.sql","sha256":"1a14f5d568785c2a4bbba251d918589de28fc824f65c597d201a2fb7d9af396f"},{"path":"packages/data/migrations/platform/0021_outbox_event_log.sql","sha256":"6f7cc05d54153564140fe0fa78d6a7406e3e15ddb6568bdb75c2d56d56dd3783"},{"path":"packages/data/migrations/platform/0022_outbox_request_path.sql","sha256":"f0e4e357e35343044fd6765180fa3b380c0cd3a205f10e8e6e5425443ba97e90"},{"path":"packages/data/migrations/platform/0023_auth_sessions_partitions.sql","sha256":"84fb0151cf1a3ddcd9e7c71a1c6679ffee32ecd02b7f047ade2a3d3be6bb46e1"},{"path":"packages/data/migrations/platform/0024_auth_sessions_partition_retention.sql","sha256":"240bdce43f4b387726dddcfd7bc8b7c7149527e625ec39d271c0f4fea472c69a"},{"path":"packages/data/migrations/platform/0025_outbox_attempt_guard_role_independent.sql","sha256":"2c6663e4999f84378ba8f42a95f59ae845293997b598267c0987dea43d6efe56"},{"path":"packages/data/migrations/platform/0026_outbox_event_retirement.sql","sha256":"97f8c38c7a73ae75f88e842e84ba27cb39f31234d3c1ad06d60ea15b2adf21db"},{"path":"packages/offline-sync/migrations/0001_offline_sync.sql","sha256":"e8c61245343dd0bb58f49e259b9384bc0fa06b81b1211b19fc6a37de275069c1"},{"path":"packages/offline-sync/migrations/0002_durable_sync.sql","sha256":"bb2c7685a2092d92ecb7ce80b7a61e54714a55cbb5e1a222d0e71d3a4b2b8983"},{"path":"packages/offline-sync/migrations/0003_reservation_idempotency.sql","sha256":"c947e341e1617c983fc559317f32a724aeaef07094e41334e41bc517621a534f"},{"path":"packages/offline-sync/migrations/0004_pending_state_and_conflict_actions.sql","sha256":"435e064cf61fe1a3b76c49cc9b495616a5125ba92b480d75807fd4a1dabba0c6"},{"path":"packages/offline-sync/migrations/0005_initial_queue_status.sql","sha256":"dc3a8ee136406c749214f29251a7314990ce7c402e5bb4120111518fd2a15c0e"},{"path":"packages/offline-sync/migrations/0006_nullable_active_reservations.sql","sha256":"942822d271a6ea5e6b82e1bea831bcbac9e8169003294c60b28d977fe6b23db5"},{"path":"packages/offline-sync/migrations/0007_range_administration.sql","sha256":"63ab4d83807c8cd7ec031085ac3344eef2ba611611b92418fdcfde4220d21836"},{"path":"packages/offline-sync/migrations/0008_import_receipts.sql","sha256":"b700c1db62fd9a3d0e1f43000c61aa64d7b2b6d28cb288f148b73c8a3a8bbf5a"},{"path":"scripts/offline-storage-generate.mjs","sha256":"a7ebbd8108d246e09d136ac7f55f8cbf5e43ebcce174ed8f72a395ba42219a95"},{"path":"tools/migration-linter/src/sql.ts","sha256":"f49ddbe0484045c721e6c32d6c5f641204bdcd3472968e4ed1b255b3d94a4fbc"},{"path":"scripts/offline-storage-catalog-generate.mjs","sha256":"a933e105d351036e93292d2c72f285594e03ee0110619c757f329b14525585a9"},{"path":"packages/data/src/storage-catalog.ts","sha256":"30c90bbbeb1f238e72df839fee4760c4a84bbdc3b735e1d5b27312871da7b261"}],"templateSha256":"9c27c80a438b1e69348289a78edafcb7d6ea8f933580bd0d98cd55f4c69bb390"},"objectsSql":"CREATE SCHEMA IF NOT EXISTS offline AUTHORIZATION \"postgres\";\n\nCREATE TABLE IF NOT EXISTS offline.numbering_ranges (\n  id uuid NOT NULL DEFAULT gen_random_uuid(),\n  tenant_id uuid NOT NULL REFERENCES \"auth\".\"tenants\"(\"id\") ON DELETE CASCADE,\n  org_unit_id text NOT NULL CHECK (octet_length(org_unit_id) BETWEEN 1 AND 255),\n  entity_type text NOT NULL CHECK (octet_length(entity_type) BETWEEN 1 AND 100),\n  series text NOT NULL CHECK (octet_length(series) BETWEEN 1 AND 80),\n  start_number bigint NOT NULL,\n  end_number bigint NOT NULL,\n  next_number bigint NOT NULL,\n  status text NOT NULL DEFAULT 'active'\n    CHECK (status IN ('active', 'exhausted', 'cancelled')),\n  created_at timestamptz NOT NULL DEFAULT clock_timestamp(),\n  updated_at timestamptz,\n  PRIMARY KEY (id),\n  UNIQUE (tenant_id, id),\n  UNIQUE (tenant_id, org_unit_id, entity_type, series),\n  CHECK (start_number <= next_number AND next_number <= end_number + 1)\n);\n\nCREATE INDEX IF NOT EXISTS numbering_ranges_tenant_status_idx\n  ON offline.numbering_ranges (tenant_id, status, org_unit_id, entity_type);\n\nCREATE TABLE IF NOT EXISTS offline.numbering_reservations (\n  id uuid NOT NULL DEFAULT gen_random_uuid(),\n  tenant_id uuid NOT NULL REFERENCES \"auth\".\"tenants\"(\"id\") ON DELETE CASCADE,\n  range_id uuid NOT NULL,\n  org_unit_id text NOT NULL CHECK (octet_length(org_unit_id) BETWEEN 1 AND 255),\n  entity_type text NOT NULL CHECK (octet_length(entity_type) BETWEEN 1 AND 100),\n  series text NOT NULL CHECK (octet_length(series) BETWEEN 1 AND 80),\n  agent_id text NOT NULL CHECK (octet_length(agent_id) BETWEEN 1 AND 255),\n  device_id text NOT NULL CHECK (octet_length(device_id) BETWEEN 1 AND 255),\n  shift_id text NOT NULL CHECK (octet_length(shift_id) BETWEEN 1 AND 255),\n  start_number bigint NOT NULL,\n  end_number bigint NOT NULL,\n  next_number bigint NOT NULL,\n  reserved_at timestamptz NOT NULL DEFAULT clock_timestamp(),\n  valid_until timestamptz NOT NULL,\n  status text NOT NULL DEFAULT 'reserved'\n    CHECK (status IN ('reserved', 'consumed', 'expired', 'cancelled')),\n  cancellation_reason text CHECK (cancellation_reason IS NULL OR octet_length(cancellation_reason) <= 500),\n  cancelled_by text CHECK (cancelled_by IS NULL OR octet_length(cancelled_by) <= 255),\n  created_at timestamptz NOT NULL DEFAULT clock_timestamp(),\n  updated_at timestamptz,\n  PRIMARY KEY (id),\n  UNIQUE (tenant_id, id),\n  FOREIGN KEY (tenant_id, range_id)\n    REFERENCES offline.numbering_ranges (tenant_id, id) ON DELETE RESTRICT,\n  CHECK (start_number <= next_number AND next_number <= end_number + 1)\n);\n\nCREATE INDEX IF NOT EXISTS numbering_reservations_tenant_device_status_idx\n  ON offline.numbering_reservations (tenant_id, device_id, status, valid_until);\n\nCREATE INDEX IF NOT EXISTS numbering_reservations_tenant_range_idx\n  ON offline.numbering_reservations (tenant_id, range_id, start_number, end_number);\n\nCREATE TABLE IF NOT EXISTS offline.sync_queue_items (\n  id text NOT NULL CHECK (octet_length(id) BETWEEN 1 AND 255),\n  tenant_id uuid NOT NULL REFERENCES \"auth\".\"tenants\"(\"id\") ON DELETE CASCADE,\n  device_batch_id text NOT NULL CHECK (octet_length(device_batch_id) BETWEEN 1 AND 255),\n  org_unit_id text NOT NULL CHECK (octet_length(org_unit_id) BETWEEN 1 AND 255),\n  agent_id text NOT NULL CHECK (octet_length(agent_id) BETWEEN 1 AND 255),\n  device_id text NOT NULL CHECK (octet_length(device_id) BETWEEN 1 AND 255),\n  entity_type text NOT NULL CHECK (octet_length(entity_type) BETWEEN 1 AND 100),\n  local_entity_id text NOT NULL CHECK (octet_length(local_entity_id) BETWEEN 1 AND 255),\n  idempotency_key text NOT NULL CHECK (octet_length(idempotency_key) BETWEEN 1 AND 255),\n  payload_hash text NOT NULL CHECK (payload_hash ~ '^sha256:[0-9a-f]{64}$'),\n  payload_json jsonb NOT NULL CHECK (jsonb_typeof(payload_json) = 'object'),\n  reserved_number bigint,\n  status text NOT NULL DEFAULT 'received'\n    CHECK (status IN ('received', 'applied', 'conflict', 'rejected')),\n  created_locally_at timestamptz NOT NULL,\n  received_at timestamptz NOT NULL DEFAULT clock_timestamp(),\n  created_at timestamptz NOT NULL DEFAULT clock_timestamp(),\n  updated_at timestamptz,\n  PRIMARY KEY (tenant_id, id),\n  UNIQUE (tenant_id, payload_hash),\n  UNIQUE (tenant_id, idempotency_key)\n);\n\nCREATE INDEX IF NOT EXISTS sync_queue_items_tenant_device_status_idx\n  ON offline.sync_queue_items (tenant_id, device_id, status, received_at);\n\nCREATE INDEX IF NOT EXISTS sync_queue_items_tenant_batch_idx\n  ON offline.sync_queue_items (tenant_id, device_batch_id, received_at);\n\nCREATE INDEX IF NOT EXISTS sync_queue_items_tenant_entity_idx\n  ON offline.sync_queue_items (tenant_id, entity_type, local_entity_id);\n\nCREATE TABLE IF NOT EXISTS offline.sync_conflicts (\n  id uuid NOT NULL DEFAULT gen_random_uuid(),\n  tenant_id uuid NOT NULL REFERENCES \"auth\".\"tenants\"(\"id\") ON DELETE CASCADE,\n  sync_queue_item_id text NOT NULL,\n  local_entity_id text NOT NULL CHECK (octet_length(local_entity_id) BETWEEN 1 AND 255),\n  payload_hash text NOT NULL CHECK (payload_hash ~ '^sha256:[0-9a-f]{64}$'),\n  conflict_type text NOT NULL CHECK (octet_length(conflict_type) BETWEEN 1 AND 100),\n  description text NOT NULL CHECK (octet_length(description) BETWEEN 1 AND 4000),\n  status text NOT NULL DEFAULT 'open' CHECK (status IN ('open', 'resolved')),\n  resolution text CHECK (\n    resolution IS NULL OR resolution IN ('device-wins', 'server-wins', 'manual-review')\n  ),\n  resolved_by text CHECK (resolved_by IS NULL OR octet_length(resolved_by) <= 255),\n  resolved_at timestamptz,\n  created_at timestamptz NOT NULL DEFAULT clock_timestamp(),\n  updated_at timestamptz,\n  PRIMARY KEY (id),\n  UNIQUE (tenant_id, id),\n  FOREIGN KEY (tenant_id, sync_queue_item_id)\n    REFERENCES offline.sync_queue_items (tenant_id, id) ON DELETE CASCADE,\n  CHECK (\n    (status = 'open' AND resolution IS NULL AND resolved_at IS NULL)\n    OR (status = 'resolved' AND resolution IS NOT NULL AND resolved_at IS NOT NULL)\n  )\n);\n\nCREATE INDEX IF NOT EXISTS sync_conflicts_tenant_status_idx\n  ON offline.sync_conflicts (tenant_id, status, created_at);\n\nCREATE INDEX IF NOT EXISTS sync_conflicts_tenant_queue_idx\n  ON offline.sync_conflicts (tenant_id, sync_queue_item_id);\n\nALTER TABLE offline.numbering_ranges ENABLE ROW LEVEL SECURITY;\n\nALTER TABLE offline.numbering_ranges FORCE ROW LEVEL SECURITY;\n\nALTER TABLE offline.numbering_reservations ENABLE ROW LEVEL SECURITY;\n\nALTER TABLE offline.numbering_reservations FORCE ROW LEVEL SECURITY;\n\nALTER TABLE offline.sync_queue_items ENABLE ROW LEVEL SECURITY;\n\nALTER TABLE offline.sync_queue_items FORCE ROW LEVEL SECURITY;\n\nALTER TABLE offline.sync_conflicts ENABLE ROW LEVEL SECURITY;\n\nALTER TABLE offline.sync_conflicts FORCE ROW LEVEL SECURITY;\n\nALTER TABLE offline.sync_queue_items ADD COLUMN identity_mode text NOT NULL DEFAULT 'e6'\n  CONSTRAINT sync_queue_items_identity_mode_check CHECK (identity_mode IN ('e6','ctg9'));\n\nCREATE UNIQUE INDEX sync_queue_items_e6_hash_uq\n  ON offline.sync_queue_items (tenant_id, payload_hash) WHERE identity_mode = 'e6';\n\nALTER TABLE offline.sync_queue_items DROP CONSTRAINT sync_queue_items_tenant_id_payload_hash_key;\n\nALTER TABLE offline.numbering_reservations DROP CONSTRAINT numbering_reservations_status_check;\n\nALTER TABLE offline.numbering_reservations ADD CONSTRAINT numbering_reservations_status_check\n  CHECK (status IN ('reserved','consumed','expired','cancelled','blocked'));\n\nALTER TABLE offline.numbering_reservations ADD COLUMN audit_actor_id text;\n\nALTER TABLE offline.numbering_reservations ADD COLUMN settlement_action text;\n\nALTER TABLE offline.numbering_reservations ADD COLUMN settlement_reason text;\n\nALTER TABLE offline.numbering_reservations ADD COLUMN settlement_user_ref text;\n\nALTER TABLE offline.numbering_reservations ADD COLUMN settled_by text;\n\nALTER TABLE offline.sync_conflicts DROP CONSTRAINT sync_conflicts_resolution_check;\n\nALTER TABLE offline.sync_conflicts ADD CONSTRAINT sync_conflicts_resolution_check\n  CHECK (resolution IS NULL OR resolution IN\n    ('device-wins','server-wins','manual-review','accept_server','reject','retry_after_correction','manual_review'));\n\nALTER TABLE offline.sync_conflicts ADD COLUMN resolution_reason text;\n\nALTER TABLE offline.sync_conflicts ADD COLUMN resolution_user_ref text;\n\nCREATE TABLE offline.sync_batches (\n  tenant_id uuid NOT NULL REFERENCES \"auth\".\"tenants\"(\"id\") ON DELETE CASCADE,\n  device_id text NOT NULL,\n  device_batch_id text NOT NULL,\n  org_unit_id text NOT NULL,\n  agent_id text NOT NULL,\n  batch_sequence bigint,\n  context_hash text NOT NULL,\n  declared_keys jsonb NOT NULL,\n  status text NOT NULL CHECK (status IN ('open','closed','legacy_closed_unverified')),\n  lease_token uuid,\n  lease_generation bigint NOT NULL DEFAULT 0,\n  lease_expires_at timestamptz,\n  transport_key text,\n  transport_fingerprint text,\n  response_status integer,\n  response_body_bytes bytea,\n  response_headers jsonb NOT NULL DEFAULT '{}'::jsonb,\n  created_at timestamptz NOT NULL DEFAULT clock_timestamp(),\n  updated_at timestamptz,\n  PRIMARY KEY (tenant_id, device_id, device_batch_id),\n  UNIQUE (tenant_id, device_id, batch_sequence)\n);\n\nCREATE INDEX sync_batches_tenant_status_idx ON offline.sync_batches (tenant_id,status,lease_expires_at);\n\nCREATE TABLE offline.sync_batch_transport_keys (\n  tenant_id uuid NOT NULL REFERENCES \"auth\".\"tenants\"(\"id\") ON DELETE CASCADE,\n  transport_key text NOT NULL,\n  device_id text NOT NULL,\n  device_batch_id text NOT NULL,\n  transport_fingerprint text NOT NULL,\n  created_at timestamptz NOT NULL DEFAULT clock_timestamp(),\n  PRIMARY KEY (tenant_id,transport_key),\n  FOREIGN KEY (tenant_id,device_id,device_batch_id)\n    REFERENCES offline.sync_batches (tenant_id,device_id,device_batch_id)\n);\n\nCREATE INDEX sync_batch_transport_keys_tenant_batch_idx\n  ON offline.sync_batch_transport_keys (tenant_id,device_id,device_batch_id);\n\nCREATE TABLE offline.sync_item_receipts (\n  tenant_id uuid NOT NULL REFERENCES \"auth\".\"tenants\"(\"id\") ON DELETE CASCADE,\n  idempotency_key text NOT NULL,\n  queue_item_id text NOT NULL,\n  device_id text NOT NULL,\n  device_batch_id text NOT NULL,\n  payload_hash text NOT NULL,\n  status text NOT NULL CHECK (status IN ('received','applied','conflict','rejected')),\n  error_code text,\n  context_json jsonb,\n  received_at timestamptz NOT NULL DEFAULT clock_timestamp(),\n  updated_at timestamptz,\n  PRIMARY KEY (tenant_id,idempotency_key),\n  FOREIGN KEY (tenant_id,device_id,device_batch_id)\n    REFERENCES offline.sync_batches (tenant_id,device_id,device_batch_id)\n);\n\nCREATE INDEX sync_item_receipts_tenant_batch_idx\n  ON offline.sync_item_receipts (tenant_id,device_id,device_batch_id);\n\nCREATE TABLE offline.sync_item_attempts (\n  tenant_id uuid NOT NULL REFERENCES \"auth\".\"tenants\"(\"id\") ON DELETE CASCADE,\n  device_id text NOT NULL,\n  device_batch_id text NOT NULL,\n  queue_item_id text NOT NULL,\n  idempotency_key text NOT NULL,\n  payload_hash text NOT NULL,\n  status text NOT NULL CHECK (status IN ('received','applied','conflict','rejected')),\n  error_code text,\n  context_json jsonb,\n  created_at timestamptz NOT NULL DEFAULT clock_timestamp(),\n  PRIMARY KEY (tenant_id,device_id,device_batch_id,queue_item_id),\n  FOREIGN KEY (tenant_id,device_id,device_batch_id)\n    REFERENCES offline.sync_batches (tenant_id,device_id,device_batch_id)\n);\n\nCREATE INDEX sync_item_attempts_tenant_key_idx ON offline.sync_item_attempts (tenant_id,idempotency_key);\n\nCREATE TABLE offline.numbering_consumption (\n  tenant_id uuid NOT NULL REFERENCES \"auth\".\"tenants\"(\"id\") ON DELETE CASCADE,\n  reservation_id uuid NOT NULL,\n  number bigint NOT NULL,\n  status text NOT NULL CHECK (status IN ('available','claimed-locally','applied','blocked','expired')),\n  server_entity_id text,\n  finalized_at timestamptz,\n  PRIMARY KEY (tenant_id,reservation_id,number),\n  FOREIGN KEY (tenant_id,reservation_id)\n    REFERENCES offline.numbering_reservations (tenant_id,id)\n);\n\nCREATE INDEX numbering_consumption_tenant_status_idx\n  ON offline.numbering_consumption (tenant_id,status,reservation_id);\n\nCREATE TABLE offline.sync_conflict_evidence (\n  tenant_id uuid NOT NULL REFERENCES \"auth\".\"tenants\"(\"id\") ON DELETE CASCADE,\n  conflict_id uuid NOT NULL,\n  queue_item_id text NOT NULL,\n  related_queue_item_id text,\n  allowed_actions jsonb NOT NULL DEFAULT '[]'::jsonb,\n  evidence jsonb NOT NULL DEFAULT '{}'::jsonb,\n  created_at timestamptz NOT NULL DEFAULT clock_timestamp(),\n  PRIMARY KEY (tenant_id,conflict_id,queue_item_id),\n  FOREIGN KEY (tenant_id,conflict_id) REFERENCES offline.sync_conflicts (tenant_id,id)\n);\n\nCREATE INDEX sync_conflict_evidence_tenant_item_idx\n  ON offline.sync_conflict_evidence (tenant_id,queue_item_id);\n\nINSERT INTO offline.sync_batches (\n tenant_id,device_id,device_batch_id,org_unit_id,agent_id,context_hash,declared_keys,status\n)\nSELECT tenant_id,device_id,device_batch_id,min(org_unit_id),min(agent_id),\n       'legacy-unverified',jsonb_agg(idempotency_key ORDER BY idempotency_key),\n       'legacy_closed_unverified'\nFROM offline.sync_queue_items\nGROUP BY tenant_id,device_id,device_batch_id;\n\nINSERT INTO offline.sync_item_receipts (\n tenant_id,idempotency_key,queue_item_id,device_id,device_batch_id,payload_hash,status,received_at\n)\nSELECT tenant_id,idempotency_key,id,device_id,device_batch_id,payload_hash,status,received_at\nFROM offline.sync_queue_items;\n\nALTER TABLE offline.sync_batches ENABLE ROW LEVEL SECURITY;\n\nALTER TABLE offline.sync_batches FORCE ROW LEVEL SECURITY;\n\nALTER TABLE offline.sync_batch_transport_keys ENABLE ROW LEVEL SECURITY;\n\nALTER TABLE offline.sync_batch_transport_keys FORCE ROW LEVEL SECURITY;\n\nALTER TABLE offline.sync_item_receipts ENABLE ROW LEVEL SECURITY;\n\nALTER TABLE offline.sync_item_receipts FORCE ROW LEVEL SECURITY;\n\nALTER TABLE offline.sync_item_attempts ENABLE ROW LEVEL SECURITY;\n\nALTER TABLE offline.sync_item_attempts FORCE ROW LEVEL SECURITY;\n\nALTER TABLE offline.numbering_consumption ENABLE ROW LEVEL SECURITY;\n\nALTER TABLE offline.numbering_consumption FORCE ROW LEVEL SECURITY;\n\nALTER TABLE offline.sync_conflict_evidence ENABLE ROW LEVEL SECURITY;\n\nALTER TABLE offline.sync_conflict_evidence FORCE ROW LEVEL SECURITY;\n\nALTER TABLE offline.numbering_reservations ADD COLUMN idempotency_key text\n  CONSTRAINT numbering_reservations_idempotency_key_check\n  CHECK (idempotency_key IS NULL OR octet_length(idempotency_key) BETWEEN 1 AND 255);\n\nALTER TABLE offline.numbering_reservations ADD COLUMN idempotency_fingerprint text;\n\nALTER TABLE offline.numbering_reservations ADD CONSTRAINT numbering_reservations_idempotency_pair_check\n  CHECK ((idempotency_key IS NULL) = (idempotency_fingerprint IS NULL));\n\nCREATE UNIQUE INDEX numbering_reservations_tenant_idempotency_uq\n  ON offline.numbering_reservations (tenant_id, idempotency_key) WHERE idempotency_key IS NOT NULL;\n\nALTER TABLE offline.sync_queue_items DROP CONSTRAINT sync_queue_items_status_check;\n\nALTER TABLE offline.sync_queue_items ADD CONSTRAINT sync_queue_items_status_check\n  CHECK (status IN ('received','applied','conflict','rejected','pending'));\n\nALTER TABLE offline.sync_item_receipts DROP CONSTRAINT sync_item_receipts_status_check;\n\nALTER TABLE offline.sync_item_receipts ADD CONSTRAINT sync_item_receipts_status_check\n  CHECK (status IN ('received','applied','conflict','rejected','pending'));\n\nALTER TABLE offline.sync_item_attempts DROP CONSTRAINT sync_item_attempts_status_check;\n\nALTER TABLE offline.sync_item_attempts ADD CONSTRAINT sync_item_attempts_status_check\n  CHECK (status IN ('received','applied','conflict','rejected','pending'));\n\nCREATE TABLE offline.sync_conflict_actions (\n  id uuid NOT NULL DEFAULT gen_random_uuid(),\n  tenant_id uuid NOT NULL REFERENCES \"auth\".\"tenants\"(\"id\") ON DELETE CASCADE,\n  conflict_id uuid NOT NULL,\n  action text NOT NULL CHECK (octet_length(action) BETWEEN 1 AND 100),\n  reason text CHECK (reason IS NULL OR octet_length(reason) <= 4000),\n  user_ref text CHECK (user_ref IS NULL OR octet_length(user_ref) <= 255),\n  actor_id text NOT NULL CHECK (octet_length(actor_id) BETWEEN 1 AND 255),\n  resulting_status text NOT NULL CHECK (resulting_status IN ('open','resolved')),\n  created_at timestamptz NOT NULL DEFAULT clock_timestamp(),\n  PRIMARY KEY (tenant_id, id),\n  FOREIGN KEY (tenant_id, conflict_id) REFERENCES offline.sync_conflicts (tenant_id, id)\n);\n\nCREATE INDEX sync_conflict_actions_tenant_conflict_idx\n  ON offline.sync_conflict_actions (tenant_id, conflict_id, created_at);\n\nALTER TABLE offline.sync_conflict_actions ENABLE ROW LEVEL SECURITY;\n\nALTER TABLE offline.sync_conflict_actions FORCE ROW LEVEL SECURITY;\n\nALTER TABLE offline.sync_batches ADD COLUMN initial_queue_status text NOT NULL DEFAULT 'received'\n  CHECK (initial_queue_status IN ('received','pending'));\n\nSET LOCAL row_security = off;\n\nLOCK TABLE offline.numbering_reservations IN SHARE ROW EXCLUSIVE MODE;\n\nDO $upgrade$\nDECLARE collisions jsonb;\nBEGIN\n  SELECT jsonb_agg(to_jsonb(c) ORDER BY c.tenant_id, c.device_id, c.shift_scope)\n    INTO collisions\n    FROM (\n      SELECT tenant_id, device_id, NULLIF(shift_id, 'stynx:no-shift') AS shift_scope,\n             array_agg(id ORDER BY id) AS reservation_ids\n        FROM offline.numbering_reservations\n       WHERE status IN ('reserved', 'blocked') AND valid_until > clock_timestamp()\n       GROUP BY tenant_id, device_id, NULLIF(shift_id, 'stynx:no-shift')\n      HAVING count(*) > 1\n    ) c;\n  IF collisions IS NOT NULL THEN\n    RAISE EXCEPTION USING ERRCODE = 'STY45',\n      MESSAGE = 'Active numbering reservation collisions require lifecycle resolution before upgrade.',\n      DETAIL = collisions::text;\n  END IF;\nEND\n$upgrade$;\n\nALTER TABLE offline.numbering_reservations ALTER COLUMN shift_id DROP NOT NULL;\n\nALTER TABLE offline.numbering_reservations ADD COLUMN reservation_origin text NOT NULL DEFAULT 'e6'\n  CONSTRAINT numbering_reservations_origin_check CHECK (reservation_origin IN ('e6', 'ctg9'));\n\nALTER TABLE offline.numbering_reservations ADD CONSTRAINT numbering_reservations_e6_shift_check\n  CHECK (reservation_origin <> 'e6' OR shift_id IS NOT NULL);\n\nCREATE INDEX numbering_reservations_active_scope_idx\n  ON offline.numbering_reservations (tenant_id, device_id, (NULLIF(shift_id, 'stynx:no-shift')), valid_until)\n  WHERE status IN ('reserved', 'blocked');\n\nCREATE TABLE offline.numbering_reservation_scopes (\n  tenant_id uuid NOT NULL REFERENCES \"auth\".\"tenants\"(\"id\") ON DELETE CASCADE,\n  device_id text NOT NULL CHECK (octet_length(device_id) BETWEEN 1 AND 255),\n  shift_scope text NOT NULL,\n  generation uuid NOT NULL,\n  PRIMARY KEY (tenant_id, device_id, shift_scope)\n);\n\nALTER TABLE offline.numbering_reservation_scopes ENABLE ROW LEVEL SECURITY;\n\nALTER TABLE offline.numbering_reservation_scopes FORCE ROW LEVEL SECURITY;\n\nCREATE FUNCTION offline.guard_active_numbering_reservation() RETURNS trigger\nLANGUAGE plpgsql SET search_path = pg_catalog AS $guard$\nBEGIN\n  IF TG_OP = 'UPDATE' AND (\n    NEW.reservation_origin IS DISTINCT FROM OLD.reservation_origin OR\n    NEW.tenant_id IS DISTINCT FROM OLD.tenant_id OR\n    NEW.device_id IS DISTINCT FROM OLD.device_id OR\n    NEW.shift_id IS DISTINCT FROM OLD.shift_id\n  ) THEN\n    RAISE EXCEPTION USING ERRCODE = 'STY46', MESSAGE = 'Numbering reservation scope and origin are immutable.';\n  END IF;\n  IF NEW.status NOT IN ('reserved', 'blocked') OR NEW.valid_until <= clock_timestamp() THEN\n    RETURN NEW;\n  END IF;\n  PERFORM pg_advisory_xact_lock(hashtextextended(\n    'stynx-offline-active:' || jsonb_build_array(NEW.tenant_id::text, NEW.device_id,\n      NULLIF(NEW.shift_id, 'stynx:no-shift'))::text, 0));\n  INSERT INTO offline.numbering_reservation_scopes (tenant_id, device_id, shift_scope, generation)\n    VALUES (NEW.tenant_id, NEW.device_id,\n      jsonb_build_array(NULLIF(NEW.shift_id, 'stynx:no-shift'))::text, gen_random_uuid())\n    ON CONFLICT (tenant_id, device_id, shift_scope)\n    DO UPDATE SET generation = gen_random_uuid();\n  IF NEW.valid_until <= clock_timestamp() THEN\n    RETURN NEW;\n  END IF;\n  IF EXISTS (\n    SELECT 1 FROM offline.numbering_reservations r\n     WHERE r.tenant_id = NEW.tenant_id AND r.device_id = NEW.device_id\n       AND NULLIF(r.shift_id, 'stynx:no-shift') IS NOT DISTINCT FROM NULLIF(NEW.shift_id, 'stynx:no-shift')\n       AND r.id <> NEW.id AND r.status IN ('reserved', 'blocked') AND r.valid_until > clock_timestamp()\n       AND (NEW.reservation_origin = 'ctg9' OR r.reservation_origin = 'ctg9')\n  ) THEN\n    RAISE EXCEPTION USING ERRCODE = 'STY44',\n      MESSAGE = 'An active numbering reservation already exists for this device and shift.';\n  END IF;\n  RETURN NEW;\nEND\n$guard$;\n\nCREATE TRIGGER numbering_reservations_active_scope_guard\n  BEFORE INSERT OR UPDATE ON offline.numbering_reservations\n  FOR EACH ROW EXECUTE FUNCTION offline.guard_active_numbering_reservation();\n\nALTER TABLE offline.numbering_ranges ADD COLUMN consumer_attributes json\n  CHECK (consumer_attributes IS NULL OR (json_typeof(consumer_attributes) = 'object'\n    AND octet_length(consumer_attributes::text) <= 4096));\n\nALTER TABLE offline.numbering_ranges ADD COLUMN created_by text\n  CHECK (created_by IS NULL OR octet_length(created_by) BETWEEN 1 AND 255);\n\nALTER TABLE offline.numbering_ranges ADD COLUMN cancelled_by text\n  CHECK (cancelled_by IS NULL OR octet_length(cancelled_by) BETWEEN 1 AND 255);\n\nALTER TABLE offline.numbering_ranges ADD COLUMN cancellation_reason text\n  CHECK (cancellation_reason IS NULL OR octet_length(cancellation_reason) <= 500);\n\nALTER TABLE offline.numbering_ranges ADD COLUMN cancelled_at timestamptz;\n\nALTER TABLE offline.numbering_ranges ADD COLUMN creation_key text\n  CHECK (creation_key IS NULL OR octet_length(creation_key) BETWEEN 1 AND 255);\n\nALTER TABLE offline.numbering_ranges ADD COLUMN creation_fingerprint text\n  CHECK (creation_fingerprint IS NULL OR creation_fingerprint ~ '^sha256:[0-9a-f]{64}$');\n\nALTER TABLE offline.numbering_ranges ADD COLUMN creation_receipt jsonb\n  CHECK (creation_receipt IS NULL OR jsonb_typeof(creation_receipt) = 'object');\n\nALTER TABLE offline.numbering_ranges ADD CONSTRAINT numbering_ranges_creation_evidence_check\n  CHECK ((creation_key IS NULL AND creation_fingerprint IS NULL AND creation_receipt IS NULL)\n    OR (creation_key IS NOT NULL AND creation_fingerprint IS NOT NULL\n      AND creation_receipt IS NOT NULL AND created_by IS NOT NULL));\n\nALTER TABLE offline.numbering_ranges ADD CONSTRAINT numbering_ranges_cancellation_evidence_check\n  CHECK ((cancelled_by IS NULL AND cancelled_at IS NULL AND cancellation_reason IS NULL)\n    OR (cancelled_by IS NOT NULL AND cancelled_at IS NOT NULL AND isfinite(cancelled_at)\n      AND status = 'cancelled'));\n\nALTER TABLE offline.numbering_ranges ADD CONSTRAINT numbering_ranges_administered_cancellation_check\n  CHECK (created_by IS NULL OR status <> 'cancelled'\n    OR (cancelled_by IS NOT NULL AND cancelled_at IS NOT NULL));\n\nCREATE UNIQUE INDEX numbering_ranges_tenant_creation_key_uq\n  ON offline.numbering_ranges (tenant_id, creation_key) WHERE creation_key IS NOT NULL;\n\nCREATE FUNCTION offline.guard_numbering_range_history() RETURNS trigger\nLANGUAGE plpgsql SET search_path = pg_catalog AS $guard$\nDECLARE trusted_actor text := current_setting('app.actor_id', true);\nBEGIN\n  -- The whitespace set is ECMAScript String.trim(), matching Database.requireActor.\n  IF btrim(trusted_actor, E' \\t\\n\\r\\f\\013' ||\n      U&'\\00A0\\1680\\2000\\2001\\2002\\2003\\2004\\2005\\2006\\2007\\2008\\2009\\200A\\2028\\2029\\202F\\205F\\3000\\FEFF') = ''\n  THEN trusted_actor := NULL; END IF;\n  IF TG_OP = 'DELETE' THEN\n    IF OLD.created_by IS NOT NULL OR OLD.creation_key IS NOT NULL OR OLD.cancelled_by IS NOT NULL THEN\n      RAISE EXCEPTION USING ERRCODE = 'STY49', MESSAGE = 'Administered numbering range history cannot be deleted.';\n    END IF;\n    RETURN OLD;\n  END IF;\n  IF current_user <> pg_get_userbyid((SELECT relowner FROM pg_catalog.pg_class\n      WHERE oid = TG_RELID)) THEN\n    IF (TG_OP = 'INSERT' AND NEW.created_by IS NOT NULL\n        AND NEW.created_by IS DISTINCT FROM trusted_actor)\n      OR (((TG_OP = 'INSERT' AND NEW.cancelled_at IS NOT NULL)\n          OR (TG_OP = 'UPDATE' AND OLD.cancelled_at IS NULL AND NEW.cancelled_at IS NOT NULL))\n        AND NEW.cancelled_by IS DISTINCT FROM trusted_actor)\n    THEN\n      RAISE EXCEPTION USING ERRCODE = 'STY48', MESSAGE = 'Range provenance must use the trusted transaction actor.';\n    END IF;\n  END IF;\n  IF TG_OP = 'INSERT' THEN RETURN NEW; END IF;\n  IF ((OLD.created_by IS NOT NULL OR OLD.creation_key IS NOT NULL OR OLD.cancelled_by IS NOT NULL)\n      AND NEW.id IS DISTINCT FROM OLD.id)\n    OR NEW.created_at IS DISTINCT FROM OLD.created_at OR NEW.created_by IS DISTINCT FROM OLD.created_by\n    OR NEW.creation_key IS DISTINCT FROM OLD.creation_key\n    OR NEW.creation_fingerprint IS DISTINCT FROM OLD.creation_fingerprint\n    OR NEW.creation_receipt IS DISTINCT FROM OLD.creation_receipt\n    OR (OLD.cancelled_at IS NOT NULL AND (\n      NEW.cancelled_at IS DISTINCT FROM OLD.cancelled_at OR NEW.cancelled_by IS DISTINCT FROM OLD.cancelled_by\n      OR NEW.cancellation_reason IS DISTINCT FROM OLD.cancellation_reason))\n    OR (OLD.status = 'cancelled' AND NEW.status <> 'cancelled')\n    OR (OLD.created_by IS NOT NULL AND NEW.consumer_attributes::text IS DISTINCT FROM OLD.consumer_attributes::text)\n  THEN\n    RAISE EXCEPTION USING ERRCODE = 'STY48', MESSAGE = 'Numbering range provenance and terminal history are immutable.';\n  END IF;\n  IF (NEW.id IS DISTINCT FROM OLD.id OR NEW.tenant_id IS DISTINCT FROM OLD.tenant_id OR NEW.org_unit_id IS DISTINCT FROM OLD.org_unit_id\n    OR NEW.entity_type IS DISTINCT FROM OLD.entity_type OR NEW.series IS DISTINCT FROM OLD.series\n    OR NEW.start_number IS DISTINCT FROM OLD.start_number OR NEW.end_number IS DISTINCT FROM OLD.end_number)\n    AND EXISTS (SELECT 1 FROM offline.numbering_reservations r WHERE r.tenant_id = OLD.tenant_id AND r.range_id = OLD.id)\n  THEN\n    RAISE EXCEPTION USING ERRCODE = 'STY48', MESSAGE = 'Referenced numbering range bounds and scope are immutable.';\n  END IF;\n  RETURN NEW;\nEND\n$guard$;\n\nCREATE TRIGGER numbering_ranges_history_guard BEFORE INSERT OR UPDATE OR DELETE ON offline.numbering_ranges\n  FOR EACH ROW EXECUTE FUNCTION offline.guard_numbering_range_history();\n\nCREATE TABLE offline.sync_import_receipts (\n  source_identity_sha256 text PRIMARY KEY\n    CHECK (source_identity_sha256 ~ '^sha256:[0-9a-f]{64}$'),\n  source_system text NOT NULL CHECK (octet_length(source_system) BETWEEN 1 AND 255),\n  source_snapshot_id text NOT NULL CHECK (octet_length(source_snapshot_id) BETWEEN 1 AND 4096),\n  source_sha256 text NOT NULL CHECK (source_sha256 ~ '^sha256:[0-9a-f]{64}$'),\n  manifest_sha256 text NOT NULL CHECK (manifest_sha256 ~ '^sha256:[0-9a-f]{64}$'),\n  mapping_sha256 text NOT NULL CHECK (mapping_sha256 ~ '^sha256:[0-9a-f]{64}$'),\n  original_manifest jsonb NOT NULL CHECK (jsonb_typeof(original_manifest) = 'object'),\n  imported_by text NOT NULL CHECK (octet_length(imported_by) BETWEEN 1 AND 63),\n  imported_at timestamptz NOT NULL CHECK (isfinite(imported_at)),\n  receipt jsonb NOT NULL CHECK (jsonb_typeof(receipt) = 'object')\n);\n\nALTER TABLE offline.sync_import_receipts ENABLE ROW LEVEL SECURITY;\n\nALTER TABLE offline.sync_import_receipts FORCE ROW LEVEL SECURITY;\n\nCREATE FUNCTION offline.guard_sync_import_receipt() RETURNS trigger\nLANGUAGE plpgsql SET search_path = pg_catalog AS $guard$\nBEGIN\n  RAISE EXCEPTION USING ERRCODE = 'STY50', MESSAGE = 'Offline import receipts are append-only.';\nEND\n$guard$;\n\nCREATE TRIGGER sync_import_receipts_append_only BEFORE UPDATE OR DELETE ON offline.sync_import_receipts\n  FOR EACH ROW EXECUTE FUNCTION offline.guard_sync_import_receipt();\n\nALTER TABLE offline.sync_batches ADD COLUMN response_body_is_archived boolean NOT NULL DEFAULT false;\n\nCREATE FUNCTION offline.guard_archived_sync_batch() RETURNS trigger\nLANGUAGE plpgsql SET search_path = pg_catalog AS $guard$\nDECLARE table_owner name;\nBEGIN\n  IF TG_OP <> 'INSERT' AND OLD.response_body_is_archived THEN\n    IF TG_OP = 'DELETE' OR NEW IS DISTINCT FROM OLD THEN\n      RAISE EXCEPTION USING ERRCODE = 'STY51', MESSAGE = 'Verified archived batch responses are immutable.';\n    END IF;\n    RETURN NEW;\n  END IF;\n  IF TG_OP = 'DELETE' THEN RETURN OLD; END IF;\n  IF NEW.response_body_is_archived THEN\n    SELECT pg_get_userbyid(c.relowner) INTO table_owner FROM pg_class c WHERE c.oid=TG_RELID;\n    IF current_user <> table_owner THEN\n      RAISE EXCEPTION USING ERRCODE = 'STY52', MESSAGE = 'Archived response admission requires the actual table owner.';\n    END IF;\n    IF NEW.status <> 'closed' OR NEW.response_status IS DISTINCT FROM 201\n       OR NEW.response_body_bytes IS NULL OR NEW.lease_token IS NOT NULL OR NEW.lease_expires_at IS NOT NULL THEN\n      RAISE EXCEPTION USING ERRCODE = 'STY53', MESSAGE = 'Verified archived response lifecycle is invalid.';\n    END IF;\n  END IF;\n  RETURN NEW;\nEND\n$guard$;\n\nCREATE TRIGGER sync_batches_archive_guard BEFORE INSERT OR UPDATE OR DELETE ON offline.sync_batches\n  FOR EACH ROW EXECUTE FUNCTION offline.guard_archived_sync_batch();\n","packageVersion":"1.6.0","roleBindingsSql":"ALTER TABLE offline.numbering_ranges OWNER TO \"postgres\";\n\nALTER TABLE offline.numbering_reservations OWNER TO \"postgres\";\n\nALTER TABLE offline.sync_queue_items OWNER TO \"postgres\";\n\nALTER TABLE offline.sync_conflicts OWNER TO \"postgres\";\n\nALTER TABLE offline.sync_batches OWNER TO \"postgres\";\n\nALTER TABLE offline.sync_batch_transport_keys OWNER TO \"postgres\";\n\nALTER TABLE offline.sync_item_receipts OWNER TO \"postgres\";\n\nALTER TABLE offline.sync_item_attempts OWNER TO \"postgres\";\n\nALTER TABLE offline.numbering_consumption OWNER TO \"postgres\";\n\nALTER TABLE offline.sync_conflict_evidence OWNER TO \"postgres\";\n\nALTER TABLE offline.sync_conflict_actions OWNER TO \"postgres\";\n\nALTER TABLE offline.numbering_reservation_scopes OWNER TO \"postgres\";\n\nALTER TABLE offline.sync_import_receipts OWNER TO \"postgres\";\n\nALTER FUNCTION offline.guard_active_numbering_reservation() OWNER TO \"postgres\";\n\nALTER FUNCTION offline.guard_numbering_range_history() OWNER TO \"postgres\";\n\nALTER FUNCTION offline.guard_sync_import_receipt() OWNER TO \"postgres\";\n\nALTER FUNCTION offline.guard_archived_sync_batch() OWNER TO \"postgres\";\n\nALTER SCHEMA offline OWNER TO \"postgres\";\n\nDROP POLICY IF EXISTS offline_tenant_isolation ON offline.numbering_ranges;\n\nDROP POLICY IF EXISTS offline_tenant_isolation ON offline.numbering_ranges;\nDROP POLICY IF EXISTS offline_tenant_isolation__635a6e8a4070 ON offline.numbering_ranges;\nCREATE POLICY offline_tenant_isolation__635a6e8a4070 ON offline.numbering_ranges\n  FOR ALL\n  TO \"role_app_backend\" USING (tenant_id = NULLIF(current_setting('app.tenant_id', true), '')::uuid)\n  WITH CHECK (tenant_id = NULLIF(current_setting('app.tenant_id', true), '')::uuid);\n\nDROP POLICY IF EXISTS offline_tenant_isolation ON offline.numbering_reservations;\n\nDROP POLICY IF EXISTS offline_tenant_isolation ON offline.numbering_reservations;\nDROP POLICY IF EXISTS offline_tenant_isolation__635a6e8a4070 ON offline.numbering_reservations;\nCREATE POLICY offline_tenant_isolation__635a6e8a4070 ON offline.numbering_reservations\n  FOR ALL\n  TO \"role_app_backend\" USING (tenant_id = NULLIF(current_setting('app.tenant_id', true), '')::uuid)\n  WITH CHECK (tenant_id = NULLIF(current_setting('app.tenant_id', true), '')::uuid);\n\nDROP POLICY IF EXISTS offline_tenant_isolation ON offline.sync_queue_items;\n\nDROP POLICY IF EXISTS offline_tenant_isolation ON offline.sync_queue_items;\nDROP POLICY IF EXISTS offline_tenant_isolation__635a6e8a4070 ON offline.sync_queue_items;\nCREATE POLICY offline_tenant_isolation__635a6e8a4070 ON offline.sync_queue_items\n  FOR ALL\n  TO \"role_app_backend\" USING (tenant_id = NULLIF(current_setting('app.tenant_id', true), '')::uuid)\n  WITH CHECK (tenant_id = NULLIF(current_setting('app.tenant_id', true), '')::uuid);\n\nDROP POLICY IF EXISTS offline_tenant_isolation ON offline.sync_conflicts;\n\nDROP POLICY IF EXISTS offline_tenant_isolation ON offline.sync_conflicts;\nDROP POLICY IF EXISTS offline_tenant_isolation__635a6e8a4070 ON offline.sync_conflicts;\nCREATE POLICY offline_tenant_isolation__635a6e8a4070 ON offline.sync_conflicts\n  FOR ALL\n  TO \"role_app_backend\" USING (tenant_id = NULLIF(current_setting('app.tenant_id', true), '')::uuid)\n  WITH CHECK (tenant_id = NULLIF(current_setting('app.tenant_id', true), '')::uuid);\n\nREVOKE ALL ON SCHEMA offline FROM PUBLIC;\n\nREVOKE ALL ON ALL TABLES IN SCHEMA offline FROM PUBLIC;\n\nGRANT USAGE ON SCHEMA offline TO \"role_app_backend\";\n\nGRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA offline TO \"role_app_backend\";\n\nDROP POLICY IF EXISTS offline_tenant_isolation ON offline.sync_batches;\nDROP POLICY IF EXISTS offline_tenant_isolation__635a6e8a4070 ON offline.sync_batches;\nCREATE POLICY offline_tenant_isolation__635a6e8a4070 ON offline.sync_batches FOR ALL\n  TO \"role_app_backend\" USING (tenant_id = NULLIF(current_setting('app.tenant_id',true),'')::uuid)\n  WITH CHECK (tenant_id = NULLIF(current_setting('app.tenant_id',true),'')::uuid);\n\nDROP POLICY IF EXISTS offline_tenant_isolation ON offline.sync_batch_transport_keys;\nDROP POLICY IF EXISTS offline_tenant_isolation__635a6e8a4070 ON offline.sync_batch_transport_keys;\nCREATE POLICY offline_tenant_isolation__635a6e8a4070 ON offline.sync_batch_transport_keys FOR ALL\n  TO \"role_app_backend\" USING (tenant_id = NULLIF(current_setting('app.tenant_id',true),'')::uuid)\n  WITH CHECK (tenant_id = NULLIF(current_setting('app.tenant_id',true),'')::uuid);\n\nDROP POLICY IF EXISTS offline_tenant_isolation ON offline.sync_item_receipts;\nDROP POLICY IF EXISTS offline_tenant_isolation__635a6e8a4070 ON offline.sync_item_receipts;\nCREATE POLICY off