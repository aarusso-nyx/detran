\set ON_ERROR_STOP on
\pset tuples_only on
\pset format unaligned
BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY;
SET LOCAL timezone='UTC'; SET LOCAL row_security=on; SET LOCAL search_path=pg_catalog;
SELECT (current_database()='detran_r22_161_g03_upgrade' AND (SELECT oid::text FROM pg_database WHERE datname=current_database())='18767' AND (pg_control_system()).system_identifier::text='7696293464811719840' AND current_user='postgres' AND session_user='postgres' AND current_setting('port')='65462' AND current_setting('server_version_num')='180002' AND current_setting('transaction_read_only')='on' AND current_setting('row_security')='on' AND split_part(pg_read_file('postmaster.pid'),E'\n',1)='64859') AS identity_ok \gset
\if :identity_ok
\else
\quit 3
\endif
SELECT jsonb_build_object('kind','identity','database',current_database(),'oid',(SELECT oid::text FROM pg_database WHERE datname=current_database()),'systemIdentifier',(pg_control_system()).system_identifier::text,'dataDirectory',current_setting('data_directory'),'port',current_setting('port'),'currentUser',current_user,'sessionUser',session_user,'readOnly',current_setting('transaction_read_only'),'isolation',current_setting('transaction_isolation'),'timezone',current_setting('timezone'),'rowSecurity',current_setting('row_security'),'backendPid',pg_backend_pid(),'observedAtUtc',to_char(clock_timestamp() AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.US"Z"'))::text;
SELECT jsonb_build_object('kind','original-fresh-receipts','rows',jsonb_agg(to_jsonb(x) ORDER BY package COLLATE "C"))::text FROM (SELECT package::text,identity::text AS identity_sql_text,installed_by::text,installed_at::text AS installed_at_sql_text,to_char(installed_at AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.US"Z"') AS installed_at_utc FROM integration.stynx_storage_installations) x;
SELECT jsonb_build_object('kind','activity','rows',coalesce(jsonb_agg(to_jsonb(x) ORDER BY pid),'[]'))::text FROM (SELECT pid,datname,usename,application_name,state,client_addr::text,backend_type FROM pg_stat_activity WHERE backend_type='client backend') x;
ROLLBACK;
