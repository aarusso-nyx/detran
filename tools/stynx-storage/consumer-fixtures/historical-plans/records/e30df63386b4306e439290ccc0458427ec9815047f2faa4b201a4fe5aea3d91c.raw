\"], \"deferred\": false, \"onDelete\": \" \", \"onUpdate\": \" \", \"noInherit\": false, \"validated\": true, \"deferrable\": false, \"expression\": \"(source_sha256 ~ '^sha256:[0-9a-f]{64}$'::text)\", \"referencedTable\": null, \"referencedSchema\": null, \"referencedColumns\": null}}, {\"kind\": \"constraint\", \"name\": \"sync_import_receipts.sync_import_receipts_source_snapshot_id_check\", \"value\": {\"kind\": \"c\", \"match\": \" \", \"columns\": [\"source_snapshot_id\"], \"deferred\": false, \"onDelete\": \" \", \"onUpdate\": \" \", \"noInherit\": false, \"validated\": true, \"deferrable\": false, \"expression\": \"((octet_length(source_snapshot_id) >= 1) AND (octet_length(source_snapshot_id) <= 4096))\", \"referencedTable\": null, \"referencedSchema\": null, \"referencedColumns\": null}}, {\"kind\": \"constraint\", \"name\": \"sync_import_receipts.sync_import_receipts_source_system_check\", \"value\": {\"kind\": \"c\", \"match\": \" \", \"columns\": [\"source_system\"], \"deferred\": false, \"onDelete\": \" \", \"onUpdate\": \" \", \"noInherit\": false, \"validated\": true, \"deferrable\": false, \"expression\": \"((octet_length(source_system) >= 1) AND (octet_length(source_system) <= 255))\", \"referencedTable\": null, \"referencedSchema\": null, \"referencedColumns\": null}}, {\"kind\": \"constraint\", \"name\": \"sync_item_attempts.sync_item_attempts_pkey\", \"value\": {\"kind\": \"p\", \"match\": \" \", \"columns\": [\"tenant_id\", \"device_id\", \"device_batch_id\", \"queue_item_id\"], \"deferred\": false, \"onDelete\": \" \", \"onUpdate\": \" \", \"noInherit\": true, \"validated\": true, \"deferrable\": false, \"expression\": null, \"referencedTable\": null, \"referencedSchema\": null, \"referencedColumns\": null}}, {\"kind\": \"constraint\", \"name\": \"sync_item_attempts.sync_item_attempts_status_check\", \"value\": {\"kind\": \"c\", \"match\": \" \", \"columns\": [\"status\"], \"deferred\": false, \"onDelete\": \" \", \"onUpdate\": \" \", \"noInherit\": false, \"validated\": true, \"deferrable\": false, \"expression\": \"(status = ANY (ARRAY['received'::text, 'applied'::text, 'conflict'::text, 'rejected'::text, 'pending'::text]))\", \"referencedTable\": null, \"referencedSchema\": null, \"referencedColumns\": null}}, {\"kind\": \"constraint\", \"name\": \"sync_item_attempts.sync_item_attempts_tenant_id_device_id_device_batch_id_fkey\", \"value\": {\"kind\": \"f\", \"match\": \"s\", \"columns\": [\"tenant_id\", \"device_id\", \"device_batch_id\"], \"deferred\": false, \"onDelete\": \"a\", \"onUpdate\": \"a\", \"noInherit\": true, \"validated\": true, \"deferrable\": false, \"expression\": null, \"referencedTable\": \"sync_batches\", \"referencedSchema\": \"offline\", \"referencedColumns\": [\"tenant_id\", \"device_id\", \"device_batch_id\"]}}, {\"kind\": \"constraint\", \"name\": \"sync_item_attempts.sync_item_attempts_tenant_id_fkey\", \"value\": {\"kind\": \"f\", \"match\": \"s\", \"columns\": [\"tenant_id\"], \"deferred\": false, \"onDelete\": \"c\", \"onUpdate\": \"a\", \"noInherit\": true, \"validated\": true, \"deferrable\": false, \"expression\": null, \"referencedTable\": \"tenants\", \"referencedSchema\": \"auth\", \"referencedColumns\": [\"id\"]}}, {\"kind\": \"constraint\", \"name\": \"sync_item_receipts.sync_item_receipts_pkey\", \"value\": {\"kind\": \"p\", \"match\": \" \", \"columns\": [\"tenant_id\", \"idempotency_key\"], \"deferred\": false, \"onDelete\": \" \", \"onUpdate\": \" \", \"noInherit\": true, \"validated\": true, \"deferrable\": false, \"expression\": null, \"referencedTable\": null, \"referencedSchema\": null, \"referencedColumns\": null}}, {\"kind\": \"constraint\", \"name\": \"sync_item_receipts.sync_item_receipts_status_check\", \"value\": {\"kind\": \"c\", \"match\": \" \", \"columns\": [\"status\"], \"deferred\": false, \"onDelete\": \" \", \"onUpdate\": \" \", \"noInherit\": false, \"validated\": true, \"deferrable\": false, \"expression\": \"(status = ANY (ARRAY['received'::