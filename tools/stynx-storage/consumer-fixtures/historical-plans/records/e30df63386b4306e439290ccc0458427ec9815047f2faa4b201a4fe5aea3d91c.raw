 255))\", \"referencedTable\": null, \"referencedSchema\": null, \"referencedColumns\": null}}, {\"kind\": \"constraint\", \"name\": \"sync_queue_items.sync_queue_items_device_id_check\", \"value\": {\"kind\": \"c\", \"match\": \" \", \"columns\": [\"device_id\"], \"deferred\": false, \"onDelete\": \" \", \"onUpdate\": \" \", \"noInherit\": false, \"validated\": true, \"deferrable\": false, \"expression\": \"((octet_length(device_id) >= 1) AND (octet_length(device_id) <= 255))\", \"referencedTable\": null, \"referencedSchema\": null, \"referencedColumns\": null}}, {\"kind\": \"constraint\", \"name\": \"sync_queue_items.sync_queue_items_entity_type_check\", \"value\": {\"kind\": \"c\", \"match\": \" \", \"columns\": [\"entity_type\"], \"deferred\": false, \"onDelete\": \" \", \"onUpdate\": \" \", \"noInherit\": false, \"validated\": true, \"deferrable\": false, \"expression\": \"((octet_length(entity_type) >= 1) AND (octet_length(entity_type) <= 100))\", \"referencedTable\": null, \"referencedSchema\": null, \"referencedColumns\": null}}, {\"kind\": \"constraint\", \"name\": \"sync_queue_items.sync_queue_items_id_check\", \"value\": {\"kind\": \"c\", \"match\": \" \", \"columns\": [\"id\"], \"deferred\": false, \"onDelete\": \" \", \"onUpdate\": \" \", \"noInherit\": false, \"validated\": true, \"deferrable\": false, \"expression\": \"((octet_length(id) >= 1) AND (octet_length(id) <= 255))\", \"referencedTable\": null, \"referencedSchema\": null, \"referencedColumns\": null}}, {\"kind\": \"constraint\", \"name\": \"sync_queue_items.sync_queue_items_idempotency_key_check\", \"value\": {\"kind\": \"c\", \"match\": \" \", \"columns\": [\"idempotency_key\"], \"deferred\": false, \"onDelete\": \" \", \"onUpdate\": \" \", \"noInherit\": false, \"validated\": true, \"deferrable\": false, \"expression\": \"((octet_length(idempotency_key) >= 1) AND (octet_length(idempotency_key) <= 255))\", \"referencedTable\": null, \"referencedSchema\": null, \"referencedColumns\": null}}, {\"kind\": \"constraint\", \"name\": \"sync_queue_items.sync_queue_items_identity_mode_check\", \"value\": {\"kind\": \"c\", \"match\": \" \", \"columns\": [\"identity_mode\"], \"deferred\": false, \"onDelete\": \" \", \"onUpdate\": \" \", \"noInherit\": false, \"validated\": true, \"deferrable\": false, \"expression\": \"(identity_mode = ANY (ARRAY['e6'::text, 'ctg9'::text]))\", \"referencedTable\": null, \"referencedSchema\": null, \"referencedColumns\": null}}, {\"kind\": \"constraint\", \"name\": \"sync_queue_items.sync_queue_items_local_entity_id_check\", \"value\": {\"kind\": \"c\", \"match\": \" \", \"columns\": [\"local_entity_id\"], \"deferred\": false, \"onDelete\": \" \", \"onUpdate\": \" \", \"noInherit\": false, \"validated\": true, \"deferrable\": false, \"expression\": \"((octet_length(local_entity_id) >= 1) AND (octet_length(local_entity_id) <= 255))\", \"referencedTable\": null, \"referencedSchema\": null, \"referencedColumns\": null}}, {\"kind\": \"constraint\", \"name\": \"sync_queue_items.sync_queue_items_org_unit_id_check\", \"value\": {\"kind\": \"c\", \"match\": \" \", \"columns\": [\"org_unit_id\"], \"deferred\": false, \"onDelete\": \" \", \"onUpdate\": \" \", \"noInherit\": false, \"validated\": true, \"deferrable\": false, \"expression\": \"((octet_length(org_unit_id) >= 1) AND (octet_length(org_unit_id) <= 255))\", \"referencedTable\": null, \"referencedSchema\": null, \"referencedColumns\": null}}, {\"kind\": \"constraint\", \"name\": \"sync_queue_items.sync_queue_items_payload_hash_check\", \"value\": {\"kind\": \"c\", \"match\": \" \", \"columns\": [\"payload_hash\"], \"deferred\": false, \"onDelete\": \" \", \"onUpdate\": \" \", \"noInherit\": false, \"validated\": true, \"deferrable\": false, \"expression\": \"(payload_hash ~ '^sha256:[0-9a-f]{64}$'::text)\", \"referencedTable\": null, \"referencedSchema\": null, \"referencedColumns\": null}}, {\"kind\": \"constraint\", \"name\": \"sync_queue_items.sync_queue_items_payload_json_check\", \"value\": {\"kind\": \"c\", \"match\": \" \", \"columns\": [\"payload_json\"], \"deferred\": false, \"onDelete\": \" \", \"onUpdate\": \" \", \"noInherit\": false, \"validated\": true, \"deferrable\": false, \"expression\": \"(jsonb_typeof(payload_json) = 'object'::text)\", \"referencedTable\": null, \"referencedSchema\": null, \"referencedColumns\": null}}, {\"kind\": \"constraint\", \"name\": \"sync_queue_items.sync_queue_items_pkey\", \"value\": {\"kind\": \"p\", \"match\": \" \", \"columns\": [\"tenant_id\", \"id\"], \"deferred\": false, \"onDelete\": \" \", \"onUpdate\": \" \", \"noInherit\": true, \"validated\": true, \"deferrable\": false, \"expression\": null, \"referencedTable\": null, \"referencedSchema\": null, \"referencedColumns\": null}}, {\"kind\": \"constraint\", \"name\": \"sync_queue_items.sync_queue_items_status_check\", \"value\": {\"kind\": \"c\", \"match\": \" \", \"columns\": [\"status\"], \"deferred\": false, \"onDelete\": \" \", \"onUpdate\": \" \", \"noInherit\": false, \"validated\": true, \"deferrable\": false, \"expression\": \"(status = ANY (ARRAY['received'::text, 'applied'::text, 'conflict'::text, 'rejected'::text, 'pending'::text]))\", \"referencedTable\": null, \"referencedSchema\": null, \"referencedColumns\": null}}, {\"kind\": \"constraint\", \"name\": \"sync_queue_items.sync_queue_items_tenant_id_fkey\", \"value\": {\"kind\": \"f\", \"match\": \"s\", \"columns\": [\"tenant_id\"], \"deferred\": false, \"onDelete\": \"c\", \"onUpdate\": \"a\", \"noInherit\": true, \"validated\": true, \"deferrable\": false, \"expression\": null, \"referencedTable\": \"tenants\", \"referencedSchema\": \"auth\", \"referencedColumns\": [\"id\"]}}, {\"kind\": \"constraint\", \"name\": \"sync_queue_items.sync_queue_items_tenant_id_idempotency_key_key\", \"value\": {\"kind\": \"u\", \"match\": \" \", \"columns\": [\"tenant_id\", \"idempotency_key\"], \"deferred\": false, \"onDelete\": \" \", \"onUpdate\": \" \", \"noInherit\": true, \"validated\": true, \"deferrable\": false, \"expression\": null, \"referencedTable\": null, \"referencedSchema\": null, \"referencedColumns\": null}}, {\"kind\": \"function\", \"name\": \"guard_active_numbering_reservation()\", \"value\": {\"owner\": \"postgres\", \"config\": [\"search_path=pg_catalog\"], \"strict\": false, \"parallel\": \"u\", \"leakproof\": false, \"definition\": \"CREATE OR REPLACE FUNCTION offline.guard_active_numbering_reservation()\\n RETURNS trigger\\n LANGUAGE plpgsql\\n SET search_path TO 'pg_catalog'\\nAS $function$\\nBEGIN\\n  IF TG_OP = 'UPDATE' AND (\\n    NEW.reservation_origin IS DISTINCT FROM OLD.reservation_origin OR\\n    NEW.tenant_id IS DISTINCT FROM OLD.tenant_id OR\\n    NEW.device_id IS DISTINCT FROM OLD.device_id OR\\n    NEW.shift_id IS DISTINCT FROM OLD.shift_id\\n  ) THEN\\n    RAISE EXCEPTION USING ERRCODE = 'STY46', MESSAGE = 'Numbering reservation scope and origin are immutable.';\\n  END IF;\\n  IF NEW.status NOT IN ('reserved', 'blocked') OR NEW.valid_until <= clock_timestamp() THEN\\n    RETURN NEW;\\n  END IF;\\n  PERFORM pg_advisory_xact_lock(hashtextextended(\\n    'stynx-offline-active:' || jsonb_build_array(NEW.tenant_id::text, NEW.device_id,\\n      NULLIF(NEW.shift_id, 'stynx:no-shift'))::text, 0));\\n  INSERT INTO offline.numbering_reservation_scopes (tenant_id, device_id, shift_scope, generation)\\n    VALUES (NEW.tenant_id, NEW.device_id,\\n      jsonb_build_array(NULLIF(NEW.shift_id, 'stynx:no-shift'))::text, gen_random_uuid())\\n    ON CONFLICT (tenant_id, device_id, shift_scope)\\n    DO UPDATE SET generation = gen_random_uuid();\\n  IF NEW.valid_until <= clock_timestamp() THEN\\n    RETURN NEW;\\n  END IF;\\n  IF EXISTS (\\n    SELECT 1 FROM offline.numbering_reservations r\\n     WHERE r.tenant_id = NEW.tenant_id AND r.device_id = NEW.device_id\\n       AND NULLIF(r.shift_id, 'stynx:no-shift') IS NOT DISTINCT FROM NULLIF(NEW.shift_id, 'stynx:no-shift')\\n       AND r.id <> NEW.id AND r.status IN ('reserved', 'blocked') AND r.valid_until > clock_timestamp()\\n       AND (NEW.reservation_origin = 'ctg9' OR r.reservation_origin = 'ctg9')\\n  ) THEN\\n    RAISE EXCEPTION USING ERRCODE = 'STY44',\\n      MESSAGE = 'An active numbering reservation already exists for this device and shift.';\\n  END IF;\\n  RETURN NEW;\\nEND\\n$function$\\n\", \"volatility\": \"v\", \"securityDefiner\": false}}, {\"kind\": \"function\", \"name\": \"guard_archived_sync_batch()\", \"value\": {\"owner\": \"postgres\", \"config\": [\"search_path=pg_catalog\"], \"strict\": false, \"parallel\": \"u\", \"leakproof\": false, \"definition\": \"CREATE OR REPLACE FUNCTION offline.guard_archived_sync_batch()\\n RETURNS trigger\\n LANGUAGE plpgsql\\n SET search_path TO 'pg_catalog'\\nAS $function$\\nDECLARE table_owner name;\\nBEGIN\\n  IF TG_OP <> 'INSERT' AND OLD.response_body_is_archived THEN\\n    IF TG_OP = 'DELETE' OR NEW IS DISTINCT FROM OLD THEN\\n      RAISE EXCEPTION USING ERRCODE = 'STY51', MESSAGE = 'Verified archived batch responses are immutable.';\\n    END IF;\\n    RETURN NEW;\\n  END IF;\\n  IF TG_OP = 'DELETE' THEN RETURN OLD; END IF;\\n  IF NEW.response_body_is_archived THEN\\n    SELECT pg_get_userbyid(c.relowner) INTO table_owner FROM pg_class c WHERE c.oid=TG_RELID;\\n    IF current_user <> table_owner THEN\\n      RAISE EXCEPTION USING ERRCODE = 'STY52', MESSAGE = 'Archived response admission requires the actual table owner.';\\n    END IF;\\n    IF NEW.status <> 'closed' OR NEW.response_status IS DISTINCT FROM 201\\n       OR NEW.response_body_bytes IS NULL OR NEW.lease_token IS NOT NULL OR NEW.lease_expires_at IS NOT NULL THEN\\n      RAISE EXCEPTION USING ERRCODE = 'STY53', MESSAGE = 'Verified archived response lifecycle is invalid.';\\n    END IF;\\n  END IF;\\n  RETURN NEW;\\nEND\\n$function$\\n\", \"volatility\": \"v\", \"securityDefiner\": false}}, {\"kind\": \"function\", \"name\": \"guard_numbering_range_history()\", \"value\": {\"owner\": \"postgres\", \"config\": [\"search_path=pg_catalog\"], \"strict\": false, \"parallel\": \"u\", \"leakproof\": false, \"definition\": \"CREATE OR REPLACE FUNCTION offline.guard_numbering_range_history()\\n RETURNS trigger\\n LANGUAGE plpgsql\\n SET search_path TO 'pg_catalog'\\nAS $function$\\nDECLARE trusted_actor text := current_setting('app.actor_id', true);\\nBEGIN\\n  -- The whitespace set is ECMAScript String.trim(), matching Database.requireActor.\\n  IF btrim(trusted_actor, E' \\\\t\\\\n\\\\r\\\\f\\\\013' ||\\n      U&'\\\\00A0\\\\1680\\\\2000\\\\2001\\\\2002\\\\2003\\\\2004\\\\2005\\\\2006\\\\2007\\\\2008\\\\2009\\\\200A\\\\2028\\\\2029\\\\202F\\\\205F\\\\3000\\\\FEFF') = ''\\n  THEN trusted_actor := NULL; END IF;\\n  IF TG_OP = 'DELETE' THEN\\n    IF OLD.created_by IS NOT NULL OR OLD.creation_key IS NOT NULL OR OLD.cancelled_by IS NOT NULL THEN\\n      RAISE EXCEPTION USING ERRCODE = 'STY49', MESSAGE = 'Administered numbering range history cannot be deleted.';\\n    END IF;\\n    RETURN OLD;\\n  END IF;\\n  IF current_user <> pg_get_userbyid((SELECT relowner FROM pg_catalog.pg_class\\n      WHERE oid = TG_RELID)) THEN\\n    IF (TG_OP = 'INSERT' AND NEW.created_by IS NOT NULL\\n        AND NEW.created_by IS DISTINCT FROM trusted_actor)\\n      OR (((TG_OP = 'INSERT' AND NEW.cancelled_at IS NOT NULL)\\n          OR (TG_OP = 'UPDATE' AND OLD.cancelled_at IS NULL AND NEW.cancelled_at IS NOT NULL))\\n        AND NEW.cancelled_by IS DISTINCT FROM trusted_actor)\\n    THEN\\n      RAISE EXCEPTION USING ERRCODE = 'STY48', MESSAGE = 'Range provenance must use the trusted transaction actor.';\\n    END IF;\\n  END IF;\\n  IF TG_OP = 'INSERT' THEN RETURN NEW; END IF;\\n  IF ((OLD.created_by IS NOT NULL OR OLD.creation_key IS NOT NULL OR OLD.cancelled_by IS NOT NULL)\\n      AND NEW.id IS DISTINCT FROM OLD.id)\\n    OR NEW.created_at IS DISTINCT FROM OLD.created_at OR NEW.created_by IS DISTINCT FROM OLD.created_by\\n    OR NEW.creation_key IS DISTINCT FROM OLD.creation_key\\n    OR NEW.creation_fingerprint IS DISTINCT FROM OLD.creation_fingerprint\\n    OR NEW.creation_receipt IS DISTINCT FROM OLD.creation_receipt\\n    OR (OLD.cancelled_at IS NOT NULL AND (\\n      NEW.cancelled_at IS DISTINCT FROM OLD.cancelled_at OR NEW.cancelled_by IS DISTINCT FROM OLD.cancelled_by\\n      OR NEW.cancellation_reason IS DISTINCT FROM OLD.cancellation_reason))\\n    OR (OLD.status = 'cancelled' AND NEW.status <> 'cancelled')\\n    OR (OLD.created_by IS NOT NULL AND NEW.consumer_attributes::text IS DISTINCT FROM OLD.consumer_attributes::text)\\n  THEN\\n    RAISE EXCEPTION USING ERRCODE = 'STY48', MESSAGE = 'Numbering range provenance and terminal history are immutable.';\\n  END IF;\\n  IF (NEW.id IS DISTINCT FROM OLD.id OR NEW.tenant_id IS DISTINCT FROM OLD.tenant_id OR NEW.org_unit_id IS DISTINCT FROM OLD.org_unit_id\\n    OR NEW.entity_type IS DISTINCT FROM OLD.entity_type OR NEW.series IS DISTINCT FROM OLD.series\\n    OR NEW.start_number IS DISTINCT FROM OLD.start_number OR NEW.end_number IS DISTINCT FROM OLD.end_number)\\n    AND EXISTS (SELECT 1 FROM offline.numbering_reservations r WHERE r.tenant_id = OLD.tenant_id AND r.range_id = OLD.id)\\n  THEN\\n    RAISE EXCEPTION USING ERRCODE = 'STY48', MESSAGE = 'Referenced numbering range bounds and scope are immutable.';\\n  END IF;\\n  RETURN NEW;\\nEND\\n$function$\\n\", \"volatility\": \"v\", \"securityDefiner\": false}}, {\"kind\": \"function\", \"name\": \"guard_sync_import_receipt()\", \"value\": {\"owner\": \"postgres\", \"config\": [\"search_path=pg_catalog\"], \"strict\": false, \"parallel\": \"u\", \"leakproof\": false, \"definition\": \"CREATE OR REPLACE FUNCTION offline.guard_sync_import_receipt()\\n RETURNS trigger\\n LANGUAGE plpgsql\\n SET search_path TO 'pg_catalog'\\nAS $function$\\nBEGIN\\n  RAISE EXCEPTION USING ERRCODE = 'STY50', MESSAGE = 'Offline import receipts are append-only.';\\nEND\\n$function$\\n\", \"volatility\": \"v\", \"securityDefiner\": false}}, {\"kind\": \"grant\", \"name\": \"guard_active_numbering_reservation():postgres:EXECUTE\", \"value\": {\"object\": \"guard_active_numbering_reservation()\", \"grantee\": \"postgres\", \"grantable\": false, \"privilege\": \"EXECUTE\"}}, {\"kind\": \"grant\", \"name\": \"guard_archived_sync_batch():postgres:EXECUTE\", \"value\": {\"object\": \"guard_archived_sync_batch()\", \"grantee\": \"postgres\", \"grantable\": false, \"privilege\": \"EXECUTE\"}}, {\"kind\": \"grant\", \"name\": \"guard_numbering_range_history():postgres:EXECUTE\", \"value\": {\"object\": \"guard_numbering_range_history()\", \"grantee\": \"postgres\", \"grantable\": false, \"privilege\": \"EXECUTE\"}}, {\"kind\": \"grant\", \"name\": \"guard_sync_import_receipt():postgres:EXECUTE\", \"value\": {\"object\": \"guard_sync_import_receipt()\", \"grantee\": \"postgres\", \"grantable\": false, \"privilege\": \"EXECUTE\"}}, {\"kind\": \"grant\", \"name\": \"numbering_consumption:role_app_backend:DELETE\", \"value\": {\"object\": \"numbering_consumption\", \"grantee\": \"role_app_backend\", \"grantable\": false, \"privilege\": \"DELETE\"}}, {\"kind\": \"grant\", \"name\": \"numbering_consumption:role_app_backend:INSERT\", \"value\": {\"object\": \"numbering_consumption\", \"grantee\": \"role_app_backend\", \"grantable\": false, \"privilege\": \"INSERT\"}}, {\"kind\": \"grant\", \"name\": \"numbering_consumption:role_app_backend:SELECT\", \"value\": {\"object\": \"numbering_consumption\", \"grantee\": \"role_app_backend\", \"grantable\": false, \"privilege\": \"SELECT\"}}, {\"kind\": \"grant\", \"name\": \"numbering_consumption:role_app_backend:UPDATE\", \"value\": {\"object\": \"numbering_consumption\", \"grantee\": \"role_app_backend\", \"grantable\": false, \"privilege\": \"UPDATE\"}}, {\"kind\": \"grant\", \"name\": \"numbering_consumption:postgres:DELETE\", \"value\": {\"object\": \"numbering_consumption\", \"grantee\": \"postgres\", \"grantable\": false, \"privilege\": \"DELETE\"}}, {\"kind\": \"grant\", \"name\": \"numbering_consumption:postgres:INSERT