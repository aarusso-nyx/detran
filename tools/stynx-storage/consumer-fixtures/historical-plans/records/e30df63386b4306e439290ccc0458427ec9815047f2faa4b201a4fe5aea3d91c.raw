f\", \"match\": \"s\", \"columns\": [\"tenant_id\"], \"deferred\": false, \"onDelete\": \"a\", \"onUpdate\": \"a\", \"noInherit\": true, \"validated\": true, \"deferrable\": false, \"expression\": null, \"referencedTable\": \"tenants\", \"referencedSchema\": \"auth\", \"referencedColumns\": [\"id\"]}}, {\"kind\": \"default-grant\", \"name\": \"postgres:r:role_app_backend:DELETE\", \"value\": {\"kind\": \"r\", \"owner\": \"postgres\", \"grantee\": \"role_app_backend\", \"grantable\": false, \"privilege\": \"DELETE\"}}, {\"kind\": \"default-grant\", \"name\": \"postgres:r:role_app_backend:INSERT\", \"value\": {\"kind\": \"r\", \"owner\": \"postgres\", \"grantee\": \"role_app_backend\", \"grantable\": false, \"privilege\": \"INSERT\"}}, {\"kind\": \"default-grant\", \"name\": \"postgres:r:role_app_backend:SELECT\", \"value\": {\"kind\": \"r\", \"owner\": \"postgres\", \"grantee\": \"role_app_backend\", \"grantable\": false, \"privilege\": \"SELECT\"}}, {\"kind\": \"default-grant\", \"name\": \"postgres:r:role_app_backend:UPDATE\", \"value\": {\"kind\": \"r\", \"owner\": \"postgres\", \"grantee\": \"role_app_backend\", \"grantable\": false, \"privilege\": \"UPDATE\"}}, {\"kind\": \"default-grant\", \"name\": \"postgres:S:role_app_backend:SELECT\", \"value\": {\"kind\": \"S\", \"owner\": \"postgres\", \"grantee\": \"role_app_backend\", \"grantable\": false, \"privilege\": \"SELECT\"}}, {\"kind\": \"default-grant\", \"name\": \"postgres:S:role_app_backend:USAGE\", \"value\": {\"kind\": \"S\", \"owner\": \"postgres\", \"grantee\": \"role_app_backend\", \"grantable\": false, \"privilege\": \"USAGE\"}}, {\"kind\": \"enum\", \"name\": \"ack_status\", \"value\": {\"owner\": \"postgres\", \"labels\": [\"ACKED\", \"ERROR\"]}}, {\"kind\": \"enum\", \"name\": \"message_status\", \"value\": {\"owner\": \"postgres\", \"labels\": [\"PENDING\", \"SENT\", \"ACKED\", \"ERROR\"]}}, {\"kind\": \"function\", \"name\": \"event_uuid(p_ms bigint, p_order bigint)\", \"value\": {\"owner\": \"postgres\", \"config\": null, \"strict\": true, \"parallel\": \"u\", \"leakproof\": false, \"definition\": \"CREATE OR REPLACE FUNCTION outbox.event_uuid(p_ms bigint, p_order bigint)\\n RETURNS uuid\\n LANGUAGE sql\\n IMMUTABLE STRICT\\nAS $function$\\n  SELECT (\\n    substr(lpad(to_hex(p_ms),12,'0'),1,8) || '-' ||\\n    substr(lpad(to_hex(p_ms),12,'0'),9,4) || '-' ||\\n    '7' || lpad(to_hex(p_order >> 62),3,'0') || '-' ||\\n    substr('89ab',((p_order >> 60) & 3)::integer + 1,1) ||\\n    substr(lpad(to_hex(p_order & 1152921504606846975),15,'0'),1,3) || '-' ||\\n    substr(lpad(to_hex(p_order & 1152921504606846975),15,'0'),4,12)\\n  )::uuid;\\n$function$\\n\", \"volatility\": \"i\", \"securityDefiner\": false}}, {\"kind\": \"function\", \"name\": \"guard_app_attempt_completion()\", \"value\": {\"owner\": \"postgres\", \"config\": [\"search_path=pg_catalog, outbox\"], \"strict\": false, \"parallel\": \"u\", \"leakproof\": false, \"definition\": \"CREATE OR REPLACE FUNCTION outbox.guard_app_attempt_completion()\\n RETURNS trigger\\n LANGUAGE plpgsql\\n SET search_path TO 'pg_catalog', 'outbox'\\nAS $function$\\nDECLARE\\n  table_owner oid;\\n  acting_role oid;\\nBEGIN\\n  SELECT c.relowner INTO table_owner FROM pg_catalog.pg_class c WHERE c.oid = TG_RELID;\\n  SELECT r.oid INTO acting_role FROM pg_catalog.pg_roles r WHERE r.rolname = current_user;\\n  IF acting_role IS DISTINCT FROM table_owner THEN\\n    IF OLD.result IS DISTINCT FROM 'CLAIMED'\\n       OR OLD.completed_at IS NOT NULL\\n       OR NEW.result NOT IN ('SENT','ERROR')\\n       OR NEW.completed_at IS NULL\\n       OR NEW.tenant_id IS DISTINCT FROM OLD.tenant_id\\n       OR NEW.event_id IS DISTINCT FROM OLD.event_id\\n       OR NEW.attempt_ordinal IS DISTINCT FROM OLD.attempt_ordinal\\n       OR NEW.legacy_message_id IS DISTINCT FROM OLD.legacy_message_id\\n       OR NEW.legacy_state IS DISTINCT FROM OLD.legacy_state THEN\\n      RAISE EXCEPTION 'completed or legacy attempt evidence is immutable outside the table owner'\\n        USING ERRCODE = '42501';\\n    END IF;\\n  END IF;\\n  RETURN NEW;\\nEND $function$\\n\", \"volatility\": \"v\", \"securityDefiner\": false}}, {\"kind\": \"function\", \"name\": \"reject_event_mutation()\", \"value\": {\"owner\": \"postgres\", \"config\": null, \"strict\": false, \"parallel\": \"u\", \"leakproof\": false, \"definition\": \"CREATE OR REPLACE FUNCTION outbox.reject_event_mutation()\\n RETURNS trigger\\n LANGUAGE plpgsql\\nAS $function$\\nBEGIN\\n  RAISE EXCEPTION 'outbox_event_immutable' USING ERRCODE='STY42';\\nEND $function$\\n\", \"volatility\": \"v\", \"securityDefiner\": false}}, {\"kind\": \"function\", \"name\": \"reject_retirement_mutation()\", \"value\": {\"owner\": \"postgres\", \"config\": [\"search_path=pg_catalog, outbox\"], \"strict\": false, \"parallel\": \"u\", \"leakproof\": false, \"definition\": \"CREATE OR REPLACE FUNCTION outbox.reject_retirement_mutation()\\n RETURNS trigger\\n LANGUAGE plpgsql\\n SET search_path TO 'pg_catalog', 'outbox'\\nAS $function$\\nBEGIN\\n  RAISE EXCEPTION 'outbox_retirement_immutable' USING ERRCODE='STY43';\\nEND $function$\\n\", \"volatility\": \"v\", \"securityDefiner\": false}}, {\"kind\": \"grant\", \"name\": \"ack_quarantine:postgres:DELETE\", \"value\": {\"object\": \"ack_quarantine\", \"grantee\": \"postgres\", \"grantable\": false, \"privilege\": \"DELETE\"}}, {\"kind\": \"grant\", \"name\": \"ack_quarantine:postgres:INSERT\", \"value\": {\"object\": \"ack_quarantine\", \"grantee\": \"postgres\", \"grantable\": false, \"privilege\": \"INSERT\"}}, {\"kind\": \"grant\", \"name\": \"ack_quarantine:postgres:REFERENCES\", \"value\": {\"object\": \"ack_quarantine\", \"grantee\": \"postgres\", \"grantable\": false, \"privilege\": \"REFERENCES\"}}, {\"kind\": \"grant\", \"name\": \"ack_quarantine:postgres:SELECT\", \"value\": {\"object\": \"ack_quarantine\", \"grantee\": \"postgres\", \"grantable\": false, \"privilege\": \"SELECT\"}}, {\"kind\": \"grant\", \"name\": \"ack_quaran