c_queue_items.sync_queue_items_payload_hash_check","value":{"columns":["payload_hash"],"deferrable":false,"deferred":false,"expression":"(payload_hash ~ '^sha256:[0-9a-f]{64}$'::text)","kind":"c","match":" ","noInherit":false,"onDelete":" ","onUpdate":" ","referencedColumns":null,"referencedSchema":null,"referencedTable":null,"validated":true}},{"kind":"constraint","name":"sync_queue_items.sync_queue_items_payload_json_check","value":{"columns":["payload_json"],"deferrable":false,"deferred":false,"expression":"(jsonb_typeof(payload_json) = 'object'::text)","kind":"c","match":" ","noInherit":false,"onDelete":" ","onUpdate":" ","referencedColumns":null,"referencedSchema":null,"referencedTable":null,"validated":true}},{"kind":"constraint","name":"sync_queue_items.sync_queue_items_pkey","value":{"columns":["tenant_id","id"],"deferrable":false,"deferred":false,"expression":null,"kind":"p","match":" ","noInherit":true,"onDelete":" ","onUpdate":" ","referencedColumns":null,"referencedSchema":null,"referencedTable":null,"validated":true}},{"kind":"constraint","name":"sync_queue_items.sync_queue_items_status_check","value":{"columns":["status"],"deferrable":false,"deferred":false,"expression":"(status = ANY (ARRAY['received'::text, 'applied'::text, 'conflict'::text, 'rejected'::text, 'pending'::text]))","kind":"c","match":" ","noInherit":false,"onDelete":" ","onUpdate":" ","referencedColumns":null,"referencedSchema":null,"referencedTable":null,"validated":true}},{"kind":"constraint","name":"sync_queue_items.sync_queue_items_tenant_id_fkey","value":{"columns":["tenant_id"],"deferrable":false,"deferred":false,"expression":null,"kind":"f","match":"s","noInherit":true,"onDelete":"c","onUpdate":"a","referencedColumns":["id"],"referencedSchema":"auth","referencedTable":"tenants","validated":true}},{"kind":"constraint","name":"sync_queue_items.sync_queue_items_tenant_id_idempotency_key_key","value":{"columns":["tenant_id","idempotency_key"],"deferrable":false,"deferred":false,"expression":null,"kind":"u","match":" ","noInherit":true,"onDelete":" ","onUpdate":" ","referencedColumns":null,"referencedSchema":null,"referencedTable":null,"validated":true}},{"kind":"function","name":"guard_active_numbering_reservation()","value":{"config":["search_path=pg_catalog"],"definition":"CREATE OR REPLACE FUNCTION offline.guard_active_numbering_reservation()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'pg_catalog'\nAS $function$\nBEGIN\n  IF TG_OP = 'UPDATE' AND (\n    NEW.reservation_origin IS DISTINCT FROM OLD.reservation_origin OR\n    NEW.tenant_id IS DISTINCT FROM OLD.tenant_id OR\n    NEW.device_id IS DISTINCT FROM OLD.device_id OR\n    NEW.shift_id IS DISTINCT FROM OLD.shift_id\n  ) THEN\n    RAISE EXCEPTION USING ERRCODE = 'STY46', MESSAGE = 'Numbering reservation scope and origin are immutable.';\n  END IF;\n  IF NEW.status NOT IN ('reserved', 'blocked') OR NEW.valid_until <= clock_timestamp() THEN\n    RETURN NEW;\n  END IF;\n  PERFORM pg_advisory_xact_lock(hashtextextended(\n    'stynx-offline-active:' || jsonb_build_array(NEW.tenant_id::text, NEW.device_id,\n      NULLIF(NEW.shift_id, 'stynx:no-shift'))::text, 0));\n  INSERT INTO offline.numbering_reservation_scopes (tenant_id, device_id, shift_scope, generation)\n    VALUES (NEW.tenant_id, NEW.device_id,\n      jsonb_build_array(NULLIF(NEW.shift_id, 'stynx:no-shift'))::text, gen_random_uuid())\n    ON CONFLICT (tenant_id, device_id, shift_scope)\n    DO UPDATE SET generation = gen_random_uuid();\n  IF NEW.valid_until <= clock_timestamp() THEN\n    RETURN NEW;\n  END IF;\n  IF EXISTS (\n    SELECT 1 FROM offline.numbering_reservations r\n     WHERE r.tenant_id = NEW.tenant_id AND r.device_id = NEW.device_id\n       AND NULLIF(r.shift_id, 'stynx:no-shift') IS NOT DISTINCT FROM NULLIF(NEW.shift_id, 'stynx:no-shift')\n       AND r.id <> NEW.id AND r.status IN ('reserved', 'blocked') AND r.valid_until > clock_timestamp()\n       AND (NEW.reservation_origin = 'ctg9' OR r.reservation_origin = 'ctg9')\n  ) THEN\n    RAISE EXCEPTION USING ERRCODE = 'STY44',\n      MESSAGE = 'An active numbering reservation already exists for this device and shift.';\n  END IF;\n  RETURN NEW;\nEND\n$function$\n","leakproof":false,"owner":"postgres","parallel":"u","securityDefiner":false,"strict":false,"volatility":"v"}},{"kind":"function","name":"guard_archived_sync_batch()","value":{"config":["search_path=pg_catalog"],"definition":"CREATE OR REPLACE FUNCTION offline.guard_archived_sync_batch()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'pg_catalog'\nAS $function$\nDECLARE table_owner name;\nBEGIN\n  IF TG_OP <> 'INSERT' AND OLD.response_body_is_archived THEN\n    IF TG_OP = 'DELETE' OR NEW IS DISTINCT FROM OLD THEN\n      RAISE EXCEPTION USING ERRCODE = 'STY51', MESSAGE = 'Verified archived batch responses are immutable.';\n    END IF;\n    RETURN NEW;\n  END IF;\n  IF TG_OP = 'DELETE' THEN RETURN OLD; END IF;\n  IF NEW.response_body_is_archived THEN\n    SELECT pg_get_userbyid(c.relowner) INTO table_owner FROM pg_class c WHERE c.oid=TG_RELID;\n    IF current_user <> table_owner THEN\n      RAISE EXCEPTION USING ERRCODE = 'STY52', MESSAGE = 'Archived response admission requires the actual table owner.';\n    END IF;\n    IF NEW.status <> 'closed' OR NEW.response_status IS DISTINCT FROM 201\n       OR NEW.response_body_bytes IS NULL OR NEW.lease_token IS NOT NULL OR NEW.lease_expires_at IS NOT NULL THEN\n      RAISE EXCEPTION USING ERRCODE = 'STY53', MESSAGE = 'Verified archived response lifecycle is invalid.';\n    END IF;\n  END IF;\n  RETURN NEW;\nEND\n$function$\n","leakproof":false,"owner":"postgres","parallel":"u","securityDefiner":false,"strict":false,"volatility":"v"}},{"kind":"function","name":"guard_numbering_range_history()","value":{"config":["search_path=pg_catalog"],"definition":"CREATE OR REPLACE FUNCTION offline.guard_numbering_range_history()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'pg_catalog'\nAS $function$\nDECLARE trusted_actor text := current_setting('app.actor_id', true);\nBEGIN\n  -- The whitespace set is ECMAScript String.trim(), matching Database.requireActor.\n  IF btrim(trusted_actor, E' \\t\\n\\r\\f\\013' ||\n      U&'\\00A0\\1680\\2000\\2001\\2002\\2003\\2004\\2005\\2006\\2007\\2008\\2009\\200A\\2028\\2029\\202F\\205F\\3000\\FEFF') = ''\n  THEN trusted_actor := NULL; END IF;\n  IF TG_OP = 'DELETE' THEN\n    IF OLD.created_by IS NOT NULL OR OLD.creation_key IS NOT NULL OR OLD.cancelled_by IS NOT NULL THEN\n      RAISE EXCEPTION USING ERRCODE = 'STY49', MESSAGE = 'Administered numbering range history cannot be deleted.';\n    END IF;\n    RETURN OLD;\n  END IF;\n  IF current_user <> pg_get_userbyid((SELECT relowner FROM pg_catalog.pg_class\n      WHERE oid = TG_RELID)) THEN\n    IF (TG_OP = 'INSERT' AND NEW.created_by IS NOT NULL\n        AND NEW.created_by IS DISTINCT FROM trusted_actor)\n      OR (((TG_OP = 'INSERT' AND NEW.cancelled_at IS NOT NULL)\n          OR (TG_OP = 'UPDATE' AND OLD.cancelled_at IS NULL AND NEW.cancelled_at IS NOT NULL))\n        AND NEW.cancelled_by IS DISTINCT FROM trusted_actor)\n    THEN\n      RAISE EXCEPTION USING ERRCODE = 'STY48', MESSAGE = 'Range provenance must use the trusted transaction actor.';\n    END IF;\n  END IF;\n  IF TG_OP = 'INSERT' THEN RETURN NEW; END IF;\n  IF ((OLD.created_by IS NOT NULL OR OLD.creation_key IS NOT NULL OR OLD.cancelled_by IS NOT NULL)\n      AND NEW.id IS DISTINCT FROM OLD.id)\n    OR NEW.created_at IS DISTINCT FROM OLD.created_at OR NEW.created_by IS DISTINCT FROM OLD.created_by\n    OR NEW.creation_key IS DISTINCT FROM OLD.creation_key\n    OR NEW.creation_fingerprint IS DISTINCT FROM OLD.creation_fingerprint\n    OR NEW.creation_receipt IS DISTINCT FROM OLD.creation_receipt\n    OR (OLD.cancelled_at IS NOT NULL AND (\n      NEW.cancelled_at IS DISTINCT FROM OLD.cancelled_at OR NEW.cancelled_by IS DISTINCT FROM OLD.cancelled_by\n      OR NEW.cancellation_reason IS DISTINCT FROM OLD.cancellation_reason))\n    OR (OLD.status = 'cancelled' AND NEW.status <> 'cancelled')\n    OR (OLD.created_by IS NOT NULL AND NEW.consumer_attributes::text IS DISTINCT FROM OLD.consumer_attributes::text)\n  THEN\n    RAISE EXCEPTION USING ERRCODE = 'STY48', MESSAGE = 'Numbering range provenance and terminal history are immutable.';\n  END IF;\n  IF (NEW.id IS DISTINCT FROM OLD.id OR NEW.tenant_id IS DISTINCT FROM OLD.tenant_id OR NEW.org_unit_id IS DISTINCT FROM OLD.org_unit_id\n    OR NEW.entity_type IS DISTINCT FROM OLD.entity_type OR NEW.series IS DISTINCT FROM OLD.series\n    OR NEW.start_number IS DISTINCT FROM OLD.start_number OR NEW.end_number IS DISTINCT FROM OLD.end_number)\n    AND EXISTS (SELECT 1 FROM offline.numbering_reservations r WHERE r.tenant_id = OLD.tenant_id AND r.range_id = OLD.id)\n  THEN\n    RAISE EXCEPTION USING ERRCODE = 'STY48', MESSAGE = 'Referenced numbering range bounds and scope are immutable.';\n  END IF;\n  RETURN NEW;\nEND\n$function$\n","leakproof":false,"owner":"postgres","parallel":"u","securityDefiner":false,"strict":false,"volatility":"v"}},{"kind":"function","name":"guard_sync_import_receipt()","value":{"config":["search_path=pg_catalog"],"definition":"CREATE OR REPLACE FUNCTION offline.guard_sync_import_receipt()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'pg_catalog'\nAS $function$\nBEGIN\n  RAISE EXCEPTION USING ERRCODE = 'STY50', MESSAGE = 'Offline import receipts are append-only.';\nEND\n$function$\n","leakproof":false,"owner":"postgres","parallel":"u","securityDefiner":false,"strict":false,"volatility":"v"}},{"kind":"grant","name":"guard_active_numbering_reservation():postgres:EXECUTE","value":{"grantable":false,"grantee":"postgres","object":"guard_active_numbering_reservation()","privilege":"EXECUTE"}},{"kind":"grant","name":"guard_archived_sync_batch():postgres:EXECUTE","value":{"grantable":false,"grantee":"postgres","object":"guard_archived_sync_batch()","privilege":"EXECUTE"}},{"kind":"grant","name":"guard_numbering_ra