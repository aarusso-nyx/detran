  }
  check(
    equal([...retainedNames].sort(), retained.consumer.targetMetadataClosure),
    'Retained dependency closure differs',
  );
  const runtime = safePath(root, 'runtime');
  const closure = sealedJson(runtime, 'closure-manifest.json', seals.closure);
  keys(
    closure,
    [
      'formatVersion',
      'kind',
      'phase',
      'publication',
      'admissionInputs',
      'runtime',
      'node',
      'loader',
      'packages',
      'graph',
      'boundaryReview',
      'limits',
    ],
    'Runtime closure',
  );
  check(
    equal(closure.publication, publication) &&
      closure.admissionInputs.retentionManifest.sha256 === seals.retention &&
      closure.admissionInputs.protectedVerification.sha256 === seals.protected,
    'Runtime admission linkage differs',
  );
  keys(
    closure.runtime,
    [
      'observedRoot',
      'packageManifest',
      'lockfile',
      'npmrc',
      'installLog',
      'installer',
      'hiddenLock',
      'binLinks',
    ],
    'Runtime topology',
  );
  for (const key of [
    'packageManifest',
    'lockfile',
    'npmrc',
    'installLog',
    'hiddenLock',
  ])
    fileRecord(runtime, closure.runtime[key]);
  check(closure.runtime.lockfile.sha256 === seals.lock, 'Runtime lock differs');
  const lock = strictJson(
    bytesAt(runtime, closure.runtime.lockfile.path),
    'Runtime lock',
  );
  const packageIndex = sealedJson(
    runtime,
    closure.packages.path,
    seals.packages,
  );
  keys(packageIndex, ['formatVersion', 'packages'], 'Resolved package index');
  check(
    packageIndex.packages.length === 211 &&
      closure.packages.sha256 === seals.packages,
    'Resolved package count differs',
  );
  const graph = sealedJson(runtime, closure.graph.path, seals.graph);
  const boundary = sealedJson(
    runtime,
    closure.boundaryReview.path,
    seals.boundary,
  );
  check(
    closure.graph.sha256 === seals.graph &&
      closure.boundaryReview.sha256 === seals.boundary &&
      boundary.sites.length === 15,
    'Import graph authority differs',
  );
  const actualFiles = new Set([closure.runtime.hiddenLock.path]);
  const fileRecords = new Map();
  const actualLinks = new Map();
  const declaredBins = new Map();
  const selectedNames = new Set();
  for (const item of packageIndex.packages) {
    const manifestBytes = fileRecord(runtime, item.packageManifest);
    const manifest = strictJson(manifestBytes, item.packageManifest.path);
    check(
      manifest.name === item.name &&
        manifest.version === item.version &&
        lock.packages[item.path]?.version === item.version &&
        lock.packages[item.path]?.integrity === item.integrity &&
        lock.packages[item.path]?.resolved === item.resolved,
