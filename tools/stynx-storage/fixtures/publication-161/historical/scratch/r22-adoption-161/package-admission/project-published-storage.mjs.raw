}
function fileRecord(root, record) {
  keys(record, ['path', 'bytes', 'sha256'], 'File record');
  const bytes = bytesAt(root, record.path);
  check(
    bytes.length === record.bytes && sha(bytes) === record.sha256,
    `Retained bytes differ: ${record.path}`,
