const equal = (left, right) => canonical(left) === canonical(right);

// Detect duplicate decoded keys before JSON.parse can discard them. JSON.parse
// then supplies the ordinary grammar checks; no input code/getter is evaluated.
function strictJson(bytes, label) {
  const text = bytes.toString('utf8');
  check(Buffer.from(text, 'utf8').equals(bytes), `${label}: invalid UTF-8`);
  let position = 0;
  const space = () => {
    while (/[ \t\r\n]/u.test(text[position] ?? 'x')) position++;
  };
  const string = () => {
    check(text[position] === '"', `${label}: JSON string required`);
    const start = position++;
    while (position < text.length) {
      const unit = text[position++];
      if (unit === '\\') position++;
      else if (unit === '"') return JSON.parse(text.slice(start, position));
    }
    refuse(`${label}: unterminated JSON string`);
  };
  const value = () => {
    space();
    if (text[position] === '{') {
      position++;
      space();
      const keys = new Set();
      if (text[position] === '}') {
        position++;
        return;
      }
      for (;;) {
        space();
        const key = string();
        check(!keys.has(key), `${label}: duplicate JSON key`);
        keys.add(key);
        space();
        check(text[position++] === ':', `${label}: JSON colon required`);
        value();
        space();
        const delimiter = text[position++];
        if (delimiter === '}') return;
        check(delimiter === ',', `${label}: JSON object delimiter required`);
      }
    }
    if (text[position] === '[') {
      position++;
      space();
      if (text[position] === ']') {
        position++;
        return;
      }
      for (;;) {
        value();
        space();
        const delimiter = text[position++];
        if (delimiter === ']') return;
        check(delimiter === ',', `${label}: JSON array delimiter required`);
      }
    }
    if (text[position] === '"') {
      string();
      return;
    }
    const match =
      /^(?:true|false|null|-?(?:0|[1-9]\d*)(?:\.\d+)?(?:[eE][+-]?\d+)?)/u.exec(
        text.slice(position),
