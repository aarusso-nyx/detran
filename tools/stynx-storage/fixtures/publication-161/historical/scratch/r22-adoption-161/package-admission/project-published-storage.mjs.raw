    retainedNames.add(item.name);
    const protectedItem = roster.get(item.name);
    check(
      protectedItem && item.version === '1.6.1',
      'Package outside protected roster',
    );
    const metadataBytes = fileRecord(root, {
      path: item.registryMetadata.path,
      bytes: item.registryMetadata.bytes,
      sha256: item.registryMetadata.sha256,
    });
    const packument = strictJson(metadataBytes, item.registryMetadata.path);
    const metadata = packument.versions?.['1.6.1'];
    check(
      packument.name === item.name &&
        metadata?.name === item.name &&
        metadata.version === '1.6.1' &&
        metadata.dist.integrity === protectedItem.integrity &&
        metadata.dist.shasum === protectedItem.shasum,
      'Live retained version metadata differs',
    );
    check(
      item.dist.integrity === protectedItem.integrity &&
        item.dist.shasum === protectedItem.shasum &&
        item.dist.tarball === metadata.dist.tarball,
      'Retained dist identity differs',
    );
    const archive = fileRecord(root, item.archive);
    sri(archive, protectedItem.integrity, item.name);
    check(
      sha(archive) === protectedItem.tarballSha256 &&
        archive.length === protectedItem.bytes &&
        createHash('sha1').update(archive).digest('hex') ===
          protectedItem.shasum,
      'Protected tarball bytes differ',
    );
    for (const entry of item.extraction.regularFiles)
      fileRecord(root, {
        path: `${item.extraction.root}/${entry.path}`,
        bytes: entry.bytes,
        sha256: entry.sha256,
      });
    const packageManifest = strictJson(
      bytesAt(root, item.packageManifest.path),
      item.packageManifest.path,
    );
    check(
      sha(bytesAt(root, item.packageManifest.path)) ===
        item.packageManifest.sha256 &&
        packageManifest.name === item.name &&
        packageManifest.version === '1.6.1',
      'Retained package manifest differs',
    );
    for (const section of [
      'dependencies',
      'optionalDependencies',
      'peerDependencies',
    ])
      check(
        equal(packageManifest[section] ?? {}, metadata[section] ?? {}),
        'Published dependency declarations differ',
      );
    for (const target of item.publicTargets)
      safePath(
        root,
        `${item.extraction.root}/package/${target.path.replace(/^\.\//u, '')}`,
