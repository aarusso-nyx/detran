    }
  }
  check(
    equal([...selectedNames].sort(), [...retainedNames].sort()),
    'Installed STYNX closure differs',
  );
  for (const link of closure.runtime.binLinks) {
    keys(
      link,
      ['path', 'target', 'resolvedPath', 'bytes', 'sha256', 'disposition'],
      'Bin link',
    );
    check(
      link.path.startsWith('node_modules/.bin/') &&
        !path.isAbsolute(link.target) &&
        link.disposition === 'nonexecuted-npm-bin-link',
      'Bin topology differs',
    );
    const file = path.join(runtime, link.path);
    check(
      fs.lstatSync(file).isSymbolicLink() &&
        fs.readlinkSync(file) === link.target,
      'Bin link changed',
    );
    const target = safePath(runtime, link.resolvedPath);
    check(
      fs.realpathSync(file) === target &&
        declaredBins.get(path.basename(file))?.has(link.resolvedPath),
      'Bin target escaped declaration',
    );
    fileRecord(runtime, {
      path: link.resolvedPath,
      bytes: link.bytes,
      sha256: link.sha256,
    });
    actualLinks.set(link.path, link.target);
  }
  check(
    actualLinks.size === 9 && actualFiles.size === 30092,
    'Physical closure count differs',
  );
  const walk = (directory) => {
    for (const item of fs.readdirSync(directory, { withFileTypes: true })) {
      const file = path.join(directory, item.name),
        relative = path.relative(runtime, file),
        stat = fs.lstatSync(file);
      if (stat.isSymbolicLink())
        check(
          actualLinks.has(relative) &&
            fs.readlinkSync(file) === actualLinks.get(relative),
          'Unexpected or escaping runtime link',
        );
      else if (stat.isDirectory()) walk(file);
