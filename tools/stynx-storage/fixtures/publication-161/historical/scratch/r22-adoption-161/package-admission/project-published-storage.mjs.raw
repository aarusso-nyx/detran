  return bytes;
}
function sealedJson(root, relative, seal) {
  const bytes = bytesAt(root, relative);
  const value = strictJson(bytes, relative);
  check(sha(bytes) === seal, `Reviewed input seal differs: ${relative}`);
  return value;
}
function sri(bytes, integrity, label) {
  const match = /^(sha512|sha256|sha1)-([A-Za-z0-9+/]+={0,2})$/u.exec(
    integrity,
  );
  check(
    match && createHash(match[1]).update(bytes).digest('base64') === match[2],
    `${label}: integrity differs`,
  );
}

function preflight(root) {
  const proof = sealedJson(
    root,
