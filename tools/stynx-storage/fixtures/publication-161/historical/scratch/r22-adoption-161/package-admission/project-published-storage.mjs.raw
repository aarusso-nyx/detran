  );
  const roster = new Map(proof.packages.map((item) => [item.name, item]));
  check(roster.size === 44, 'Protected roster is not unique');
  const retained = sealedJson(root, 'retention-manifest.json', seals.retention);
  keys(
    retained,
    [
      'formatVersion',
      'kind',
      'phase',
      'targetVersion',
      'publication',
      'consumer',
      'packages',
      'limits',
    ],
    'Retention manifest',
