{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"],
    "experimentalDecorators": true
  },
  "include": ["src/**/*.ts"],
  "angularCompilerOptions": { "compilationMode": "partial" }
}
