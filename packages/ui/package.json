{
  "name": "@detran/ui",
  "version": "0.1.0",
  "description": "Shared Angular application kit for DETRAN frontends, composed over the STYNX Angular platform.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./styles": {
      "default": "./styles/index.css"
    }
  },
  "files": [
    "dist",
    "styles"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "typecheck": "tsc -p tsconfig.spec.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@stynx-nyx/angular": "1.1.1",
    "@stynx-nyx/angular-auth": "1.1.1",
    "@stynx-nyx/angular-i18n": "1.1.1",
    "@stynx-nyx/angular-tenancy": "1.1.1",
    "@stynx-nyx/angular-ui": "1.1.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/common": ">=20.3.0 <22",
    "@angular/core": ">=20.3.0 <22",
    "@angular/router": ">=20.3.0 <22"
  },
  "devDependencies": {
    "@angular/common": "21.2.21",
    "@angular/compiler": "21.2.21",
    "@angular/compiler-cli": "21.2.21",
    "@angular/core": "21.2.21",
    "@angular/platform-browser": "21.2.21",
    "@angular/router": "21.2.21",
    "jsdom": "^29.0.2",
    "ng-packagr": "21.2.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.7"
  }
}
