{
  "name": "@detran/ui",
  "version": "0.1.0",
  "description": "Shared Angular application kit for DETRAN frontends, composed over the STYNX Angular platform.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/detran-ui.d.ts",
      "default": "./dist/fesm2022/detran-ui.mjs"
    },
    "./styles": {
      "default": "./styles/index.css"
    }
  },
  "files": [
    "dist",
    "styles"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "typecheck": "tsc -p tsconfig.spec.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@stynx-nyx/angular": "1.4.0",
    "@stynx-nyx/angular-auth": "1.4.0",
    "@stynx-nyx/angular-i18n": "1.4.0",
    "@stynx-nyx/angular-tenancy": "1.4.0",
    "@stynx-nyx/angular-ui": "1.4.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/common": ">=22.0.0 <23",
    "@angular/core": ">=22.0.0 <23",
    "@angular/router": ">=22.0.0 <23"
  },
  "devDependencies": {
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
    "@angular/compiler-cli": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/forms": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@angular/router": "22.1.6",
    "jsdom": "^29.0.2",
    "ng-packagr": "22.1.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.7"
  }
}
