# STYNX and DEVAI packages resolve from their orgs' private GitHub Packages
# registries. Auth: CI passes NODE_AUTH_TOKEN (packages: read); local dev needs
# a PAT with read:packages exported as NODE_AUTH_TOKEN (or in ~/.npmrc).
@stynx-nyx:registry=https://npm.pkg.github.com
@devai-nyx:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
