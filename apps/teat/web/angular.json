{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "cache": {
      "enabled": false
    }
  },
  "newProjectRoot": "projects",
  "projects": {
    "teat-web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "teat",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "outputPath": "dist",
            "polyfills": [],
            "inlineStyleLanguage": "css",
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "homologation": {
              "browser": "src/main.homologation.ts",
              "optimization": true,
              "sourceMap": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "600kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "production": {
              "optimization": true,
              "sourceMap": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "600kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "outputHashing": "none",
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "homologation"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "homologation": {
              "buildTarget": "teat-web:build:homologation"
            },
            "production": {
              "buildTarget": "teat-web:build:production"
            },
            "development": {
              "buildTarget": "teat-web:build:development"
            }
          },
          "defaultConfiguration": "homologation"
        }
      }
    }
  }
}
