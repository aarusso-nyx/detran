{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "cache": {
      "enabled": false
    }
  },
  "newProjectRoot": "projects",
  "projects": {
    "portal-web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "portal",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "outputPath": "dist",
            "polyfills": [],
            "inlineStyleLanguage": "css",
            "styles": ["src/styles.css"],
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ]
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "extractLicenses": true,
              "serviceWorker": "ngsw-config.json",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "600kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "outputHashing": "none",
              "sourceMap": true,
              "extractLicenses": false
            },
            "preview": {
              "browser": "src/main.preview.ts",
              "index": {
                "input": "src/index.preview.html",
                "output": "index.html"
              },
              "outputPath": {
                "base": "dist/preview",
                "browser": ""
              },
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "extractLicenses": true,
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public"
                },
                {
                  "glob": "*.json",
                  "input": "src/app/preview/fixtures",
                  "output": "assets/preview"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "portal-web:build:production"
            },
            "development": {
              "buildTarget": "portal-web:build:development"
            },
            "preview": {
              "buildTarget": "portal-web:build:preview",
              "host": "127.0.0.1"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
