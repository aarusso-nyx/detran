# Overrides suportados por tools/detran-stack.sh. Este arquivo é apenas referência;
# a stack não o carrega automaticamente. Exporte manualmente os valores escolhidos.
DETRAN_STACK_STATE_DIR=/tmp/detran-stack
DETRAN_STACK_HEALTH_TIMEOUT_SECONDS=120
DETRAN_DB_CONTAINER=detran-local-stack-postgres
DETRAN_DB_VOLUME=detran-local-stack-postgres
DB_PASSWORD=postgres
DETRAN_MOCK_PROJECT=detran-senatran-mock
DETRAN_RUNTIME_PROFILE=local-sandbox
DETRAN_LOCAL_TENANT_ID=
DETRAN_LOCAL_ACTOR_ID=
DETRAN_LOCAL_ROLES=
DETRAN_LOCAL_CPF=
DETRAN_LOCAL_ASSURANCE_LEVEL=
SENATRAN_PROVIDER=mock
SENATRAN_MOCK_BASE_URL=http://127.0.0.1:3000
SENATRAN_MOCK_CPF_USUARIO=
SENATRAN_MOCK_CLIENT_CERT_CN=
