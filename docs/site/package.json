{
  "name": "detran-docs-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "sync-docs": "node scripts/sync-docs.mjs",
    "prestart": "npm run sync-docs",
    "start": "docusaurus start",
    "prebuild": "npm run sync-docs",
    "build": "docusaurus build",
    "check": "npm run clear && npm run typecheck && npm run build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "deploy": "docusaurus deploy",
    "typecheck": "tsc --noEmit",
    "security:check": "node scripts/check-image-size-patch.mjs && npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "image-size": "file:vendor/image-size",
    "prism-react-renderer": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^18.3.29",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "overrides": {
    "brace-expansion@1.x": "1.1.21",
    "fast-uri@3.x": "3.1.8",
    "gray-matter": {
      "js-yaml": "3.15.1"
    },
    "http-proxy-middleware": "2.0.10",
    "image-size": "$image-size",
    "joi": "17.13.8",
    "js-yaml": "4.3.2",
    "launch-editor": "2.14.1",
    "nanoid@3.x": "3.3.18",
    "postcss": "8.5.26",
    "qs": "6.16.0",
    "serialize-javascript": "7.0.5",
    "uuid": "11.1.1",
    "webpack-dev-server": "5.2.6"
  }
}
