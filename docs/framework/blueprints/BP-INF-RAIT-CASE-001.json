{
  "schemaVersion": "1.0.0",
  "id": "BP-INF-RAIT-CASE-001",
  "module": {
    "name": "RaitCase",
    "namespace": "inf",
    "version": "1.0.0",
    "ddlFile": "34-inf-rait-case.sql",
    "dependencies": {
      "@detran/inf-ait": "workspace:*"
    },
    "devDependencies": {
      "@types/pg": "^8.15.4",
      "pg": "^8.20.0"
    },
    "testAliases": [
      {
        "package": "@detran/shared",
        "target": "../../shared/src/index.ts"
      },
      {
        "package": "@detran/inf-ait",
        "target": "../ait/src/index.ts"
      }
    ],
    "owners": ["detran-inf"],
    "description": "Ciclo de vida do caso RAIT (WF-RAIT-001): protocolo multicanal, juizo de admissibilidade, instrucao com diligencia, decisao e comunicacao. Vocabulario de estados canonico da base de conhecimento em docs/framework/product."
  },
  "database": {
    "entities": [
      {
        "name": "RaitCase",
        "table": "rait_case",
        "primaryKey": ["id"],
        "description": "Caso RAIT — um requerimento sobre um AIT em uma instancia (RN-RAIT-002).",
        "fields": [
          {
            "name": "id",
            "type": "uuid",
            "default": "gen_random_uuid()"
          },
          {
            "name": "tenant_id",
            "type": "uuid"
          },
          {
            "name": "ait_id",
            "type": "uuid"
          },
          {
            "name": "origin_case_id",
            "type": "uuid",
            "nullable": true
          },
          {
            "name": "protocol_number",
            "type": "varchar(40)"
          },
          {
            "name": "instance",
            "type": "varchar(20)"
          },
          {
            "name": "circuit",
            "type": "integer"
          },
          {
            "name": "state",
            "type": "varchar(40)",
            "default": "'PROTOCOLADO'"
          },
          {
            "name": "intake_channel",
            "type": "varchar(30)"
          },
          {
            "name": "protocolled_at",
            "type": "timestamptz"
          },
          {
            "name": "admitted_at",
            "type": "timestamptz",
            "nullable": true
          },
          {
            "name": "judge_body_received_at",
            "type": "timestamptz",
            "nullable": true
          },
          {
            "name": "cetran_received_at",
            "type": "timestamptz",
            "nullable": true
          },
          {
            "name": "remitted_at",
            "type": "timestamptz",
            "nullable": true
          },
          {
            "name": "decided_at",
            "type": "timestamptz",
            "nullable": true
          },
          {
            "name": "communicated_at",
            "type": "timestamptz",
            "nullable": true
          },
          {
            "name": "closed_at",
            "type": "timestamptz",
            "nullable": true
          },
          {
            "name": "suspensive_effect",
            "type": "boolean",
            "default": "false"
          },
          {
            "name": "archived",
            "type": "boolean",
            "default": "false"
          },
          {
            "name": "non_admission_reason",
            "type": "varchar(40)",
            "nullable": true
          },
          {
            "name": "withdrawal_document_id",
            "type": "uuid",
            "nullable": true
          },
          {
            "name": "last_movement_at",
            "type": "timestamptz",
            "default": "now()"
          },
          {
            "name": "pending_completion",
            "type": "boolean",
            "default": "false"
          }
        ],
        "indexes": [
          {
            "name": "ux_inf_rait_case_protocol",
            "columns": ["tenant_id", "protocol_number"],
            "unique": true
          },
          {
            "name": "ix_inf_rait_case_state",
            "columns": ["tenant_id", "instance", "state"]
          },
          {
            "name": "ix_inf_rait_case_movement",
            "columns": ["tenant_id", "last_movement_at"]
          },
          {
            "name": "ix_inf_rait_case_cetran_received",
            "columns": ["tenant_id", "cetran_received_at"]
          }
        ],
        "checks": [
          {
            "name": "ck_inf_rait_case_state",
            "expression": "state in ('PROTOCOLADO','TRIAGEM_ADMISSIBILIDADE','NAO_CONHECIDO','ADMITIDO','AGUARDANDO_REMESSA_JARI','DISTRIBUIDO','EM_INSTRUCAO','DILIGENCIA','PRONTO_P_DECISAO','DECIDIDO_AUTORIDADE','PAUTADO','JULGADO_SESSAO','COMUNICADO','TRANSITADO','REMETIDO_2A_INSTANCIA','ENCERRADO_DESISTENCIA')"
          },
          {
            "name": "ck_inf_rait_case_instance",
            "expression": "instance in ('defesa_previa','jari','cetran')"
          },
          {
            "name": "ck_inf_rait_case_circuit",
            "expression": "circuit in (1, 2)"
          },
          {
            "name": "ck_inf_rait_case_circuit_matches_instance",
            "expression": "(instance = 'defesa_previa' and circuit = 1) or (instance in ('jari','cetran') and circuit = 2)"
          },
          {
            "name": "ck_inf_rait_case_archived_only_untimely",
            "expression": "archived = false or non_admission_reason = 'intempestivo'"
          },
          {
            "name": "ck_inf_rait_case_non_admission_reason",
            "expression": "non_admission_reason is null or non_admission_reason in ('intempestivo','ilegitimo','sem_assinatura','pedido_incompativel')"
          },
          {
            "name": "ck_inf_rait_case_remessa_state_only_jari",
            "expression": "state <> 'AGUARDANDO_REMESSA_JARI' or instance = 'jari'"
          },
          {
            "name": "ck_inf_rait_case_cetran_is_final",
            "expression": "instance <> 'cetran' or state <> 'REMETIDO_2A_INSTANCIA'"
          },
          {
            "name": "ck_inf_rait_case_cetran_receipt_scope",
            "expression": "cetran_received_at is null or instance = 'cetran'"
          }
        ],
        "foreignKeys": [
          {
            "name": "fk_inf_rait_case_ait",
            "columns": ["ait_id"],
            "references": {
              "table": "inf.ait_ait",
              "columns": ["id"]
            }
          },
          {
            "name": "fk_inf_rait_case_origin",
            "columns": ["origin_case_id"],
            "references": {
              "table": "inf.rait_case",
              "columns": ["id"]
            }
          }
        ]
      },
      {
        "name": "RaitParty",
        "table": "rait_party",
        "primaryKey": ["id"],
        "description": "Parte do caso — legitimidade ativa (RN-RAIT-120) e representacao (RN-RAIT-121).",
        "fields": [
          {
            "name": "id",
            "type": "uuid",
            "default": "gen_random_uuid()"
          },
          {
            "name": "tenant_id",
            "type": "uuid"
          },
          {
            "name": "case_id",
            "type": "uuid"
          },
          {
            "name": "role",
            "type": "varchar(30)"
          },
          {
            "name": "legitimacy_basis",
            "type": "varchar(40)",
            "nullable": true
          },
          {
            "name": "person_name",
            "type": "varchar(200)",
            "pii": "direct",
            "retention": "processo+20a"
          },
          {
            "name": "document_number",
            "type": "varchar(30)",
            "pii": "direct",
            "retention": "processo+20a"
          },
          {
            "name": "contact_email",
            "type": "varchar(200)",
            "nullable": true,
            "pii": "direct"
          },
          {
            "name": "representation_kind",
            "type": "varchar(60)",
            "nullable": true
          },
          {
            "name": "representation_verified",
            "type": "boolean",
            "default": "false"
          },
          {
            "name": "representation_document_id",
            "type": "uuid",
            "nullable": true
          }
        ],
        "indexes": [
          {
            "name": "ix_inf_rait_party_case",
            "columns": ["tenant_id", "case_id", "role"]
          }
        ],
        "checks": [
          {
            "name": "ck_inf_rait_party_role",
            "expression": "role in ('requerente','procurador','autoridade')"
          },
          {
            "name": "ck_inf_rait_party_legitimacy",
            "expression": "legitimacy_basis is null or legitimacy_basis in ('proprietario','condutor','embarcador','transportador','possuidor_equiparado','principal_condutor')"
          },
          {
            "name": "ck_inf_rait_party_representation_kind",
            "expression": "representation_kind is null or representation_kind in ('procuracao_publica','particular_firma_autenticidade')"
          }
        ],
        "foreignKeys": [
          {
            "name": "fk_inf_rait_party_case",
            "columns": ["case_id"],
            "references": {
              "table": "inf.rait_case",
              "columns": ["id"]
            }
          }
        ]
      },
      {
        "name": "RaitDocument",
        "table": "rait_document",
        "primaryKey": ["id"],
        "description": "Peca do dossie. origin='oficio' marca as pecas que o orgao junta por dever proprio (RN-RAIT-003).",
