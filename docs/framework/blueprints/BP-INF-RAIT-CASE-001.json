        "indexes": [
          {
            "name": "ux_inf_rait_deadline_case_timer",
            "columns": ["tenant_id", "case_id", "timer_code"],
            "unique": true
          },
          {
            "name": "ix_inf_rait_deadline_due",
            "columns": ["tenant_id", "due_on"],
            "where": "satisfied_at is null"
          }
        ],
        "checks": [
          {
            "name": "ck_inf_rait_deadline_timer",
            "expression": "timer_code in ('T-REM10','T-DIL','T-R2','T-JUL-24M','T-PAR-3A','T-DEC','T-VOTO','T-CONV')"
          },
          {
            "name": "ck_inf_rait_deadline_due_not_before_start",
            "expression": "due_on >= started_on"
          },
          {
            "name": "ck_inf_rait_deadline_rounding_forward",
            "expression": "due_on >= raw_due_on"
          }
