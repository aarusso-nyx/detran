            "columns": ["tenant_id", "session_id"],
            "references": {
              "table": "inf.rait_session",
              "columns": ["tenant_id", "id"]
            }
          },
          {
            "name": "fk_inf_rait_attendance_member_tenant",
            "columns": ["tenant_id", "member_id"],
            "references": {
              "table": "inf.rait_pool_member",
              "columns": ["tenant_id", "id"]
            },
            "referencedUniqueIndex": {
              "name": "ux_inf_rait_pool_member_tenant_id"
            }
          }
        ]
      },
