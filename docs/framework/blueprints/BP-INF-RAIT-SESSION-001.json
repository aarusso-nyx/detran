{
  "schemaVersion": "1.0.0",
  "id": "BP-INF-RAIT-SESSION-001",
  "module": {
    "name": "RaitSession",
    "namespace": "inf",
    "version": "1.2.2",
    "ddlFile": "36-inf-rait-session.sql",
    "dependencies": {
      "@detran/inf-deadlines": "workspace:*",
      "@detran/inf-rait-case": "workspace:*",
      "@detran/inf-rait-worklist": "workspace:*"
    },
    "devDependencies": {
      "@types/pg": "^8.15.4",
      "pg": "^8.20.0"
    },
    "testAliases": [
      {
        "package": "@detran/shared",
        "target": "../../shared/src/index.ts"
      },
      {
        "package": "@detran/inf-rait-case",
        "target": "../rait-case/src/index.ts"
      },
      {
        "package": "@detran/inf-rait-worklist",
        "target": "../rait-worklist/src/index.ts"
      },
      {
        "package": "@detran/inf-deadlines",
        "target": "../deadlines/src/index.ts"
      }
    ],
    "handwrittenControllers": [
      {
        "target": "handwritten/rait-session-commands.controller",
        "symbol": "RaitSessionCommandsController"
      }
    ],
    "handwrittenProviders": [
      {
        "target": "handwritten/rait-session-command.service",
        "symbol": "RaitSessionCommandService"
      }
    ],
    "handwrittenExports": [
      "handwritten/rait-session-commands.controller",
      "handwritten/rait-session-command.service"
    ],
    "owners": ["detran-inf"],
    "description": "Rito de sessao colegiada JARI/CETRAN (WF-RAIT-003): pauta, convocacao, quorum, relatoria, votacao, desempate e ata assinada em PAdES+TSA. v1.1.0 acrescenta a modalidade da sessao, o reconhecimento de convocacao curta, o pedido de vista por item e a publicacao da ata (OD-102, OD-103, OD-106 vigentes por steering H.57). v1.2.0 fecha o schema aditivo de composicao institucional, concorrencia otimista e ata confiavel multi-signatario conforme ADR-0027, UC-RAIT-020 e WF-RAIT-003, com dependencias explicitas em case, worklist e deadlines e somente leituras CRUD. v1.2.1 registra oficialmente controller, provider e exports manuscritos dos comandos CTG-0002, sem expor escrita CRUD nem sustentacao oral."
  },
  "database": {
    "entities": [
      {
        "name": "RaitSession",
        "table": "rait_session",
        "primaryKey": ["id"],
        "description": "Sessao de julgamento. Sem quorum a sessao nao abre e vai a SESSAO_ADIADA (AC-RAIT-006-1); relogios nao param (AC-RAIT-006-2). v1.1.0: modality registra presencial, virtual ou hibrida (WF-RAIT-003 secao Fundamento e WF-RAIT-004 secao 6 regra (d); habilitacao pelo parametro session.modality.virtual_enabled, OD-106) e short_notice_ack marca o reconhecimento da convocacao com menos de T-CONV (RAIT.AGENDA_SHORT_NOTICE, OD-102).",
        "fields": [
          {
            "name": "id",
            "type": "uuid",
            "default": "gen_random_uuid()"
          },
          {
            "name": "tenant_id",
            "type": "uuid"
          },
          {
            "name": "judging_body",
            "type": "varchar(10)"
          },
          {
            "name": "state",
            "type": "varchar(30)",
            "default": "'FORMANDO_PAUTA'"
          },
          {
            "name": "scheduled_for",
            "type": "timestamptz",
            "nullable": true
          },
          {
            "name": "agenda_closed_at",
            "type": "timestamptz",
            "nullable": true
          },
          {
            "name": "convened_at",
            "type": "timestamptz",
            "nullable": true
          },
          {
            "name": "opened_at",
            "type": "timestamptz",
            "nullable": true
          },
          {
            "name": "closed_at",
            "type": "timestamptz",
            "nullable": true
          },
          {
            "name": "quorum_required",
            "type": "integer"
          },
          {
            "name": "quorum_observed",
            "type": "integer",
            "nullable": true
          },
          {
            "name": "chair_member_id",
            "type": "uuid",
            "nullable": true
          },
          {
            "name": "adjourned_reason",
            "type": "varchar(60)",
            "nullable": true
          },
          {
            "name": "extraordinary",
            "type": "boolean",
            "default": "false"
          },
          {
            "name": "short_notice_ack_by",
            "type": "uuid",
            "nullable": true
          },
          {
            "name": "modality",
            "type": "varchar(20)",
            "default": "'presencial'"
          },
          {
            "name": "short_notice_ack",
            "type": "boolean",
            "default": "false"
          },
          {
            "name": "version",
            "type": "integer",
            "default": "1",
            "additive": true,
            "writable": false
          }
        ],
        "indexes": [
          {
            "name": "ix_inf_rait_session_body_state",
            "columns": ["tenant_id", "judging_body", "state"]
          },
          {
            "name": "ux_inf_rait_session_tenant_id",
            "columns": ["tenant_id", "id"],
            "unique": true,
            "constraint": true
          }
        ],
        "checks": [
          {
            "name": "ck_inf_rait_session_body",
            "expression": "judging_body in ('jari','cetran')"
          },
          {
            "name": "ck_inf_rait_session_state",
            "expression": "state in ('FORMANDO_PAUTA','PAUTA_FECHADA','CONVOCACAO_ENVIADA','SESSAO_ABERTA','SESSAO_ADIADA','RELATORIA_LIDA','SUSTENTACAO_ORAL','VOTACAO','DESEMPATE_PRESIDENTE','DECISAO_PROCLAMADA','ATA_LAVRADA','ATA_ASSINADA')"
          },
          {
            "name": "ck_inf_rait_session_quorum_positive",
            "expression": "quorum_required > 0"
          },
          {
            "name": "ck_inf_rait_session_open_needs_quorum",
            "expression": "opened_at is null or (quorum_observed is not null and quorum_observed >= quorum_required)"
          },
          {
            "name": "ck_inf_rait_session_adjourned_reason",
            "expression": "state <> 'SESSAO_ADIADA' or adjourned_reason is not null"
          },
          {
            "name": "ck_inf_rait_session_modality",
            "expression": "modality in ('presencial','virtual','hibrida')"
          },
          {
            "name": "ck_inf_rait_session_short_notice_ack",
            "expression": "short_notice_ack_by is null or short_notice_ack"
          },
          {
            "name": "ck_inf_rait_session_version_positive",
            "expression": "version > 0",
            "additive": true
          }
        ]
      },
      {
        "name": "RaitAgendaItem",
        "table": "rait_agenda_item",
        "primaryKey": ["id"],
        "description": "Caso em pauta. priority=true para bandeiras ALERTA_N3/CRITICO — entrada obrigatoria (AC-RAIT-005-1). So entra com parecer registrado (AC-RAIT-005-2). v1.1.0: view_requested_by e view_due_on registram o pedido de vista do item e seu prazo de devolucao (WF-RAIT-004 secao 2.3 — Res. 901/2022 Anexo 11.1; OD-103, teto por membro no parametro session.view_request.max_per_member).",
        "fields": [
          {
            "name": "id",
            "type": "uuid",
            "default": "gen_random_uuid()"
          },
          {
            "name": "tenant_id",
            "type": "uuid"
          },
          {
            "name": "session_id",
            "type": "uuid"
          },
          {
            "name": "case_id",
            "type": "uuid"
          },
          {
            "name": "position",
            "type": "integer"
          },
          {
            "name": "priority",
            "type": "boolean",
            "default": "false"
          },
          {
            "name": "rapporteur_member_id",
            "type": "uuid"
          },
          {
            "name": "opinion_summary",
            "type": "text",
            "nullable": true
          },
          {
            "name": "opinion_analysis",
            "type": "text",
            "nullable": true
          },
          {
            "name": "opinion_vote",
            "type": "varchar(20)",
            "nullable": true
          },
          {
            "name": "opinion_registered_at",
            "type": "timestamptz",
            "nullable": true
          },
          {
            "name": "read_at",
            "type": "timestamptz",
            "nullable": true
          },
          {
            "name": "proclaimed_at",
            "type": "timestamptz",
            "nullable": true
          },
          {
            "name": "outcome",
            "type": "varchar(20)",
            "nullable": true
          },
          {
            "name": "withdrawn",
            "type": "boolean",
            "default": "false"
          },
          {
            "name": "withdrawn_reason",
            "type": "varchar(40)",
            "nullable": true
          },
          {
            "name": "view_requested_by",
            "type": "uuid",
            "nullable": true
          },
          {
            "name": "view_due_on",
            "type": "date",
            "nullable": true
          },
          {
            "name": "version",
            "type": "integer",
            "default": "1",
            "additive": true,
            "writable": false
          }
        ],
        "indexes": [
          {
            "name": "ux_inf_rait_agenda_item_case",
            "columns": ["tenant_id", "session_id", "case_id"],
            "unique": true
          },
          {
            "name": "ux_inf_rait_agenda_item_position",
            "columns": ["tenant_id", "session_id", "position"],
            "unique": true
          },
          {
            "name": "ux_inf_rait_agenda_item_tenant_id",
            "columns": ["tenant_id", "id"],
            "unique": true,
            "constraint": true
          }
        ],
        "checks": [
          {
            "name": "ck_inf_rait_agenda_item_opinion_vote",
            "expression": "opinion_vote is null or opinion_vote in ('provimento','nao_provimento','nao_conhecimento')"
          },
          {
            "name": "ck_inf_rait_agenda_item_outcome",
            "expression": "outcome is null or outcome in ('provido','negado','nao_conhecido')"
          },
          {
            "name": "ck_inf_rait_agenda_item_opinion_complete",
            "expression": "opinion_registered_at is null or (opinion_summary is not null and opinion_analysis is not null and opinion_vote is not null)"
          },
          {
            "name": "ck_inf_rait_agenda_item_withdrawn_reason",
            "expression": "withdrawn = false or withdrawn_reason is not null"
          },
          {
            "name": "ck_inf_rait_agenda_item_view_complete",
            "expression": "(view_requested_by is null and view_due_on is null) or (view_requested_by is not null and view_due_on is not null)"
          },
          {
            "name": "ck_inf_rait_agenda_item_version_positive",
            "expression": "version > 0",
            "additive": true
          }
        ],
        "foreignKeys": [
          {
            "name": "fk_inf_rait_agenda_item_session",
            "columns": ["session_id"],
            "references": {
              "table": "inf.rait_session",
              "columns": ["id"]
            }
          },
          {
            "name": "fk_inf_rait_agenda_item_case",
            "columns": ["case_id"],
            "references": {
              "table": "inf.rait_case",
              "columns": ["id"]
            }
          },
          {
            "name": "fk_inf_rait_agenda_item_rapporteur",
            "columns": ["rapporteur_member_id"],
            "references": {
              "table": "inf.rait_pool_member",
              "columns": ["id"]
            }
          }
        ]
      },
      {
        "name": "RaitAttendance",
        "table": "rait_attendance",
        "primaryKey": ["id"],
        "description": "Presenca por membro. left_at permite reverificar quorum por caso, nao so na abertura (AC-RAIT-006-3). v1.2.0 congela bloco, titularidade, mandato, ato, assento e vigencia institucionais usados para quorum e paridade reproduziveis em WF-RAIT-003 e WF-RAIT-004 secao 6.",
        "fields": [
          {
            "name": "id",
            "type": "uuid",
            "default": "gen_random_uuid()"
          },
          {
            "name": "tenant_id",
            "type": "uuid"
          },
          {
            "name": "session_id",
            "type": "uuid"
          },
          {
            "name": "member_id",
            "type": "uuid"
          },
          {
            "name": "present",
            "type": "boolean",
            "default": "false"
          },
          {
            "name": "is_chair",
            "type": "boolean",
            "default": "false"
          },
          {
            "name": "is_chair_substitute",
            "type": "boolean",
            "default": "false"
          },
          {
            "name": "arrived_at",
            "type": "timestamptz",
            "nullable": true
          },
          {
            "name": "left_at",
            "type": "timestamptz",
            "nullable": true
          },
          {
            "name": "absence_justified",
            "type": "boolean",
            "nullable": true
          },
          {
            "name": "representation_block",
            "type": "varchar(30)",
            "nullable": true,
            "additive": true,
            "writable": false
          },
          {
            "name": "membership_kind",
            "type": "varchar(20)",
            "nullable": true,
            "additive": true,
            "writable": false
          },
          {
            "name": "mandate_starts_on_snapshot",
            "type": "date",
            "nullable": true,
            "additive": true,
            "writable": false
          },
          {
            "name": "mandate_ends_on_snapshot",
            "type": "date",
            "nullable": true,
            "additive": true,
            "writable": false
          },
          {
            "name": "institutional_seat_ref",
            "type": "varchar(120)",
            "nullable": true,
            "additive": true,
            "writable": false
          },
          {
            "name": "appointment_act_ref",
            "type": "varchar(160)",
            "nullable": true,
            "additive": true,
            "writable": false
          },
          {
            "name": "institutional_valid_from",
            "type": "date",
            "nullable": true,
            "additive": true,
            "writable": false
          },
          {
            "name": "institutional_valid_to",
            "type": "date",
            "nullable": true,
            "additive": true,
            "writable": false
          },
          {
            "name": "composition_snapshot_hash",
            "type": "varchar(64)",
            "nullable": true,
            "additive": true,
            "writable": false
          }
        ],
        "indexes": [
          {
            "name": "ux_inf_rait_attendance",
            "columns": ["tenant_id", "session_id", "member_id"],
            "unique": true
          }
        ],
        "checks": [
          {
            "name": "ck_inf_rait_attendance_representation_block",
            "expression": "representation_block is null or representation_block in ('executivo_estadual','municipal_rodoviario','sociedade_civil')",
            "additive": true
          },
          {
            "name": "ck_inf_rait_attendance_membership_kind",
            "expression": "membership_kind is null or membership_kind in ('titular','suplente')",
            "additive": true
          },
          {
            "name": "ck_inf_rait_attendance_composition_snapshot",
            "expression": "representation_block is null or (membership_kind is not null and mandate_starts_on_snapshot is not null and institutional_seat_ref is not null and btrim(institutional_seat_ref) <> '' and appointment_act_ref is not null and btrim(appointment_act_ref) <> '' and institutional_valid_from is not null and composition_snapshot_hash is not null)",
            "additive": true
          },
          {
            "name": "ck_inf_rait_attendance_mandate_order",
            "expression": "mandate_ends_on_snapshot is null or mandate_starts_on_snapshot is null or mandate_ends_on_snapshot >= mandate_starts_on_snapshot",
            "additive": true
          },
          {
            "name": "ck_inf_rait_attendance_institutional_validity_order",
            "expression": "institutional_valid_to is null or institutional_valid_from is null or institutional_valid_to >= institutional_valid_from",
            "additive": true
          },
          {
            "name": "ck_inf_rait_attendance_composition_snapshot_hash",
            "expression": "composition_snapshot_hash is null or composition_snapshot_hash ~ '^[0-9a-f]{64}$'",
            "additive": true
          }
        ],
        "foreignKeys": [
          {
            "name": "fk_inf_rait_attendance_session",
            "columns": ["session_id"],
            "references": {
              "table": "inf.rait_session",
              "columns": ["id"]
            }
          },
          {
