          {
            "name": "road",
            "type": "varchar(40)",
            "nullable": true
          },
          {
            "name": "km",
            "type": "numeric(8,2)",
            "nullable": true
          },
          {
            "name": "direction",
            "type": "varchar(60)",
            "nullable": true
          },
          {
            "name": "mandatory_observation",
            "type": "text",
            "nullable": true
          },
          {
            "name": "complementary_observation",
            "type": "text",
            "nullable": true
          },
          {
            "name": "current_status",
            "type": "varchar(60)",
            "default": "'RASCUNHO_OFFLINE'"
          },
          {
            "name": "version",
            "type": "integer",
            "default": "1"
          },
          {
            "name": "speed_measurement_id",
            "type": "uuid",
            "nullable": true
          },
          {
            "name": "content_hash",
            "type": "varchar(128)",
            "nullable": true
          },
          {
            "name": "system_signature_ref",
            "type": "text",
            "nullable": true
          },
          {
            "name": "receipt_protocol",
            "type": "varchar(120)",
            "nullable": true
          },
          {
            "name": "location_geom",
            "type": "geometry(Point,4674)",
            "nullable": true
          }
        ],
        "indexes": [
          {
            "name": "ux_inf_ait_number",
            "columns": [
              "tenant_id",
              "traffic_agency_id",
              "series",
              "ait_number"
            ],
            "unique": true
          },
          {
            "name": "ux_inf_ait_receipt_protocol",
            "columns": ["tenant_id", "receipt_protocol"],
            "unique": true,
            "where": "receipt_protocol is not null"
          },
          {
            "name": "ix_inf_ait_status",
            "columns": ["tenant_id", "current_status"]
          },
          {
            "name": "gist_inf_ait_location",
            "columns": ["location_geom"],
            "method": "gist"
          }
        ],
        "checks": [
          {
            "name": "ck_inf_ait_issue_after_infraction",
            "expression": "issued_at >= infraction_at"
          },
          {
            "name": "ck_inf_ait_current_status",
            "expression": "current_status in ('RASCUNHO_OFFLINE', 'CANCELADO_RASCUNHO', 'FINALIZADO_LOCAL', 'ENFILEIRADO', 'TRANSMITIDO', 'RECEBIDO', 'SUSPEITO_CONCORRENCIA', 'VALIDANDO', 'ACEITO', 'REJEITADO', 'PENDENTE_CORRECAO', 'CORRIGIDO', 'INTEGRADO', 'PROCESSADO', 'ARQUIVADO', 'SOLICITADO_CANCEL_POSFINAL', 'CANCELADO_POSFINAL')"
          }
        ],
