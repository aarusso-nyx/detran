{
  "schemaVersion": "1.0.0",
  "id": "BP-OPS-OFFLINE-SYNC-001",
  "module": {
    "name": "OfflineSync",
    "namespace": "ops",
    "version": "1.2.0",
    "ddlFile": "18-ops-offline-sync.sql",
    "dependencies": {
      "@detran/ops-core": "workspace:*",
      "@detran/ops-parameter": "workspace:*"
    },
    "owners": ["detran-ops"],
    "description": "Offline numbering and durable synchronization from WF-TEAT-002 and INV-OFFLINE-001; no WP-T2 controller is mounted in this round.",
    "testAliases": [
      {
        "package": "@detran/shared",
        "target": "../../shared/src/index.ts"
      },
      {
        "package": "@detran/ops-core",
        "target": "../core/src/index.ts"
      },
      {
        "package": "@detran/ops-parameter",
        "target": "../parameter/src/index.ts"
      }
    ]
  },
  "api": {
    "basePath": "/v1/ops/offline-sync/",
    "resources": [
      {
        "entity": "AitNumberingRange",
        "path": "numbering-ranges",
        "resource": "numbering-range"
      },
      {
        "entity": "NumberingReservation",
        "path": "numbering-reservations",
        "resource": "numbering-reservation"
      },
      {
        "entity": "NumberingConsumption",
        "path": "numbering-consumptions",
        "resource": "numbering-consumption"
      },
      {
        "entity": "SyncBatch",
        "path": "sync-batches",
        "resource": "sync-batch",
        "operations": ["list", "get"]
      },
      {
        "entity": "SyncQueueItem",
        "path": "sync-queue-items",
        "resource": "sync-queue-item"
      },
      {
        "entity": "SyncReceipt",
        "path": "receipts",
        "resource": "sync-receipt"
      },
      {
        "entity": "SyncConflict",
        "path": "sync-conflicts",
        "resource": "sync-conflict"
      }
    ]
  },
  "database": {
    "entities": [
      {
        "name": "AitNumberingRange",
        "table": "ait_numbering_range",
        "primaryKey": ["id"],
        "fields": [
          {
            "name": "id",
            "type": "uuid",
            "default": "gen_random_uuid()"
          },
          {
            "name": "tenant_id",
            "type": "uuid"
          },
          {
            "name": "traffic_agency_id",
            "type": "uuid"
          },
          {
            "name": "series",
            "type": "varchar(40)"
          },
          {
            "name": "start_number",
            "type": "bigint"
          },
          {
            "name": "end_number",
            "type": "bigint"
          },
          {
            "name": "next_number",
            "type": "bigint"
          },
          {
            "name": "status",
            "type": "varchar(40)",
            "default": "'active'"
          },
          {
            "name": "usage_mode",
            "type": "varchar(40)"
          }
        ],
        "indexes": [
          {
            "columns": ["tenant_id", "traffic_agency_id", "series"],
            "unique": true
          }
        ],
        "checks": [
          {
            "name": "ck_ops_ait_numbering_range_bounds",
            "expression": "start_number <= end_number and next_number between start_number and end_number"
          }
        ]
      },
      {
        "name": "NumberingReservation",
        "table": "numbering_reservation",
        "primaryKey": ["id"],
        "fields": [
          {
            "name": "id",
            "type": "uuid",
            "default": "gen_random_uuid()"
          },
          {
            "name": "tenant_id",
            "type": "uuid"
          },
          {
            "name": "range_id",
            "type": "uuid"
          },
          {
            "name": "traffic_agency_id",
            "type": "uuid"
          },
          {
            "name": "agent_id",
            "type": "uuid"
          },
          {
            "name": "device_id",
            "type": "uuid"
          },
          {
            "name": "shift_id",
            "type": "uuid",
            "nullable": true
          },
          {
            "name": "idempotency_key",
            "type": "varchar(160)",
            "nullable": true
          },
          {
            "name": "start_number",
            "type": "bigint"
          },
          {
            "name": "end_number",
            "type": "bigint"
          },
          {
            "name": "reserved_at",
            "type": "timestamptz",
            "default": "now()"
          },
          {
            "name": "valid_until",
            "type": "timestamptz"
          },
          {
            "name": "status",
            "type": "varchar(40)",
            "default": "'reserved'"
          },
          {
            "name": "reconciliation_json",
            "type": "jsonb",
            "nullable": true
          }
        ],
        "indexes": [
          {
            "columns": ["tenant_id", "agent_id", "device_id", "status"]
          },
          {
            "columns": ["tenant_id", "idempotency_key"],
            "unique": true,
            "where": "idempotency_key is not null"
          }
        ],
        "foreignKeys": [
          {
            "name": "fk_ops_numbering_reservation_range",
            "columns": ["range_id"],
            "references": {
              "table": "ops.ait_numbering_range",
              "columns": ["id"]
            }
          }
        ]
      },
      {
        "name": "NumberingConsumption",
        "table": "numbering_consumption",
        "primaryKey": ["id"],
        "fields": [
          {
            "name": "id",
            "type": "uuid",
            "default": "gen_random_uuid()"
          },
          {
            "name": "tenant_id",
            "type": "uuid"
          },
          {
            "name": "reservation_id",
            "type": "uuid"
          },
          {
            "name": "range_id",
