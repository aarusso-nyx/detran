          },
          {
            "name": "sent_at",
            "type": "timestamptz",
            "nullable": true
          },
          {
            "name": "received_at",
            "type": "timestamptz",
            "nullable": true
          },
          {
            "name": "idempotency_key",
            "type": "varchar(160)"
          },
          {
            "name": "payload_hash",
            "type": "varchar(128)"
          },
          {
            "name": "payload_json",
            "type": "jsonb"
          },
          {
            "name": "error_code",
            "type": "varchar(80)",
            "nullable": true
          },
          {
            "name": "error_message",
            "type": "text",
            "nullable": true
          }
        ],
        "indexes": [
          {
            "columns": ["tenant_id", "device_id", "status"]
          },
          {
            "columns": ["tenant_id", "idempotency_key"],
            "unique": true
          }
