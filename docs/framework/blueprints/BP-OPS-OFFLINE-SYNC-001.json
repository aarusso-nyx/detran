          },
          {
            "name": "local_entity_id",
            "type": "uuid",
            "nullable": true
          },
          {
            "name": "idempotency_key",
            "type": "varchar(160)",
            "nullable": true
          },
          {
            "name": "server_entity_id",
            "type": "uuid",
            "nullable": true
          },
          {
            "name": "finalized_at",
            "type": "timestamptz",
            "nullable": true
          },
          {
            "name": "reconciled_at",
            "type": "timestamptz",
            "default": "now()"
          },
          {
            "name": "status",
            "type": "varchar(40)",
            "default": "'applied'"
          },
          {
            "name": "details_json",
            "type": "jsonb",
            "nullable": true
          }
        ],
        "indexes": [
          {
            "columns": ["tenant_id", "range_id", "number"],
            "unique": true
          },
          {
            "columns": ["tenant_id", "local_entity_id"],
            "unique": true
          },
          {
            "columns": ["tenant_id", "idempotency_key"],
            "unique": true
          }
        ],
        "foreignKeys": [
          {
            "name": "fk_ops_numbering_consumption_reservation",
            "columns": ["reservation_id"],
            "references": {
              "table": "ops.numbering_reservation",
              "columns": ["id"]
            }
          },
          {
            "name": "fk_ops_numbering_consumption_range",
            "columns": ["range_id"],
            "references": {
              "table": "ops.ait_numbering_range",
              "columns": ["id"]
            }
          }
        ]
      },
      {
        "name": "SyncBatch",
        "table": "sync_batch",
        "primaryKey": ["id"],
        "fields": [
          {
            "name": "id",
            "type": "uuid",
            "default": "gen_random_uuid()"
          },
          {
            "name": "tenant_id",
            "type": "uuid"
          },
          {
            "name": "traffic_agency_id",
            "type": "uuid"
          },
          {
            "name": "agent_id",
            "type": "uuid"
          },
          {
            "name": "device_id",
            "type": "uuid"
          },
          {
            "name": "device_batch_id",
            "type": "varchar(160)"
          },
          {
            "name": "batch_sequence",
            "type": "bigint",
            "nullable": true
          },
          {
            "name": "submitted_at",
            "type": "timestamptz",
            "default": "now()"
          },
          {
            "name": "accepted_items",
            "type": "integer",
            "default": "0"
          },
          {
            "name": "receipts_json",
            "type": "jsonb",
            "nullable": true
          }
        ],
        "indexes": [
          {
            "columns": ["tenant_id", "device_id", "device_batch_id"],
            "unique": true
          },
          {
            "columns": ["tenant_id", "device_id", "batch_sequence"],
            "unique": true
          }
        ],
        "checks": [
          {
            "name": "ck_ops_sync_batch_sequence_positive",
            "expression": "batch_sequence is null or batch_sequence >= 1"
          },
          {
            "name": "ck_ops_sync_batch_accepted_items_non_negative",
            "expression": "accepted_items >= 0"
          }
        ]
      },
      {
        "name": "SyncQueueItem",
        "table": "sync_queue_item",
        "primaryKey": ["id"],
        "fields": [
