{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://detran.example.invalid/schemas/events/sync.batch.received.schema.json",
  "title": "sync.batch.received",
  "description": "Um envelope por item aplicado/rejeitado do lote de sincronização (CTG-0002 §4.1/§5.13/§7).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "domainEvent",
    "version",
    "occurredAt",
    "tenantId",
    "actor",
    "correlationId",
    "aggregate",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Id da linha da outbox (integration.outbox.id, uuid — não ULID; CTG-0001 §11.1)."
    },
    "type": {
      "const": "sync.batch.received"
    },
    "domainEvent": {
      "const": "SYNC_ITEM_RECEBIDO"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "tenantId": {
      "type": "string"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["user", "system", "timer"]
        },
        "id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      }
    },
    "correlationId": {
      "type": "string"
    },
    "causationId": {
      "type": "string"
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version"],
      "properties": {
        "kind": {
          "const": "sync-queue-item"
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batchId",
        "deviceBatchId",
        "batchSequence",
        "itemId",
        "entityType",
        "localEntityId",
        "receiptStatus",
        "errorCode",
        "serverEntityId"
      ],
      "properties": {
        "batchId": {
          "type": ["string", "null"]
        },
        "deviceBatchId": {
          "type": "string"
        },
        "batchSequence": {
          "type": ["integer", "null"]
        },
        "itemId": {
          "type": "string"
        },
        "entityType": {
          "type": "string"
        },
        "localEntityId": {
          "type": "string"
        },
        "receiptStatus": {
          "type": "string",
          "enum": ["received", "applied", "conflict", "rejected"]
        },
        "errorCode": {
          "type": ["string", "null"]
        },
        "serverEntityId": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
