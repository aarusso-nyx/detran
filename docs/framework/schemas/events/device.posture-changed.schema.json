{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://detran.example.invalid/schemas/events/device.posture-changed.schema.json",
  "title": "device.posture-changed",
  "description": "Postura do dispositivo alterada (block/wipe) (CTG-0002 §5.9/§7).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "domainEvent",
    "version",
    "occurredAt",
    "tenantId",
    "actor",
    "correlationId",
    "aggregate",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Id da linha da outbox (integration.outbox.id, uuid — não ULID; CTG-0001 §11.1)."
    },
    "type": {
      "const": "device.posture-changed"
    },
    "domainEvent": {
      "const": "DISPOSITIVO_BLOQUEADO"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "tenantId": {
      "type": "string"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["user", "system", "timer"]
        },
        "id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      }
    },
    "correlationId": {
      "type": "string"
    },
    "causationId": {
      "type": "string"
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version"],
      "properties": {
        "kind": {
          "const": "operational-device"
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceId",
        "agentId",
        "fromStatus",
        "toStatus",
        "eventType"
      ],
      "properties": {
        "deviceId": {
          "type": "string"
        },
        "agentId": {
          "type": ["string", "null"]
        },
        "fromStatus": {
          "type": "string"
        },
        "toStatus": {
          "type": "string"
        },
        "eventType": {
          "type": "string"
        }
      }
    }
  }
}
