{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://detran.example.invalid/schemas/events/sync.conflict.opened.schema.json",
  "title": "sync.conflict.opened",
  "description": "Conflito de sincronização aberto (integridade, domínio ou concorrência) (CTG-0002 §4.2/§4.7/§7).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "domainEvent",
    "version",
    "occurredAt",
    "tenantId",
    "actor",
    "correlationId",
    "aggregate",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Id da linha da outbox (integration.outbox.id, uuid — não ULID; CTG-0001 §11.1)."
    },
    "type": {
      "const": "sync.conflict.opened"
    },
    "domainEvent": {
      "const": "SYNC_CONFLITO_ABERTO"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "tenantId": {
      "type": "string"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["user", "system", "timer"]
        },
        "id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      }
    },
    "correlationId": {
      "type": "string"
    },
    "causationId": {
      "type": "string"
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version"],
      "properties": {
        "kind": {
          "const": "sync-conflict"
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflictId",
        "conflictType",
        "syncQueueItemId",
        "reasonCode",
        "openedAt"
      ],
      "properties": {
        "conflictId": {
          "type": "string"
        },
        "conflictType": {
          "type": "string",
          "enum": ["integrity", "domain", "concurrency"]
        },
        "syncQueueItemId": {
          "type": "string"
        },
        "reasonCode": {
          "type": "string"
        },
        "openedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
