{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://detran.example.invalid/schemas/events/ait.concurrency-suspected.schema.json",
  "title": "ait.concurrency-suspected",
  "description": "AIT aplicado em SUSPEITO_CONCORRENCIA pelo detector de concorrência do lote (CTG-0002 §4.7, RN-TEAT-111).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "domainEvent",
    "version",
    "occurredAt",
    "tenantId",
    "actor",
    "correlationId",
    "aggregate",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Id da linha da outbox (integration.outbox.id, uuid — não ULID; CTG-0001 §11.1)."
    },
    "type": {
      "const": "ait.concurrency-suspected"
    },
    "domainEvent": {
      "const": "AIT_SUSPEITO_CONCORRENCIA"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "tenantId": {
      "type": "string"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["user", "system", "timer"]
        },
        "id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      }
    },
    "correlationId": {
      "type": "string"
    },
    "causationId": {
      "type": "string"
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version"],
      "properties": {
        "kind": {
          "const": "ait"
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aitId",
        "agentId",
        "deviceId",
        "otherDeviceId",
        "windowStart",
        "windowEnd",
        "conflictId"
      ],
      "properties": {
        "aitId": {
          "type": "string"
        },
        "agentId": {
          "type": "string"
        },
        "deviceId": {
          "type": "string"
        },
        "otherDeviceId": {
          "type": ["string", "null"]
        },
        "windowStart": {
          "type": "string",
          "format": "date-time"
        },
        "windowEnd": {
          "type": "string",
          "format": "date-time"
        },
        "conflictId": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
