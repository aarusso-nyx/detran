{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://detran.example.invalid/schemas/boat-crash-record-sync-item.schema.json",
  "title": "BOAT crash-record offline sync item",
  "description": "Payload canônico do item entity_type=crash-record, aplicado pelo módulo est/crash em uma transação (boat-route-contract.md §4). Tenant e autenticação vêm do contexto TEAT.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record",
    "vehicles",
    "people",
    "victims",
    "sceneDuties",
    "damages",
    "witnesses",
    "sketch",
    "evidenceLocalIds",
    "links"
  ],
  "properties": {
    "record": { "$ref": "#/$defs/record" },
    "vehicles": { "type": "array", "items": { "$ref": "#/$defs/object" } },
    "people": { "type": "array", "items": { "$ref": "#/$defs/object" } },
    "victims": { "type": "array", "items": { "$ref": "#/$defs/object" } },
    "sceneDuties": { "type": "array", "items": { "$ref": "#/$defs/object" } },
    "damages": { "type": "array", "items": { "$ref": "#/$defs/object" } },
    "witnesses": { "type": "array", "items": { "$ref": "#/$defs/object" } },
    "sketch": { "anyOf": [{ "$ref": "#/$defs/object" }, { "type": "null" }] },
    "evidenceLocalIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "links": { "type": "array", "items": { "$ref": "#/$defs/object" } }
  },
  "$defs": {
    "object": { "type": "object", "additionalProperties": true },
    "record": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "traffic_agency_id",
        "crash_type",
        "severity",
        "occurred_at",
        "recorded_at",
        "location_description",
        "municipality_code",
        "uf",
        "road_condition",
        "weather_condition",
        "lighting_condition",
        "signage_condition",
        "source_local_id"
      ],
      "properties": {
        "traffic_agency_id": { "type": "string", "format": "uuid" },
        "crash_type": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "minLength": 1 },
        "occurred_at": { "type": "string", "format": "date-time" },
        "recorded_at": { "type": "string", "format": "date-time" },
        "location_description": { "type": "string", "minLength": 1 },
        "location_json": { "type": ["object", "null"] },
        "location_reference": { "type": ["string", "null"] },
        "municipality_code": { "type": "string", "minLength": 1 },
        "uf": { "type": "string", "minLength": 2, "maxLength": 2 },
        "road_condition": { "type": "string", "minLength": 1 },
        "weather_condition": { "type": "string", "minLength": 1 },
        "lighting_condition": { "type": "string", "minLength": 1 },
        "signage_condition": { "type": "string", "minLength": 1 },
        "source_local_id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
