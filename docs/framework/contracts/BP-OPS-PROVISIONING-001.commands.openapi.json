              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KeyChallengeResponse"
                }
              }
            }
          },
          "412": {
            "description": "Versão do dispositivo divergiu.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
