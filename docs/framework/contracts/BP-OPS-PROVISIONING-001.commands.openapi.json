              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": ["TEAT.ENUM_INVALID", "TEAT.VALIDATION_FAILED"]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "string", "enum": ["TEAT.AUTH_REQUIRED"] }
