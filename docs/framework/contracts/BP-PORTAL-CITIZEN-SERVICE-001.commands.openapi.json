              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["code", "status", "message"],
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": ["PORTAL.VALIDATION_FAILED"]
                    },
                    "status": {
                      "type": "integer",
