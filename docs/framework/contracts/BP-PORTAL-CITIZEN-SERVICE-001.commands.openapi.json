                      "type": "string",
                      "format": "date-time"
                    },
                    "state": {
                      "type": "string",
                      "const": "COMPROVANTE_EMITIDO"
                    },
                    "agencyDueOn": {
                      "type": "string",
                      "format": "date"
                    },
                    "anonymous": {
                      "type": "boolean"
                    }
