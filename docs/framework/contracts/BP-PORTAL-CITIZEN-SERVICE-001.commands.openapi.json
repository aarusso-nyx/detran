          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluationCreateDto"
              },
              "example": {
                "subjectKind": "manifestation",
                "subjectId": "00000000-0000-7000-8000-000070700008",
                "scores": {
                  "satisfaction": 5,
                  "quality": 5,
                  "deadline": 5,
                  "clarity": 5,
                  "channel": 5
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Avaliação registrada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "evaluationId",
                    "subjectKind",
                    "subjectId",
                    "state",
                    "submittedAt",
                    "publicNotice"
                  ],
                  "properties": {
                    "evaluationId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "subjectKind": {
                      "type": "string",
                      "enum": ["request", "manifestation"]
                    },
                    "subjectId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "state": {
                      "type": "string",
                      "enum": ["AVALIADA", "CONCLUIDO"]
                    },
                    "submittedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "publicNotice": {
                      "type": "string",
                      "const": "portal.evaluations.publicIndicator"
                    }
                  }
                },
                "example": {
                  "evaluationId": "00000000-0000-7000-8000-000071100002",
                  "subjectKind": "manifestation",
                  "subjectId": "00000000-0000-7000-8000-000070700008",
                  "state": "AVALIADA",
                  "submittedAt": "2026-09-14T12:00:00-04:00",
                  "publicNotice": "portal.evaluations.publicIndicator"
                }
              }
            }
          },
          "400": {
            "description": "Corpo fora da forma, ou Idempotency-Key ausente.",
