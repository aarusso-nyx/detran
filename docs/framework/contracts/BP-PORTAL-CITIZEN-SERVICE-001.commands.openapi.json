    "/v1/portal/evaluations": {
      "post": {
        "tags": ["evaluation"],
        "operationId": "portalEvaluationCreate",
        "summary": "Avalia um pedido ou manifestação concluídos.",
        "x-policy": "portal:evaluation:evaluate",
