    "title": "RAIT Case commands",
    "version": "1.1.0",
    "x-blueprint": "BP-INF-RAIT-CASE-001",
    "x-commands": true,
    "description": "R-0025 admissibility slice per ADR-0041 and UC-RAIT-002. Four operations have typed strict inputs, parent-case If-Match/ETag and idempotency. Other operations retain their existing scope."
  },
