        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RaitCaseAdmitInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Persisted result or exact idempotent replay.",
            "headers": {
              "ETag": {
                "required": true,
                "description": "ETag of the persisted parent case version, also for admissibility saves.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["data", "events"],
                  "properties": {
                    "data": {
                      "$ref": "./BP-INF-RAIT-CASE-001.openapi.json#/components/schemas/RaitCase"
                    },
                    "events": {
                      "type": "array",
                      "description": "Existing transactional case event records; no client-supplied event.",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Catalogued RAIT error response; code and status remain authoritative. ",
