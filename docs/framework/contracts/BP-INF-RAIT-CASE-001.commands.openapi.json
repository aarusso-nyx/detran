    "/v1/inf/rait/cases": {
      "post": {
        "operationId": "raitCaseProtocol",
        "responses": {
          "200": {
            "description": "Caso protocolado"
          }
        }
      }
    },
    "/v1/inf/rait/cases/{id}/commands/admit": {
      "post": {
        "operationId": "raitCaseAdmit",
        "description": "Existing admit guard: four criteria, signature and server timeliness. No state shortcut.",
        "parameters": [
          {
            "$ref": "#/components/parameters/RaitCaseId"
          },
          {
            "$ref": "#/components/parameters/RaitCaseIfMatch"
          },
          {
