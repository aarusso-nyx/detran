      "harness_green_main": {
        "workflow": "ci.yml",
        "event": "push",
        "headBranch": "main",
        "attempts": "last",
        "includeCancelled": false,
        "lookbackDays": 30,
        "minimumSample": 10,
        "excludedJobs": []
      },
      "harness_performance": {
        "workflow": "ci.yml",
