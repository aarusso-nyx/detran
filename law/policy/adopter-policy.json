{
  "schemaVersion": "1.0.0",
  "policy_id": "detran-law-corpus",
  "policy_version": "1.1.0",
  "domains": {
    "client": ["INF", "EST", "CH", "OPS", "PORTAL", "DASH"]
  },
  "project": {
    "project_type": "runtime-host",
    "repo": {
      "kind": "application"
    },
    "docs": {
      "builder": "docusaurus",
      "build_command": "npm --prefix docs/site run build",
      "output_dir": "docs/site/build",
      "publish_target": "gh-pages",
      "gh_pages_branch": "gh-pages",
      "custom_domain": null,
      "ia": {
        "collapsed_sections": ["roles"]
      }
    }
  },
  "ci_economy": {
    "profile": "full",
    "attested_rc": {
      "profile": "rc",
      "transport": "protected-tag-v1",
      "tag_prefix": "devai-local-evidence/",
      "binding": "exact-tree",
      "required_check": "verified-local-rc",
      "failure_mode": "fail-closed",
      "local_only_nodes": ["backend-kernel"]
    }
  }
}
