          "backend",
          "packages",
          "apps",
          "senatran-mock",
          "tools",
          "tests"
        ]
      },
      "test_coverage_depth": {
        "coveragePath": "coverage/coverage-final.json",
        "population": "local",
        "exclusions": [
          "backend/app/tests/e2e",
          "backend/app/tests/in-house",
